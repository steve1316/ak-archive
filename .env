# Asset host: one repo read through raw GitHub links, which send `access-control-allow-origin: *`.
VITE_ASSET_BASE_URL=https://raw.githubusercontent.com/steve1316/ak-archive-assets/main/
# Story art and audio, published by tools/assets/story_publish.py. The dev server can point this at __story/ in .env.development.local.
VITE_STORY_ASSET_BASE_URL=https://raw.githubusercontent.com/steve1316/ak-archive-story/main/

# Both bases must stay web addresses. A folder path such as `C:\...` cannot be loaded by the browser.
# To self-host from a local copy, leave the lines above as they are and set the folders below.
# Keep each folder outside this repo's folder, or every Docker build copies all of it.
# Then run the command in the README, which serves the folders and points the build at them.
# AK_ASSETS_DIR=C:\path\to\ak-archive-assets
# AK_STORY_DIR=C:\path\to\ak-archive-story
