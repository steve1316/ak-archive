elf..."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"line","name":"Amiya","text":"But I believe in you."},{"t":"cmd","c":"image","a":{"image":"avg_0_3","fadetime":0.8}},{"t":"line","name":"Amiya","text":"I know you can do this."},{"t":"line","name":"Amiya","text":"Please take command... of Rhodes Island!"},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"unknown","c":"skiptothis","a":{}},{"t":"unknown","c":"startbattle","a":{"stageid":"guide_01"}},{"t":"unknown","c":"tutorial","a":{"waitforsignal":"battle_start"}}]}
