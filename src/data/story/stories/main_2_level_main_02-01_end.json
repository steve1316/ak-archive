{"id":"main_2_level_main_02-01_end","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"blocker","a":{"a":1,"initr":2,"r":0,"g":0,"b":0,"fadetime":0.6,"block":true}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_dia_mist_loop","key":"Sound_Beta_2/Music/beta1_180603/m_dia_mist_loop","volume":0.8,"crossfade":1.5,"delay":0.5}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"image":"bg_lungmen_station","width":1,"height":1,"fadetime":0}},{"t":"line","name":null,"text":"10:14 P.M. \\ Clear \\ Visibility: 19 km"},{"t":"line","name":null,"text":"Lungmen, District 5- Inspection and Quarantine Zone"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"???","text":"Madam."},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.6,"block":true}},{"t":"line","name":"???","text":"They're here."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"???","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Dialog/d_avg_radio"}},{"t":"line","name":"Broadcast","text":"Attention, please..."},{"t":"line","name":"Broadcast","text":"Due to the Catastrophe's interference, all air traffic in Lungmen has been stopped. All entrances to District 5 will be closed in two hours."},{"t":"line","name":"Broadcast","text":"We thank you for your cooperation during Oripathy inspections."},{"t":"line","name":"Broadcast","text":"If you discover any unregistered Infected, please inform a nearby peace officer immediately."},{"t":"line","name":"Broadcast","text":"The L.G.D. will detain them in accordance with the 'Emergency Handling Act.'"},{"t":"line","name":"Broadcast","text":"Attention, please..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Dialog/d_avg_radio"}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#1"}},{"t":"line","name":"Amiya","text":"It's just like the rumors said..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"Let's go, Doctor."},{"t":"line","name":"Amiya","text":"We're here."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"???","text":"Rhodes Island was scheduled to meet with the L.G.D. at 10 o'clock."},{"t":"line","name":"???","text":"It's 10:14 now."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#4"}},{"t":"line","name":"???","text":"You were late 14 minutes; therefore, you've wasted 14 minutes of my time."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_002_amiya_1","focus":2}},{"t":"line","name":"Amiya","text":"...I'm sorry, Madam Ch'en, we just found out that Reunion is here..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_002_amiya_1","focus":1}},{"t":"line","name":"Ch'en","text":"It's fine, I already know. But that's not important right now."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"...Who might this be?"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_002_amiya_1","focus":2}},{"t":"line","name":"Amiya","text":"Dr. {@nickname} is Rhodes Island's consultant. Dr. Kal'tsit should already have informed you."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"Hmm..."},{"t":"line","name":"Ch'en","text":"Well, since everyone is here, I'll now need you to follow me to..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.4}},{"t":"line","name":"L.G.D. Agent","text":"Madam Ch'en! It's an emergency! Those Infected... they're not..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#4","name2":"char_015_lmg","focus":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":15,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Ch'en","text":"Don't panic!"},{"t":"line","name":"Ch'en","text":"First Squad, standby! Snipers, get into position!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Civilian","text":"Wh-what's happening?!"},{"t":"line","name":"Infected","text":"Let go of me! !"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"Tch... What's going on? Report the situation."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"camerashake","a":{"duration":1.5,"xstrength":10,"ystrength":12,"vibrato":15,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Infected","text":"Let me go! ! Why are you arresting me? !"},{"t":"line","name":"Infected","text":"We didn't do anything wrong! ! !"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L.G.D. Agent","text":"Some Infected... are refusing to be taken in... We're..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"I can see that..."},{"t":"line","name":"Ch'en","text":"Forget it."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"Detain them all."},{"t":"line","name":"Ch'en","text":"Disperse the crowd immediately. Open the gates in 30 minutes after you finish the review process."},{"t":"line","name":"Ch'en","text":"Also, push the quarantine inspection line forward 40 meters."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#4"}},{"t":"line","name":"Ch'en","text":"Other than you and Dr. {@nickname}, the rest of Rhodes Island will stay here and assist with border security. The two of you, come with me."},{"t":"line","name":"Ch'en","text":"If your group can't handle such a trivial task, I will not be able to assign you any missions."},{"t":"line","name":"Ch'en","text":"PC94172, arrange some work for these people. I don't want to see any more trouble tonight."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L.G.D. Agent","text":"Understood, Madam!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L.G.D. Agent","text":"Everyone, I'd like you to..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":0.6}},{"t":"cmd","c":"character","a":{"fadetime":2}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#5"}},{"t":"line","name":"Amiya","text":"..."},{"t":"line","name":"Amiya","text":"(Madam Ch'en is really tough... she's stricter than I imagined...)"},{"t":"decision","options":["... (Nod)"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#4"}},{"t":"line","name":"Ch'en","text":"You two."},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.4,"block":true}},{"t":"line","name":"Ch'en","text":"Follow me."},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"We're here."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_lungmen_n","x":40,"y":0,"fadetime":1,"xscale":1.3,"yscale":1.3}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"backgroundtween","a":{"xfrom":40,"yfrom":0,"xto":40,"yto":-150,"duration":4,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#6"}},{"t":"line","name":"Amiya","text":"Wh-what a tall building!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#6"}},{"t":"line","name":"Amiya","text":"Ugh..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#5"}},{"t":"line","name":"Amiya","text":"S-sorry..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"... Rhodes Island is undoubtedly capable."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"Oh..."},{"t":"line","name":"Amiya","text":"Thank you for your praise, Madam."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"However..."},{"t":"line","name":"Ch'en","text":"After the Chernobog incident, there's been a massive surge of refugees into Lungmen."},{"t":"line","name":"Ch'en","text":"The Infected should already know what the consequences of entering Lungmen are."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"initr":2,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"image":"bg_lungmen_o","width":1,"height":1,"fadetime":0,"screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":true}},{"t":"line","name":"???","text":"I'll remind you once more."},{"t":"line","name":"???","text":"Lungmen is the next Chernobog."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"Dr. Kal'tsit...!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1"}},{"t":"line","name":"Ch'en","text":"Rhodes Island's representative has already met with Chief Wei."},{"t":"line","name":"Ch'en","text":"Please wait here."},{"t":"line","name":"Ch'en","text":"I'll notify you shortly."},{"t":"cmd","c":"dialog","a":{"fadetime":0.6}},{"t":"cmd","c":"character","a":{"fadetime":0.6}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#4"}},{"t":"line","name":"Amiya","text":"Phew... she's really hard to talk to."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"Dr. {@nickname}, from here on, Dr. Kal'tsit will be handling the negotiations."},{"t":"line","name":"Amiya","text":"Please have confidence in her."},{"t":"cmd","c":"dialog","a":{"fadetime":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}}]}
