aracter","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_028#3"}},{"t":"line","name":"Gambino","text":"What are you doing on the ground? Get up and fight if you ain't dead!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_031","name2":"avg_npc_028#3","focus":1}},{"t":"line","name":"Mafioso","text":"Y- yessir!"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#5"}},{"t":"line","name":"Exusiai","text":"You can't be so rough with your employees. Do they at least get hazard pay?"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1#4"}},{"t":"line","name":"Texas","text":"It's kind of hard to tell who's who. Just try to get everyone wearing black on the ground."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#2"}},{"t":"line","name":"Mostima","text":"Hoo yeah this is a mess."},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#2","name2":"char_325_bison_1#2","focus":2}},{"t":"line","name":"Bison","text":"Sure is—— woah! Mostima?"},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#3","name2":"char_325_bison_1#2","focus":1}},{"t":"line","name":"Mostima","text":"But it looks like you're all doing okay."},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#3","name2":"char_102_texas_1","focus":2}},{"t":"line","name":"Texas","text":"When did you get here?"},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#2","name2":"char_102_texas_1","focus":1}},{"t":"line","name":"Mostima","text":"The boss called me."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_027#2"}},{"t":"line","name":"Capone","text":"Hey, it's that weird-lookin' Sankta."},{"t":"cmd","c":"character","a":{"name":"avg_npc_028#3"}},{"t":"line","name":"Gambino","text":"Get outta here!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#3"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skil