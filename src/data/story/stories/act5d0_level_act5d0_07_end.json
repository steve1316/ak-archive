g reunion?!"},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1#2","name2":"char_103_angel_1#7","focus":1}},{"t":"line","name":"Mostima","text":"Touching or not, it's definitely not the time to be reminiscing."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_213_mostma_1#2","focus":1}},{"t":"line","name":"Texas","text":"Are you really going to do it here?"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_213_mostma_1#2","focus":2}},{"t":"line","name":"Mostima","text":"I'll do only what needs doing."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_213_mostma_1#2","focus":1}},{"t":"line","name":"Texas","text":"...Okay. Just go easy on them."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_213_mostma_1#3","focus":2}},{"t":"line","name":"Mostima","text":"Don't worry."},{"t":"line","name":"Mostima","text":"And it looks like I've got another customer waiting."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_213_mostma_1#3","focus":1}},{"t":"line","name":"Texas","text":"——?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_213_mostma_1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_blacktimewand","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_blacktimewand_shot","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstren