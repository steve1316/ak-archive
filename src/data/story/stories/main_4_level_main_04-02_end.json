{"id":"main_4_level_main_04-02_end","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_lungmen_r","width":1,"height":1,"fadetime":2}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta3_181101/m_dia_street_intro","key":"Sound_Beta_2/Music/beta3_181101/m_dia_street_loop","volume":0.8,"crossfade":1,"delay":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"..."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Ahh...! Look out!"},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":10,"ystrength":12,"vibrato":15,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#6"}},{"t":"line","name":"Amiya","text":"Ouch!"},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"S-sorry, I didn't mean to run into you..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"Don't worry about it. You're very polite."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Ehehe..."},{"t":"line","name":"Child","text":"Um, ma'am, what are you doing here?"},{"t":"line","name":"Child","text":"It's still raining. You're not going to go inside?"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"Ah, um... I'm just... taking a walk."},{"t":"line","name":"Amiya","text":"Are you looking for help?"},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Oh! How'd you know?!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"I can't tell you~ It's a secret."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Aw... it's fine though!"},{"t":"line","name":"Child","text":"Ma'am, do you think..."},{"t":"line","name":"Child","text":"Hmm... that probably won't work. You're a bit too short..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#7"}},{"t":"line","name":"Amiya","text":"Hey, you shouldn't say stuff like that! You're shorter than me!"},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Whoa!"},{"t":"line","name":"Child","text":"W-well, we could try... Um, could you help me move that board? Let's do it together!"},{"t":"line","name":"Child","text":"There's a record player under that metal rack. I want to take it back home."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"Sure."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"1... 2... 3! Together!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#2"}},{"t":"line","name":"Amiya","text":"We did it!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"..."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"Woah, you're really strong, ma'am! Thank you!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"But... this record player is broken."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Child","text":"It's okay! It's always been broken."},{"t":"line","name":"Child","text":"But one day, I'll be able to fix it. I collected a lot of records, but I've never listened to them before..."},{"t":"line","name":"Child","text":"...But one day, I'll play them for everyone!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"..."},{"t":"line","name":"Amiya","text":"...Such a difficult thing, said so casually..."},{"t":"line","name":"Amiya","text":"...What am I doing this for... What can I even do..."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t"