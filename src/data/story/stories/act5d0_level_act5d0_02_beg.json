{"id":"act5d0_level_act5d0_02_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"background","a":{"image":"bg_lmstreet_1","screenadapt":"coverall"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act5d0/m_avg_longmendarkalley_intro","key":"Sound_Beta_2/Music/act5d0/m_avg_longmendarkalley_loop","volume":0.8,"crossfade":1.5}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_201_moeshd#5"}},{"t":"line","name":"Croissant","text":"*Cough cough* Everybody okay?"},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4","name2":"char_201_moeshd#5","focus":1}},{"t":"line","name":"Bison","text":"Just managed to block it——"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1"}},{"t":"line","name":"Texas","text":"Nice reflexes, you two."},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#4"}},{"t":"line","name":"Exusiai","text":"Whew, they really blew it up, didn't they?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_105_emper"}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"camerashake","a":{"duration":2,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Emperor","text":"————*indescribable penguin sounds*————"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#4","name2":"char_201_moeshd#5","focus":2}},{"t":"line","name":"Croissant","text":"(Wh- what's that? Baws's makin' all kinds of crazy sounds!)"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#7","name2":"char_201_moeshd#5","focus":1}},{"t":"line","name":"Exusiai","text":"(Hey, wasn't that box of vinyl records some kind of black market Columbian collectible thingy?)"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#7","name2":"char_201_moeshd#4","focus":2}},{"t":"line","name":"Croissant","text":"(I reckon yer right. What're we gonna do? I ain't never seen the baws all choked up like this before...)"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_031","name2":"avg_npc_031"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.5}},{"t":"cmd","c":"character","a":{"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#7","name2":"char_201_moeshd#5","focus":1}},{"t":"line","name":"Exusiai","text":"What do you mean—— Hey! They're getting away! Those guys in black!"},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4"}},{"t":"line","name":"Bison","text":"Wait! If they were here setting that trap, why didn't they just ambush us? This isn't adding up. We need to take a minute and come up with a plan before——"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#8"}},{"t":"line","name":"Exusiai","text":"Texas!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_sportscarstart"}},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1"}},{"t":"line","name":"Texas","text":"Get in."},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act5d0/m_bat_chasing_intro","key":"Sound_Beta_2/Music/act5d0/m_bat_chasing_loop","volume":0.8,"crossfade":1.5}},{"t":"cmd","c":"character","a":{"name":"char_105_emper"}},{"t":"line","name":"Emperor","text":"...Listen up."},{"t":"line","name":"Emperor","text":"You can expense your speeding tickets tonight."},{"t":"line","name":"Emperor","text":"They gotta pay... for my vinyl recoooords!!!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_drift"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"background","a":{"image":"bg_motorway","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_201_moeshd#3"}},{"t":"line","name":"Croissant","text":"Got 'em! Dead ahead!"},{"t":"cmd","c":"character","a":{"name":"char_105_emper"}},{"t":"line","name":"Emperor","text":"Exusiai! Pass me my Lil Homie!"},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#8","focus":2}},{"t":"line","name":"Exusiai","text":"You got it, boss!"},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#2"}},{"t":"line","name":"Bison","text":"Is that a gun?! But how are you going to pull the trigger...?"},{"t":"cmd","c":"character","a":{"name":"char_105_emper"}},{"t":"line","name":"Emperor","text":"Hah! See for yourself, little man. Let our firearms expert tell you about it."},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#8","focus":2}},{"t":"line","name":"Exusiai","text":"That's forty-two layers of logistics-grade cardboard, seamlessly glued together with industrial adhesive, driven by the finest rubber bands. It's really a magnificent piece."},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#2"}},{"t":"line","name":"Bison","text":"You mean... it's a toy?"},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#8","focus":2}},{"t":"line","name":"Exusiai","text":"It's more of a slingshot——Ow! Err, it's a peacemaker!"},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#8","focus":1}},{"t":"line","name":"Emperor","text":"You can't use live ammo in downtown Lungmen. That's the law."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1#2"}},{"t":"line","name":"Texas","text":"And yet this is the only time the boss seems to care what the law says."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1#2","name2":"char_105_emper","focus":2}},{"t":"line","name":"Emperor","text":"If nobody follows the rules, our whole society goes to hell, you feel me? Texas, put the top down!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_105_emper","focus":1}},{"t":"line","name":"Texas","text":"Be careful. Don't want you hitting your head on a traffic signal like last time."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_105_emper","focus":2}},{"t":"line","name":"Emperor","text":"Do I look that tall to you?"},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#5","focus":2}},{"t":"line","name":"Exusiai","text":"Support sniper in position, boss!"},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4"}},{"t":"line","name":"Bison","text":"W- wait a minute, there's a lot of other cars on the road. Don't tell me you're just gonna——"},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_pistol","volume":0.9}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":true}},{"t":"line","name":"Mafia Driver","text":"They're shootin' at us! Return fire!"},{"t":"line","name":"Back Seat Mafioso","text":"How am I supposed to aim with you swervin' all over the place?!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_pistol","volume":0.9}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"line","name":"Mafia Driver","text":"Hey, are you hit back there?!"},{"t":"line","name":"Back Seat Mafioso","text":"I'm bleeding, they got me, I need a bandage—— No wait, what is this, rubber?"},{"t":"line","name":"Mafia Driver","text":"A what?!"},{"t":"line","name":"Back Seat Mafioso","text":"It's rubber, but it broke the glass! Shake 'em off, quick! Gah, that hurt!!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#8","focus":2}},{"t":"line","name":"Exusiai","text":"Clean headshot, boss!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_105_emper","focus":2}},{"t":"line","name":"Emperor","text":"Sic 'em, Texas!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1#4","name2":"char_105_emper","focus":1}},{"t":"line","name":"Texas","text":"I'm speeding up."},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4"}},{"t":"line","name":"Bison","text":"Slow down! Watch out for that big rig—— Aie!"},{"t":"cmd","c":"character","a":{"name":"char_201_moeshd"}},{"t":"line","name":"Croissant","text":"Yer gonna wanna hold on tight. Texas's whipped up wilder'n a Forte in a twister right now."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#5","focus":1}},{"t":"line","name":"Emperor","text":"Exu, blow their tires!"},{"t":"cmd","c":"character","a":{"name":"char_105_emper","name2":"char_103_angel_1#5","focus":2}},{"t":"line","name":"Exusiai","text":"On it!"},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4"}},{"t":"line","name":"Bison","text":"She's gonna pop their tires with rubber bullets?!"},{"t":"cmd","c":"character","a":{"name":"char_105_emper"}},{"t":"line","name":"Emperor","text":"I have spoken. So let it be done."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_pistol","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_pistol","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#2"}},{"t":"line","name":"Bison","text":"Texas, can you talk some sense into them?!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1#2"}},{"t":"line","name":"Texas","text":"(Looks away) ......"},{"t":"cmd","c":"character","a":{"name":"char_201_moeshd"}},{"t":"line","name":"Croissant","text":"Forget it. They're havin' a good time."},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#8"}},{"t":"line","name":"Exusiai","text":"Check this out! It's gonna do a cool flip!"},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.3,"block":true}},{"t":"line","name":"Mafia Driver","text":"Hey, I can't move the steering wheel!"},{"t":"line","name":"Back Seat Mafioso","text":"Shit, bail out!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.3,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_325_bison_1#4"}},{"t":"line","name":"Bison","text":"Wait! Going this fast, we're gonna get pulled in!"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#4"}},{"t":"line","name":"Exusiai","text":"Hah."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_drift"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1#4"}},{"t":"line","name":"Exusiai","text":"All right, now the multi-car pileup is all yours, Texas!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1"}},{"t":"line","name":"Texas","text":"Gee, thanks a lot."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.25,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"fadetime":2,"block":true}}]}
