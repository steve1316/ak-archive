"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"m"}},{"t":"line","name":"Javier","text":"...You're alone."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1581_1#1$1","focus":"m"}},{"t":"line","name":"Juana","text":"As you can see."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#9$2","focus":"m"}},{"t":"line","name":"Javier","text":"You shouldn't have been left unguarded..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1581_1#1$1","focus":"m"}},{"t":"line","name":"Juana","text":"Maybe because the one who should have been protecting me is standing before me now.","append":true},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1581_1#2$1","focus":"m"}},{"t":"line","name":"Juana","text":"Pointing the blade I made for him at me.","append":true},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1581_1#1$1","focus":"m"}},{"t":"line","name":"Juana","text":"Go on. Kill me, and the fleet is yours."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#9$2","focus":"m"}},{"t":"line","name":"Javier","text":"..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"m"}},{"t":"line","name":"Javier","text":"Juana is in our custody. Keep an eye on her, but don't let her get hurt."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1581_1#10$1","focus":"m"}},{"t":"line","name":"Juana","text":"...What a joke."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"ima