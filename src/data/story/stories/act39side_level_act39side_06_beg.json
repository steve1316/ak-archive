all rank-and-file thugs who can hardly string two sentences together."},{"t":"line","name":"Warrior Priest","text":"We won't find anything unless we go deeper into their base."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#7$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"Do not stop without my direct command. Everything here must be cleansed with fire."},{"t":"line","name":"Anastasio","text":"There is no reason to allow such tools of sin to continue to exist."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1587_1#1$1","focus":"m"}},{"t":"line","name":"Warrior Priest","text":"Sir!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"soundvolume","a":{"volume":0.1,"fadetime":2,"channel":"bse"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.1,"fadetime":2,"channel":"bgs"}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"background","a":{"image":"57_g2_saltdesert_n","screenadapt":"showall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/AVG/m_avg_monastery_nomal","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"A noise rouses Isidro from his musings and causes him to halt his steps."},{"t":"line","name":null,"text":"He turns around and sees the dark night lit up on the horizon."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1577_1#3$1","focus":"m"}},{"t":"line","name":"Isidro","text":"That's..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"It is the light of a raging fire..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1577_1#5$1","focus":"m"}},{"t":"line","name":"Isidro","text":"No..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"In the direction of the fleet."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1577_1#5$1","focus":"m"}},{"t":"line","name":"Isidro","text":"How could it..."},{"t":"line","name":"Isidro","text":"I..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_runsand","volume":1}},{"t":"cmd","c":"charslot","a":{"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"image","a":{"image":"57_i05","screenadapt":"coverall","xscale":1.1,"yscale":1.1,"x":-50,"y":-30,"fadetime":2}},{"t":"cmd","c":"imagetween","a":{"xto":0,"yto":0,"xscaleto":1,"yscaleto":1,"duration":9,"block":false}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":null,"text":"Isidro steps forward without hesitation."},{"t":"line","name":null,"text":"It is a decision made not with reason, but pure impulse."},{"t":"line","name":null,"text":"He runs as if his life depends on it, retracing his old set of footprints, towards the direction that he came from."},{"t":"line","name":null,"text":"That same set of footprints is no longer lonely."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"bgs","fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"bse","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"background","a":{"image":"57_g11_meetingroom","screenadapt":"showall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/AVG/m_avg_darkness_03_loop","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_chairbump","volume":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_cardboard","volume":1,"delay":0.2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"m"}},{"t":"line","name":"Javier","text":"Don't bother searching. You won't find it."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"n"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_planeshake","volume":0.6}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"m"}},{"t":"line","name":"Javier","text":"The sailors told me that the kid screwed up. The compass was wrecked. It'd be of no use even if you found it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#7$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"Do not think to presume whether it is of use to me or not, bandit."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#9$2","focus":"m"}},{"t":"line","name":"Javier","text":"Yeah, yeah, perdón."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#7$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"I have safeguarded the compass for nearly a decade, and slain all who reached for it..."},{"t":"line","name":"Anastasio","text":"Even if it has become dust, I must see this dust with my own eyes."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#9$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"Where is your leader?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#10$2","focus":"m"}},{"t":"line","name":"Javier","text":"We had a deal. Juana will be spared."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#7$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"And how does your agreement with Silver concern me?"},{"t":"line","name":"Anastasio","text":"Surely the woman fled with the compass, yes? This tale of alchemical failure a ruse?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#3$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"A lie... to protect a woman, for the sake of your own desires? You, too, ought to be cleansed—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#6$2","focus":"m"}},{"t":"line","name":"Javier","text":"I'm not lying. Juana doesn't have the compass. Whatever's left of it is of no use to her."},{"t":"line","name":"Javier","text":"It's the alchemist and his lab you should be looking for."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#7$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"And where might that be?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#1$2","focus":"m"}},{"t":"line","name":"Javier","text":"Second tent in the back row. There's a secret door leading to the lab."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#8$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"...More lies."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1582_1#9$1","focus":"m"}},{"t":"line","name":"Anastasio","text":"Do not make me cut you down where you stand."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1579_1#9$2","focus":"m"}},{"t":"line","name":"Javier","text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.3,"fadetime":1.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"background","a":{"image":"57_g9_community_d","screenadapt":"showall"}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1591_1#1$1"}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1587_1#1$1"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1587_1#1$1","focus":"r"}},{"t":"line","name":"Warrior Priest","text":"On the ground! Don't move a muscle!"},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1591_1#1$1","focus":"l"}},{"t":"line","name":"Desperate Sailor","text":"I-Is it true? We'll all get pardoned if you find the compass?"},{"t":"line","name":"Desperate Sailor","text":"Are we gonna get a lighter punishment if we don't resist?"},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1587_1#1$1","focus":"r"}},{"t":"line","name":"Warrior Priest","text":"..."},{"t":"line","name":"Warrior Priest","text":"Fools."},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1591_1#1$1","focus":"l"}},{"t":"line","name":"Desperate Sailor","text":"Okay..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}}]}
