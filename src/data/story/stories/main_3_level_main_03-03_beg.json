{"id":"main_3_level_main_03-03_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"background","a":{"image":"bg_wild_a","width":1,"height":1,"fadetime":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_sys_loading_intro","key":"Sound_Beta_2/Music/beta1_180603/m_sys_loading_loop","volume":0.8,"crossfade":1.5,"delay":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_sword_n","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":8,"vibrato":30,"randomness":90,"fadeout":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.93,"g":0.75,"b":0.32,"fadetime":0.2,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"Curses...!"},{"t":"line","name":"Reunion Member","text":"There are only two enemies! Get in there already!"},{"t":"line","name":"Reunion Member","text":"What are you so scared of?!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_sword_n","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":8,"vibrato":30,"randomness":90,"fadeout":false}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"We've already lost over twenty soldiers!"},{"t":"line","name":"Reunion Member","text":"Those two devils are no ordinary people...!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":2}},{"t":"line","name":"Exusiai","text":"Watch your right!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":1}},{"t":"line","name":"Texas","text":"Give me a hand."},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"Keep pressuring her! I'll finish her off!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":1}},{"t":"line","name":"Texas","text":"I don't have time to deal with that guy rushing at me."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":2}},{"t":"line","name":"Exusiai","text":"You owe me a drink next time, all right?"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":1}},{"t":"line","name":"Texas","text":"Sure, now hurry it up."},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":2}},{"t":"line","name":"Exusiai","text":"All right!"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1"}},{"t":"line","name":"Exusiai","text":"Hey, Mister Reunion guy?"},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"Huh?"},{"t":"cmd","c":"character","a":{"name":"char_103_angel_1"}},{"t":"line","name":"Exusiai","text":"This bullet is my gift to you. Make sure to accept it with gratitude~"},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"Bullet? What the..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h","volume":0.7,"block":true}},{"t":"line","name":"Reunion Member","text":"Guh... Ughh..."},{"t":"cmd","c":"character","a":{"fadetime":0.2}},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":2}},{"t":"line","name":"Exusiai","text":"Heh, took care of him for you~"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":1}},{"t":"line","name":"Texas","text":"Thank you very much."},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"background","a":{"fadetime":0}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"line","name":"Reunion Member","text":"Y-you monster!"},{"t":"line","name":"Reunion Member","text":"Her... her sword..."},{"t":"line","name":"Texas","text":"Aaaaahh! I'm sorry!!"},{"t":"line","name":"Texas","text":"--Usually, I prefer to use two."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_sword_n","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":8,"vibrato":30,"randomness":90,"fadeout":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.93,"g":0.75,"b":0.32,"fadetime":0.2,"block":true}},{"t":"line","name":"Reunion Member","text":"Gaah! Aaagh! !"},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_wild_a","width":1,"height":1,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":2}},{"t":"line","name":"Exusiai","text":"That's the rest of them."},{"t":"line","name":"Exusiai","text":"We were totally in sync back there!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1","name2":"char_103_angel_1","focus":1}},{"t":"line","name":"Texas","text":"...Guess so."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_wild_a","width":1,"height":1,"fadetime":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Reunion Member","text":"Get back here!"},{"t":"cmd","c":"character","a":{"name":"char_102_texas_1"}},{"t":"line","name":"Texas","text":"Here comes their main force."},{"t":"line","name":"Texas","text":"Looks like we made a bit too much noise and drew their attention."},{"t":"cmd","c":"character","a":{"name":"char_100