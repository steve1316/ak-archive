{"id":"main_16_level_main_16-09_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/act37d0d0/m_bat_act37d0d0_02_loop","volume":0.6}},{"t":"cmd","c":"background","a":{"image":"66_g4_miningarea_polluted","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1970_1#1$1","duration":1,"isblock":true}},{"t":"line","name":"Young Miner","text":"No... no..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":20,"ystrength":20,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_attack_heavy","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"line","name":"Young Miner","text":"Argh!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"0,-50","afrom":1,"ato":0,"duration":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown2"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The young woman falls on the ground before your eyes, a black spear 'growing' out of her body."},{"t":"line","name":null,"text":"Next to her body, a man is flailing with his legs, trying to push himself away from this dangerous place."},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1969_1#1$1"}},{"t":"line","name":"Terrified Miner","text":"M-Monster...!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_wtchkgopenftstp","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_059_yanwu_hei_01","layer":1}},{"t":"cmd","c":"image","a":{"image":"avg_8_29","screenadapt":"coverall","xscale":1.2,"yscale":1.2,"fadetime":0}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.2,"yscalefrom":1.2,"xscaleto":1,"yscaleto":1,"duration":30,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Black is closing in. Black, black, black, everything is black, except for bright-red blood. You cannot even tell if you are facing something that is living or not."},{"t":"cmd","c":"dialog","a":{}},{"t":"line","name":"???","text":"Do not fear—not one step back!"},{"t":"line","name":"???","text":"Stand up, if you still have strength—"},{"t":"line","name":"Miner","text":"Ahh!!"},{"t":"line","name":null,"text":"The black steps through the bodies, some of whom were miners, some of whom were guards, and some of whom were just ordinary Ursines."},{"t":"line","name":null,"text":"The constant screams make it very clear that, whether you turn to run or not, the spears appearing out of thin air will catch you."},{"t":"line","name":null,"text":"You can only watch as the spears continue to rise from the ground, impaling body after body, threatening to blanket the entire ground."},{"t":"line","name":"'Emperor's Blade'","text":"—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_daggerslow","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Suddenly, the spears remove themselves from the mountain of corpses, forming a longsword in the hand of the black shadow."},{"t":"line","name":null,"text":"The entity raises its sword and points it toward you, speaking in an indistinguishable voice."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"background","a":{"image":"66_g4_miningarea_polluted","screenadapt":"coverall"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_077"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"'Emperor's Blade'","text":"You would die standing."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"???","text":"No... I'm not going to die..."},{"t":"line","name":"???","text":"I'm not going to die here."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_077"}},{"t":"line","name":"'Emperor's Blade'","text":"Hope. It's a good thing."},{"t":"line","name":"'Emperor's Blade'","text":"But futile."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_oldman_walk","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1964_1#1$1","bstart":0.2,"bend":0.7,"duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_077"}},{"t":"line","name":"'Emperor's Blade'","text":"......"},{"t":"line","name":"'Emperor's Blade'","text":"Is that...?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1976_1#1$1","bstart":0.2,"bend":0.7,"duration":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1976_1#1$1","bstart":0.2,"bend":0.7,"duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"l","focus":"l"}},{"t":"line","name":"Soldier?","text":"Rankin! We're here to help!"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Soldier?","text":"Rankin—"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"???","text":"You—Renat?"},{"t":"cmd","c":"charslot","a":{"slot":"l","focus":"l"}},{"t":"line","name":"Soldier?","text":"We're here to help!"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"???","text":"You're here! You're here to help me! My comrades, you're here—"},{"t":"line","name":"???","text":"We'll fight side-by-side, just like old times!"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Soldier?","text":"Just like old times!"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"???","text":"Surround him! Just like old times! One falls, another takes his place!"},{"t":"line","name":"???","text":"Follow me!"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_077"}},{"t":"line","name":"'Emperor's Blade'","text":"Fool..."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"You feel the heat coming from behind you, like a burning fire that spreads all over you. It makes your blood run hot, and your eyes wide and clear. They shout your name and push you forward."},{"t":"line","name":null,"text":"In the embrace of solidarity, you leap and take aim at what seems to be the thorax of the black entity—"},{"t":"line","name":null,"text":"And impale it."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":3,"xstrength":15,"ystrength":15,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":1}},{"t":"cmd","c":"backgroundtween","a":{"xscalefrom":1,"xscaleto":1.2,"yscalefrom":1,"yscaleto":1.2,"duration":3,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_audience_chaos","volume":1}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement","volume":1}},{"t":"cmd","c":"backgroundtween","a":{"xscalefrom":1.2,"xscaleto":1.8,"yscalefrom":1.2,"yscaleto":1.8,"duration":0.4,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.4,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"image","a":{"image":"66_i01","screenadapt":"coverall","x":0,"y":-100}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.6,"yscalefrom":1.6,"xscaleto":1.5,"yscaleto":1.5,"duration":10,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_piercechest","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":50,"ystrength":50,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"???","text":"—Death—"},{"t":"line","name":"'Emperor's Blade'","text":"—"},{"t":"line","name":"'Emperor's Blade'","text":"Ha..."},{"t":"line","name":null,"text":"There is no sound of blood dripping, no convulsion."},{"t":"line","name":null,"text":"Only the resistance of the blade growing lesser and lesser, until it disappears altogether."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"image","a":{"image":"66_i01","screenadapt":"coverall","fadetime":3}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.1,"yscalefrom":1.1,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"'Emperor's Blade'","text":"I see... I see..."},{"t":"line","name":"'Emperor's Blade'","text":"...Gabrielus—"},{"t":"line","name":null,"text":"As the last syllable leaves its mouth, the uniform propped up by the shadow goes limp and stops resisting."},{"t":"line","name":"???","text":"......"},{"t":"line","name":null,"text":"You have put an end to the monster, with courage, with determination, with heart."},{"t":"line","name":null,"text":"With the support of 'friends' who never existed."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.2,"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"image","a":{"image":"avg_5_7_shining","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_atmosphere_horror","volume":0,"loop":true,"channel":"at"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"at","fadetime":2}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_mohu_zhengyan_01","layer":1}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"subtitle","a":{"text":"*pant*... *pant*...","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Your hands are heavy. Where are you?","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"line","name":null,"text":"'—He's down. He's down!'"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"...Who?","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"soundvolume","a":{"volume":0.6,"channel":"at","fadetime":2}},{"t":"line","name":null,"text":"'Rankin, you—we, we killed—'"},{"t":"line","name":null,"text":"'We killed him!'"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Killed who? Black... snow...","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Not enough. One obstacle dead and gone, but the snow is everywhere, abominable snow...","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The snow will not stop.","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"line","name":null,"text":"'Rankin? Rankin! What do we do now?'"},{"t":"line","name":null,"text":"'Rankin—'"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"at","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_tinnitus","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"curtain","a":{"direction":0,"fillfrom":0.01,"fillto":0.2,"fadetime":0.1}},{"t":"cmd","c":"curtain","a":{"direction":4,"fillfrom":0.01,"fillto":0.2,"fadetime":0.1}},{"t":"cmd","c":"background","a":{"image":"bg_newiceforest_2","screenadapt":"coverall","xscale":1.4,"yscale":1.4,"y":0,"fadetime":0}},{"t":"cmd","c":"backgroundtween","a":{"xfrom":200,"xto":-200,"duration":30}},{"t":"cmd","c":"focusout","a":{"type":"bg","id":"bg_newiceforest_2","from":0,"to":1,"duration":0.1,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1976_1#1$1","bstart":0.1,"bend":0.3,"posfrom":"0,-160","posto":"0,-160","duration":4}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"zoom","poszoom":"0.5,0.5","scale":1.4,"duration":0}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_062_white_01","layer":2}},{"t":"unknown","c":"focusparam","a":{"blur":false,"effect":"Grayscale"}},{"t":"cmd","c":"blocker","a":{"a":0.3,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Soldier?","text":"Rankin!"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"???","text":"I am..."},{"t":"line","name":"Miner","text":"Rankin! Rankin!"},{"t":"line","name":null,"text":"The crowd rushes toward you like the tide. They raise you up, and they pull you back down. You have felt this sense of weightlessness before."},{"t":"line","name":null,"text":"The crowd shouts, the crowd yells. Someone who should not have been here shouts your name in the deafening echoes."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"m"}},{"t":"line","name":"Soldier?","text":"—Rankin—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"effect","a":{"name":"AVG_062_white_02","layer":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"unknown","c":"focusparam","a":{}},{"t":"cmd","c":"curtain","a":{}},{"t":"line","name":null,"text":"You close your eyes and go back into the forest with his words. A border garrison unit, a one-way mission."},{"t":"line","name":null,"text":"You are not there."},{"t":"line","name":"???","text":"Won..."},{"t":"line","name":"???","text":"We won."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_atmosphere_horror","volume":0,"loop":true,"channel":"at"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.5,"channel":"at","fadetime":2}},{"t":"cmd","c":"focusout","a":{"type":"bg","id":"bg_newiceforest_2","from":1,"to":0,"duration":4,"block":false}},{"t":"cmd","c":"background","a":{"image":"66_g16_smokeonblackgroud","screenadapt":"coverall"}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.2,"yscalefrom":1.2,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"As you rise and fall, you look towards the black dust in the distance, which has yet to fully disperse."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"at","fadetime":2}},{"t":"line","name":"Black Snow","text":"......"},{"t":"line","name":null,"text":"Black smoke seeps out from every hole and gap in the uniform, like countless tiny tentacles, greedily wrapping and covering it, until it is completely hidden."},{"t":"line","name":null,"text":"Under the black smoke, the uniform once again takes human shape, as though—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_smokeconverge","volume":1}},{"t":"cmd","c":"image","a":{"image":"avg_8_30","screenadapt":"coverall","xscale":1.2,"yscale":1.2,"fadetime":3}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.2,"yscalefrom":1.2,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"As though he never died."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":4,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{}}]}
