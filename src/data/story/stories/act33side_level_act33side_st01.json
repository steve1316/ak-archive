}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"npc_10002"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_Mon3tr"}},{"t":"line","name":"Mon3tr","text":"(Angry roar)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1307_1#1$1"}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"shake","power":15,"times":50,"duration":0.3}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown3","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":15,"vibrato":20,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"0,-70","duration":0.5,"afrom":1,"ato":0}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Nameless Assassin","text":"*cough* *cough* *hack*"},{"t":"line","name":"Nameless Assassin","text":"My Dame..."},{"t":"line","name":"Nameless Assassin","text":"Do not bury us. Kazdel's soil cannot hold any more traitors."},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1"}},{"t":"line","name":"Kal'tsit","text":"Finish him."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":1.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"npc_10002"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_Mon3trburst"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'I know that, even left on your own, your step will never falter.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#4$1"}},{"t":"line","name":"Kal'tsit","text":"Amiya! Doctor!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_Mon3tr_n"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"npc_10002"}},{"t":"line","name":"Mon3tr","text":"(Anxious crying)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#4$1","focus":"n"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_ui/b_ui_alarmenter"}},{"t":"cmd","c":"blocker","a":{"a":0.3,"r":1,"g":0.2,"b":0.2,"fadetime":0.7,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":1,"g":0.2,"b":0.2,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#5$1"}},{"t":"line","name":"Kal'tsit","text":"System unresponsive... This is..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1"}},{"t":"line","name":"Kal'tsit","text":"Mon3tr, cut the door down!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"npc_10002"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_Mon3tr"}},{"t":"line","name":"Mon3tr","text":"(Violent roar)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":1,"g":1,"b":1,"fadetime":0.2,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":40,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_doorclose"}},{"t":"cmd","c":"delay","a":{"time":0.21}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#7$1"}},{"t":"line","name":"Kal'tsit","text":"Mon3tr, meltdown!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":20,"ystrength":20,"vibrato":50,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_Mon3tr"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'You believe loneliness is yours alone, that you have none of the same kind. Yet, from the day you woke again, we've walked shoulder to shoulder, haven't we?'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"Immortal empires turned to dust. Elders' scepters rent in two under Ancients' rallying cries. Pulses over the sky like a surge. The immutable rhythm of the stars, from resplendent glimmer to dull collapse..."},{"t":"line","name":null,"text":"Death, rebirth, the all-encompassing cycle—she's ever so familiar with it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"npc_10002"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_Mon3tr_n"}},{"t":"line","name":"Mon3tr","text":"(Agitated howling)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"50,0","duration":0.8}},{"t":"cmd","c":"delay","a":{"time":1.3}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"50,0","posto":"-100,0","duration":0.3}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":1,"g":1,"b":1,"fadetime":0.3}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":30,"ystrength":30,"vibrato":40,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_explosion_stone"}},{"t":"cmd","c":"charslot","a":{"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2.5}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#4$1","duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"line","name":"Kal'tsit","text":"Theresa—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#10$1"}},{"t":"line","name":"Kal'tsit","text":"—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'...Yet still, one day I'll choose to slow down, to stop in place where I am.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'When I do, Kal'tsit, don't grieve. Keep going.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"Kal'tsit subconsciously searches her memories..."},{"t":"line","name":null,"text":"Death, rebirth, the all-encompassing cycle."},{"t":"line","name":null,"text":"No."},{"t":"line","name":null,"text":"It's not—the same this time. Not quite."},{"t":"line","name":null,"text":"For the first time, she must bid, to the first who could ever converse with her as an equal, to her dearest friend, farewell."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"image","a":{"image":"49_i01","screenadapt":"coverall","xscale":1.3,"yscale":1.3}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.3,"yscalefrom":1.3,"xscaleto":1,"yscaleto":1,"duration":60,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Kal'tsit","text":"Theresa..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'So, Kal'tsit, it's time to say goodbye.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Kal'tsit","text":"Amiya... Doctor..."},{"t":"line","name":"Kal'tsit","text":"But..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'I always say one day, our wandering is bound to end. One day, the Sarkaz's wandering is bound to end...'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'Now your wandering, too... has reached its endpoint...'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Kal'tsit","text":"I knew full well this possibility always existed... Why...?"},{"t":"line","name":"Kal'tsit","text":"I should have stayed behind—it's my..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'Because I believe in Rhodes Island, I believe in Babel... I believe in you.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Kal'tsit","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'Kal'tsit... I hope the Rhodes can be a place you name home, an Island you may always return to.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Kal'tsit","text":"......"},{"t":"line","name":"Kal'tsit","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"'I already did everything I could do. I won't harbor complaint for my own end.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'Babel's mission is concluded, while you and this landship have only just set sail.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'I am not the same kind as you, Kal'tsit. I cannot explain away your puzzlement.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'But I have always been your companion.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'Then, now, and after...'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'I will always be with you all.'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"'Now...'","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}}]}
