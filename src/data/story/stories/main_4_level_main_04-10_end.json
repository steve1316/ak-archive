a","text":"Madam Ch'en? Can you hear me clearly?"},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"blocker","a":{"a":1,"initr":2,"r":0,"g":0,"b":0,"block":true,"fadetime":1}},{"t":"line","name":"Ch'en","text":"...Lungmen..."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#6"}},{"t":"line","name":"Amiya","text":"...What's going on?!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"fadetime":0}},{"t":"cmd","c":"image","a":{"image":"avg_40_4","fadetime":1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Ch'en","text":"...I'm safe now."},{"t":"line","name":"Ch'en","text":"But..."},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.6,"block":true}},{"t":"line","name":"Ch'en","text":"..."},{"t":"line","name":"Ch'en","text":"...Reunion took over one of our important facilities and is now forcefully opening a passage between the slums and the outer city."},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"image","a":{"image":"avg_ep04","x":0,"y":0,"xscale":1,"yscale":1,"fadetime":0,"screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.6,"block":false}},{"t":"line","name":"Ch'en","text":"Amiya..."},{"t":"line","name":"Ch'en","text":"Lungmen... is in danger."},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.6,"block":true}},{"t":"cmd","c":"image","a":{"fadetime":0}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.6,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"initr":2,"r":0,"g":0,"b":0,"block":true,"fadetime":0.4}},{"t":"line","name":null,"text":"............"},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"image","a":{"image":"item_tll","fadetime":2,"xscale":1.3,"yscale":1.3}},{"t":"cmd","c":"imagetween","a":{"image":"item_tll","tiled":true,"xscaleto":1,"yscaleto":1,"duration":25,"block":false}},{"t":"line","name":"Mephisto","text":"W managed to lure Lungmen and Rhodes Island right into our trap."},{"t":"line","name":"Mephisto","text":"That's right. They won't be able to escape. Faust and Crownslayer have already broken their defenses at one location."},{"t":"line","name":"Mephisto","text":"As you said, this will be our opening to flood into Lungmen."},{"t":"line","name":"Mephisto","text":"We will set up ambushes around every corner. The road to Lungmen will run red with fresh blood."},{"t":"line","name":"Mephisto","text":"Right, that old flag-waver should be coming back to Chernobog soon."},{"t":"line","name":"Mephisto","text":"Our victory is assured."},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness02_intro","key":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness02_loop","volume":1,"crossfade":1,"delay":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Mephisto","text":"Do you have any other orders for me, Talulah?"},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Talulah","text":"..."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Talulah","text":"The time is upon us..."},{"t":"line","name":"Talulah","text":"...to turn this rotten city into ashes."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":5}},{"t":"cmd","c":"blocker","a":{"block":true}}]}
