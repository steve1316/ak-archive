"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","ypos":-40,"fadetime":0.6,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":100,"fadetime":0.6,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"jump","ypos":185,"power":50,"times":1,"fadetime":0.6,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.8}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","ypos":50,"fadetime":0.6,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"jump","ypos":30,"power":30,"times":1,"fadetime":0.6,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":1000,"fadetime":1.2,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":1000,"fadetime":1.2,"block":false}},{"t":"cmd","c":"delay","a":{"time":1.7}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","enter":"left"}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"jump","power":60,"fadetime":0.7,"times":3,"block":true}},{"t":"line","name":"Ink Spirit","text":"Gkhaa—! Gkhaa!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"exit","direction":"right","fadetime":0.7,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Mr. Nothing","text":"Another one?!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_143#2"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"background","a":{"image":"bg_town","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrshot","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"avg_npc_143#2","fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrshot","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_143#2","fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#5"}},{"t":"line","name":"Lava","text":"I can't—I can't deal with this!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_143#2","focus":1}},{"t":"line","name":"Ink Spirit","text":"Gkhaa—!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_143#2","focus":2}},{"t":"line","name":"Ink Spirit","text":"Gkh!"},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#5"}},{"t":"line","name":"Lava","text":"Where the hell did they all come from?!"},{"t":"line","name":"Lava","text":"Damnit, there's no way I can hold back this many—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"char_empty"}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"char_362_Saga#6"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.3,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"line","name":"Ink Spirit","text":"Gkh...?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-100,"ypos":50,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"char_362_Saga#5","fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#5","name2":"char_empty"}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#5","name2":"char_362_Saga#5"}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#5","name2":"char_362_Saga#4","focus":2}},{"t":"line","name":"Saga","text":"Though they may figures in a painting, there is no need to slaughter them all... observing such a scene only serves to inspire outbursts of sorrow."},{"t":"line","name":"Saga","text":"Lava, I am here to watch this place. Thou would best hurry to take others to refuge."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#4","name2":"char_362_Saga#4","focus":1}},{"t":"line","name":"Lava","text":"You..."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#4","name2":"char_362_Saga#4","focus":2}},{"t":"line","name":"Saga","text":"Worry not for me. I have traveled many times here. I have had all manner of thought on the future, anxieties indeterminate—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#4","name2":"char_362_Saga#5","focus":2}},{"t":"line","name":"Saga","text":"—but for that in front of me, I have never been one moment nor fraction irresolute."},{"t":"line","name":"Saga","text":"Leave this to me."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"char_362_Saga#5","focus":1}},{"t":"line","name":"Lava","text":"Alright. Keep going east. When you're done, find me and we'll converge."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"char_362_Saga#5","focus":2}},{"t":"line","name":"Saga","text":"Understood!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"char_362_Saga#5","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_143#2"}},{"t":"line","name":"Ink Spirit","text":"Gkhaa!!"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga#6"}},{"t":"line","name":"Saga","text":"I am here! None shall come forward!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"