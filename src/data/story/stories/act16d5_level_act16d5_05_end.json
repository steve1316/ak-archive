,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-400,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"char_455_nothing_1#3","fadetime":0.5}},{"t":"line","name":"Ink Spirit","text":"Gkhao..."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"char_455_nothing_1#3","focus":2}},{"t":"line","name":"Mr. Nothing","text":"?!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Kroos","text":"Man alive, Nothing, your kickboxing work's not bad, but you've never done a rescue business like this, eh?"},{"t":"line","name":"Kroos","text":"Deal with the enemies in front of you without checking movement on your whole perimeter, and sooner or later you'll give yourself grief."},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#3","name2":"avg_npc_144#1","focus":1}},{"t":"line","name":"Mr. Nothing","text":"Ah, ahahah... that was quite dangerous just now! My apologies for the grief I gave you, benefactor. Only thanks to you am I safe and sound."},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#3","name2":"avg_npc_144#1","focus":2}},{"t":"line","name":"Kroos","text":"Alright, quick, go and get everyone left into shelter."},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#3","name2":"avg_npc_144#1","focus":1}},{"t":"line","name":"Mr. Nothing","text":"Er, what about you, benefactor?"},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#3","name2":"avg_npc_144#1","focus":2}},{"t":"line","name":"Kroos","text":"Me? Don't you mind, I walk light as a feather. They won't ever notice me."},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1","name2":"avg_npc_144#1","focus":1}},{"t":"line","name":"Mr. Nothing","text":"(Can the single skill of light-footedness really explain that?!)"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1"}},{"t":"line","name":"Kroos","text":"And then... how do we cut down these Ink Spirit numbers fast...?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_fireburst","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0.3,"r":255,"g":0,"b":0,"fadetime":0.03,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_141#1"}},{"t":"line","name":"Villager","text":"Eyaah! Wh—what's that fire in the garden?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"background","a":{"image":"bg_town","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"char_362_Saga#3"}},{"t":"line","name":"Saga","text":"Hoo! This blaze soaring skyward makes quite a spectacle!"},{"t":"line","name":"Saga","text":"Ho? Could it be that the name 'Lava' held this exact meaning?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"background","a":{"image":"bg_landscape","screenadapt":"coverall"}},{"t":"cmd","c":"playsound","a":{"channel":"bgs","key":"Sound_Beta_2/AVG/d_avg_burningloop1","volume":1,"loop":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"char_empty"}},{"t":"line","name":"Lava","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#1","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#1","focus":2}},{"t":"line","name":"Kroos","text":"Lavaaa."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#1","focus":1}},{"t":"line","name":"Lava","text":"Confirm the extent of all enemy scatter in the vicinity for me."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#3","focus":2}},{"t":"line","name":"Kroos","text":"This big of an arena?"},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#3","focus":1}},{"t":"line","name":"Lava","text":"I'm worried about the surrounding buildings getting caught up, so I've been sort of keeping my Arts tied down..."},{"t":"line","name":"Lava","text":"...but there's just too many enemies. If we keep dragging this out, I'm concerned casualties are going to end up tough to estimate."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#1","focus":2}},{"t":"line","name":"Kroos","text":"Roger. Special times, special methods, right."},{"t":"line","name":"Kroos","text":"I'll find a high vantage point. You focus on casting."},{"t":"line","name":"Kroos","text":"I'll help you sort all the ones outside your Arts range. I guarantee I'm not gonna miss a single one."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#1","focus":1}},{"t":"line","name":"Lava","text":"Good."},{"t":"line","name":"Lava","text":"I'll submit the mission report afterwards... after all, it's not just the Infected that Rhodes Island helps."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#5","focus":2}},{"t":"line","name":"Kroos","text":"Infected...?"},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#5","focus":1}},{"t":"line","name":"Lava","text":"What's up?"},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#5","focus":2}},{"t":"line","name":"Kroos","text":"Huh... nothing, actually. By the way, Lava."},{"t":"line","name":"Kroos","text":"You seen Mr. Umbrella-Boiler anywhere?"},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1#1","name2":"avg_npc_144#5"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"stopsound","a":{"channel":"bgs"}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}}]}
