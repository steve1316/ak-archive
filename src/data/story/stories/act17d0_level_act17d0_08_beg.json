olume":1}},{"t":"line","name":"Drudge","text":"Please..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral","volume":1}},{"t":"line","name":"Drudge","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral","volume":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2","name2":"avg_npc_158_1#1","focus":2}},{"t":"line","name":"Drudge","text":"Please... stop."},{"t":"line","name":"Ash","text":"Hah. You can still talk. Guess I'm not done."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral","volume":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Ash","text":"And this one's for Dr. Miarow."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown3"}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#2","focus":1}},{"t":"line","name":"Blitz","text":"Okay, okay, he's had enough."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#1","focus":2}},{"t":"line","name":"Ash","text":"Phew..."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#1","focus":1}},{"t":"line","name":"Blitz","text":"You went a little overboard there."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#2","focus":2}},{"t":"line","name":"Ash","text":"What... you feel bad for him?"},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#2","focus":1}},{"t":"line","name":"Blitz","text":"Man, you almost killed him."},{"t":"line","name":"Blitz","text":"Totally rearranged his face."},{"t":"line","name":"Blitz","text":"Save your strength. We've still got work to do."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#6","name2":"char_456_ash_1#1","focus":2}},{"t":"line","name":"Ash","text":"You're right."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#1","name2":"avg_npc_166","focus":2}},{"t":"line","name":"Schwarz","text":"Pfft."},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#3","name2":"avg_npc_166","focus":1}},{"t":"line","name":"Ash","text":"What happened?"},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#1","name2":"avg_npc_166","focus":2}},{"t":"line","name":"Schwarz","text":"Nothing. I'm just feeling a lot more relaxed."},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#1","name2":"avg_npc_166","focus":1}},{"t":"line","name":"Ash","text":"You know what? Me too."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#1","focus":1}},{"t":"line","name":"Blitz","text":"If he's locked up in here, he must be part of Lev's plan."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":2}},{"t":"line","name":"Ash","text":"I'm not surprised."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_lab"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_166","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Schwarz","text":"I don't see anyone here..."},{"t":"line","name":"Schwarz","text":"Might be an ambush ahead. Keep cautious."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#3","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Levi","text":"Well well well, look who it is. More visitors to my laboratory?"},{"t":"line","name":"Levi","text":"It's been a while, my friends from Team Rainbow."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_tense_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_tense_loop","volume":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"A gigantic experimental area, a corner previously kept dark, is bathed in light. At the same time, the visitors all realize why they didn't notice the air when they came in.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The elderly scholar stands behind a thick glass wall, and in front of a huge cultivator. Lev has a grotesque smile on his face, both chilling and unnatural.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"A moment later, the cultivator itself lights up, and reveals a spherical crystal wrapped in connective tissue floating, writhing, twitching.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#2"}},{"t":"line","name":"Levi","text":"You're just in time."},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#3"}},{"t":"line","name":"Levi","text":"No... you always come at precisely the right time."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_staplegun_n","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_sheildimpact"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Ash","text":"Tch."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#2"}},{"t":"line","name":"Levi","text":"Don't bother. It's bulletproof glass."},{"t":"line","name":"Levi","text":"I applaud your decisiveness, squeezing the trigger without hesitation. Don't even wait for an end to our little prologue here."},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#3"}},{"t":"line","name":"Levi","text":"But we have a show to put on. A great opening requires a great audience, and a complete opening dialogue."},{"t":"line","name":"Levi","text":"Today is a day of praise for the great work of the Creator. And that Creator is none other than yours truly."},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2"}},{"t":"line","name":"Ash","text":"Creator? That's quite a title you've given yourself."},{"t":"line","name":"Ash","text":"You're a *profanity* psycho!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#2"}},{"t":"line","name":"Levi","text":"Psycho... hah. The mediocre always use this word to describe ideas and concepts they cannot understand."},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#3"}},{"t":"line","name":"Levi","text":"Behold this world!"},{"t":"line","name":"Levi","text":"Completely different chemistry... totally inverted laws of physics... the flower of science blooms in exploration and doubt. And the most fertile soil lies in the land of the unknown!"},{"t":"line","name":"Levi","text":"And now, I have succeeded."},{"t":"line","name":"Levi","text":"Do you see? Can you feel? The surface appearance is similar, but it all functions on radically different principles!"},{"t":"line","name":"Levi","text":"This is the evolution of life. This is the iteration of existence."},{"t":"line","name":"Levi","text":"Originium is the truth of this world. You should accept that. Don't fear it."},{"t":"line","name":"Levi","text":"Welcome to the future."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2"}},{"t":"line","name":"Ash","text":"Don't you have even the slightest moral compunction over what you're doing?"},{"t":"line","name":"Ash","text":"What does human life even mean to you?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#2"}},{"t":"line","name":"Levi","text":"Human nature is weak, good and evil are subjective definitions of weakness, and what we call guilt is but one of the myriad cognitive signals produced by the brain."},{"t":"line","name":"Levi","text":"And the science I pursue is never swayed by such flimsy concepts."},{"t":"line","name":"Levi","text":"Don't delude yourselves that even in this world you still bind your minds with these meaningless ideas."},{"t":"line","name":"Levi","text":"Even electronic information technology and nuclear energy were originally designed to help us kill each other more effectively."},{"t":"line","name":"Levi","text":"Would you add a new layer of definition to science? Force everything to fit your fragile spiritual needs?"},{"t":"line","name":"Levi","text":"Nonsense."},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#3"}},{"t":"line","name":"Levi","text":"But I forgive you."},{"t":"line","name":"Levi","text":"You don't have to understand. I'll allow you to go on, unknowing. Primitive thinking is a common form of ignorance. It's not your fault, and I forgive you."},{"t":"line","name":"Levi","text":"That's the end of my speech. And in addition to my forgiveness, I also offer you my thanks for waiting so patiently."},{"t":"line","name":"Levi","text":"Now it is time for praise. Give your praise to this entirely new life form."},{"t":"cmd","c":"character","a":{"name":"avg_npc_157_1#1"}},{"t":"line","name":"Levi","text":"Praise be! Praise be! Praise be!!!"},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_blunt_h","volume":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_bottlebroken"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_blunt_h","volume":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_bottlebroken"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_blunt_h","volume":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_bottlebroken"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":2,"xstrength":40,"ystrength":40,"vib