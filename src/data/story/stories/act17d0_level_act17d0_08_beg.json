aracter","a":{"name":"avg_npc_166","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Schwarz","text":"...Why would Long Spring have a facility like this underneath it?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"char_empty"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":-200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":200,"fadetime":1,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":200,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":1}},{"t":"line","name":"Blitz","text":"Cohen... Where are we?"},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":2}},{"t":"line","name":"Ash","text":"I knew it! *profanity*, I knew it!"},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":1}},{"t":"line","name":"Blitz","text":"So this is where most of the lab ended up."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":2}},{"t":"line","name":"Ash","text":"Now that I think about it, we were too careless."},{"t":"line","name":"Ash","text":"We've lived in this town for so long and we had no idea at all."},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4","name2":"char_456_ash_1#2","focus":1}},{"t":"line","name":"Blitz","text":"