action","a":{"name":"left","type":"jump","power":60,"fadetime":0.7,"times":3,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Little Girl","text":"Papa? Mama?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_362_Saga#5","name2":"char_455_nothing_1#3","focus":2}},{"t":"line","name":"Mr. Nothing","text":"Th—There's a child there!"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga#6","name2":"char_455_nothing_1#3","focus":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-200,"fadetime":0.6,"times":3,"block":true}},{"t":"line","name":"Saga","text":"Oh no—get down, now!"},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"character","a":{"name":"char_362_Saga#6","name2":"char_455_nothing_1#3","focus":2}},{"t":"line","name":"Mr. Nothing","text":"She won't make it!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_143#2","name2":"avg_npc_142#1"}},{"t":"line","name":"Little Girl","text":"Uwaahhh... waaaaaahh..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":100,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_arrow_h","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.04,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-400,"fadetime":1,"block":true}},{