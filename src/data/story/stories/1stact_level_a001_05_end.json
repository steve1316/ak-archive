:true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Bounty Hunter","text":"Guh—"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"How many of them are left...?"},{"t":"line","name":"Grani","text":"Forget it, I lost track. As long as they don't make it inside..."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":3,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"line","name":"Grani","text":"E-Earthquake?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"line","name":"Grani","text":"Huh? Is that an avalanche over there? Why though?"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":"Skadi","text":"..."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"line","name":"Grani","text":"You've gotta be kidding... She can even smash through a stone wall that thick?"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Bounty Hunter","text":"A new entrance opened up over there! Hurry, let's go in there!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun"}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"Damn it, those guys are definitely going to swarm in through that new passageway Skadi just created!"},{"t":"line","name":"Grani","text":"I have to find Carol—"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"Stop right there."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Skadi..."},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"..."},{"t":"line","name":"Grani","text":"Unbelievable... Not even a mountain can stand in her way. Those rumors really were true."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"Where's the girl?"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"I'm not telling you."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"I'm not the only one after that... thing."},{"t":"line","name":"Skadi","text":"You ought to cooperate before I'm forced to do things the hard way."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"I can't just hand Carol over to you if you don't tell me what's going on!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"So... you intend to impede a mission from Rhodes Island?"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"What mission? You didn't even tell me anything about that!"},{"t":"line","name":"Grani","text":"Unless you..."},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#1","focus":2}},{"t":"line","name":"Grani","text":"Hey, don't just start swinging at your comrades!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#1","focus":1}},{"t":"line","name":"Skadi","text":"I'm not your comrade."},{"t":"line","name":"Skadi","text":"This is your last chance. Take me to see that girl."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"No chance in hell. My mission is to keep her safe."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_defboost"}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"Aaaaghh..."},{"t":"line","name":"Grani","text":"Damn... All she did was tap her sword against my lance, but it feels like my arm is about to snap..."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"Do you think you can really protect her with abilities of this caliber?"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Whether or not I can... has nothing to do with whether or not I will!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Skadi","text":"..."},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Huh? Wait a second!"},{"t":"line","name":"Grani","text":"Watch out!"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_defboost"}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":30,"fadeout":true,"block":true}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_bat_indust_intro","key":"Sound_Beta_2/Music/beta1_180603/m_bat_indust_loop","volume":0.6,"crossfade":1.5}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Bounty Hunter","text":"Tch, that ought to have done the trick!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Violent Bounty Hunter","text":"Yeah, we... no, we didn't get her?! She's still unscathed!"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","fadetime":1}},{"t":"line","name":"Skadi","text":"...You again?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"avg_npc_007","focus":1}},{"t":"line","name":"Bounty Hunter","text":"Gah...!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Violent Bounty Hunter","text":"The l-living Catastrophe! You're the one who hurt the captain! We can't let you leave alive—"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#3"}},{"t":"line","name":"Grani","text":"Now's my chance!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Bounty Hunter","text":"Don't you even think about it!"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#2"}},{"t":"line","name":"Grani","text":"You guys really should worry about holding her back first!"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_defboost"}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.6,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Bounty Hunter","text":"...Huh?"},{"t":"line","name":"Bounty Hunter","text":"What just happened?! That kid just vaulted over our heads?"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#2","focus":2}},{"t":"line","name":"Grani","text":"See you later, Skadi!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#2","focus":1}},{"t":"line","name":"Skadi","text":"You..."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#2","focus":2}},{"t":"line","name":"Grani","text":"Sorry! When you're ready to explain to me what's going on, maybe then we can talk about Carol!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2","name2":"char_220_grani#2","focus":1}},{"t":"line","name":"Skadi","text":"Stop, get back here!"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#3"}},{"t":"line","name":"Grani","text":"Sorry again!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.5}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"avg_npc_007","focus":2}},{"t":"line","name":"Violent Bounty Hunter","text":"How could you just let her go like that?!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"avg_npc_007","focus":1}},{"t":"line","name":"Bounty Hunter","text":"She's too fast for us to catch!"},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2"}},{"t":"line","name":"Skadi","text":"..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_007"}},{"t":"line","name":"Violent Bounty Hunter","text":"Whatever, let's just deal with this one first."},{"t":"line","name":"Violent Bounty Hunter","text":"With how much bigger you are, I bet you can't leap over us."},{"t":"cmd","c":"character","a":{"name":"char_263_skadi#2"}},{"t":"line","name":"Skadi","text":"...You're all dead."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":3}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_cave_2","fadetime":1}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":2,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5","fadetime":2}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness01_intro","key":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness01_loop","volume":0.6,"crossfade":1.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Grani","text":"It really is like a maze in here with all these winding paths. Carol was right."},{"t":"line","name":"Grani","text":"Hmm? What's a bounty hunter doing here—"},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Bounty Hunter","text":"Ugh... save me..."},{"t":"line","name":"Bounty Hunter","text":"..."},{"t":"cmd","c":"character","a":{"name":"char_220_grani#1"}},{"t":"line","name":"Grani","text":"Poor guy..."},{"t":"line","name":"Grani","text":"He looks like he got pummeled a few times..."},{"t":"line","name":"Grani","text":"B-but Skadi is still outside the cave, right?"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"What's this opening? It looks like the wall was blasted open..."},{"t":"line","name":"Grani","text":"That must mean—"},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"line","name":"Grani","text":"You already figured it out."},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.5}},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_1","name2":"char_1002_nsabr_2","fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_010#2","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":"???","text":"......"},{"t":"line","name":"???","text":"I'm a pretty good actor, right?"},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"So it was your doing..."},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}}]}
