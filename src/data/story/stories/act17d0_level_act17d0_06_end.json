":"char_empty","name2":"avg_npc_160_1#1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":200,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/static/m_avg/m_avg_loneliness_intro","key":"Sound_Beta_2/Music/static/m_avg/m_avg_loneliness_loop","volume":0.4}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":1}},{"t":"line","name":"Tachanka","text":"Stay with me! Don't close your eyes, boy!"},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#3","name2":"avg_npc_156_1#1","focus":1}},{"t":"line","name":"Ash","text":"Why... what happened?"},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#3","name2":"avg_npc_156_1#1","focus":2}},{"t":"line","name":"Liskarm","text":"When you push yourself to use Originium Arts... it worsens your Originium infection..."},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2","name2":"avg_npc_156_1#1","focus":1}},{"t":"line","name":"Ash","text":"Rhodes Island doesn't have a countermeasure? Isn't this what you people do?"},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#2","name2":"avg_npc_156_1#1","focus":2}},{"t":"line","name":"Liskarm","text":"Between the blood loss, burns, and acute Oripathy symptoms, even if we were back on the landship..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":2}},{"t":"line","name":"Miarow","text":"...*cough*..."},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":1}},{"t":"line","name":"Tachanka","text":"I said stay with me, kid."},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":2}},{"t":"line","name":"Miarow","text":"......"},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":1}},{"t":"line","name":"Tachanka","text":"...You can do this. Remember how you wanted to travel the world? Picture that Columbia you were dreaming about."},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Tachanka","text":"...Stay with me!"},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"avg_npc_160_1#1","focus":2}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"line","name":"Miarow","text":"*cough* *cough*..."},{"t":"line","name":"Miarow","text":"...*cough*..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1","name2":"char_empty","fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Tachanka","text":"......"},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#4"}},{"t":"line","name":"Ash","text":"...Doctor..."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3"}},{"t":"line","name":"Frost","text":"...He's gone."},{"t":"cmd","c":"character","a":{"name":"avg_npc_166"}},{"t":"line","name":"Schwarz","text":"...I'm sorry. I couldn't..."},{"t":"cmd","c":"character","a":{"name":"char_456_ash_1#4"}},{"t":"line","name":"Ash","text":"No... it's not your fault."},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":2}},{"t":"line","name":"Tachanka","text":"......"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":1}},{"t":"line","name":"Mercenary","text":"...No... I had nothing to do with that. It wasn't me!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":2}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Tachanka","text":"(Russian profanity), I'm going to twist your *profanity* head off."},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":1}},{"t":"line","name":"Mercenary","text":"I just...don't..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":2}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Tachanka","text":"You're done for, (Russian profanity). You're toasted."},{"t":"cmd","c":"character","a":{"name":"avg_npc_007","name2":"char_459_tachak_1","focus":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":15,"vibrato":20,"fadeout":true,"block":false}},{"t":"line","name":"Mercenary","text":"No! Don't hurt me! It wasn't me! No!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_457_blitz_1#4"}},{"t":"line","name":"Blitz","text":"Alexsandr! Stop! Calm down!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#1"}},{"t":"line","name":"Liskarm","text":"Where did that guard captain go? The Lord's daughter?"},{"t":"cmd","c":"character","a":{"name":"a