{"id":"main_12_level_main_12-14_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"image":"37_g7_airshipdock","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#5$1","focus":"m"}},{"t":"line","name":"Amiya","text":"So this is the airship..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"All our attempts to infiltrate it ended in failure. Anyone who approached simply vanished into thin air."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Is that some kind of Sarkaz witchcraft? Surely the Lord of Fiends would know how to neutralize it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#5$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#14$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Is Theresa here?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#14$1","focus":"m"}},{"t":"line","name":"Amiya","text":"But I can't feel—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#5$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Urgh!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"line","name":null,"text":"A heavy pressure comes over her."},{"t":"line","name":null,"text":"It is far too thick, far too cruel, to be described or spoken of."},{"t":"line","name":null,"text":"Amiya can hardly stand."},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_plot_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_plot_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#13$1","focus":"m"}},{"t":"line","name":"Amiya","text":"What... is this...?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"What are you doing, Lord of Fiends? Don't try anything funny!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Neutralize it with your witchcraft! Or else..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#6$1","focus":"m","duration":0.4}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_knife","volume":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_knifegore","volume":0.7,"delay":0.1}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":1,"g":1,"b":1,"fadetime":0.03,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_swordtsing5","delay":0.2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.01,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Ugh—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"duration":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":20,"ystrength":10,"vibrato":10,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown2"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"decision","options":["Ascalon."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#1$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Sorry I'm late."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Calm down, Ascalon."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"This was all my colleague's plan! I tried to talk him out of it!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"I don't intend to harm your Doctor. We're just getting a deal done. You'll be the witness."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Then get out of my way."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"r"}},{"t":"decision","options":["What is it?","......","You're really pale."],"values":["1","2","3"]},{"t":"predicate","refs":["1","2","3"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#10$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"You can't feel it because you're not Sarkaz."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#10$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"We're coming face to face with our history. The sum of the Sarkaz's millennia of suffering."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#2$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"It's angry. It's screaming, and it's making all of us listen to it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"No wonder."},{"t":"line","name":"Ascalon","text":"Ha, the dukes are going to be disappointed. This is no engineering or technology that can be copied."},{"t":"line","name":"Ascalon","text":"The ship itself is a revenant."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"subtitle","a":{"text":"How did the Sarkaz live?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How did the Sarkaz live in the beginning?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The Elders and the Ancients had not come upon the land yet. All things were how they should be.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Then they came.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"They killed and slaughtered. They brought barbarism and rage upon the land. Their fangs and claws were not pointed at just each other, but at us as well.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The proud Sarkaz never surrendered. We fought back.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"We fought rage with rage. They will taste the fruit of vengeance!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But Kazdel was destroyed in the blink of an eye.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Despicable!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"They stopped at nothing. They were cunning, shameless, cruel.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How dare they trample upon pure Kazdel?!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How dare they?!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Argh—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I... the voices..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Don't let it affect you, Amiya!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Resist the illusion!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#15$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I know, I'm trying..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Argh—Aah—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Kazdel was destroyed.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The King of Sarkaz and the Royal Court led us in the fight against the scum. The Sarkaz will not permit such shameful failure.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But those cowardly Sarkaz, who call themselves the Sankta, deserted their duty. They betrayed their people, betrayed themselves!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The walls fell again, and with it our dream.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"No matter. The traitors will be purged. Kazdel will stand again.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"As long as the King of Sarkaz still stands, we will never fall.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"The shadows..."},{"t":"line","name":"'Trilby Asher'","text":"No, it's not like the shadows from Ines's Arts. What is it?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Get out of the airship's shadow, Doctor!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The airship's shadow wriggles, stretches. The other 'Trilby Asher' whom Ascalon knocked to the ground disappears in the dark ocean."},{"t":"line","name":"'Trilby Asher'","text":"What the hell is this...?"},{"t":"line","name":null,"text":"Suffocating black, suffocating despair, suffocating fury."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"The King of Sarkaz will lead us. The King of Sarkaz.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Thirty-four times did Kazdel fall.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Six hundred and seventy-five times did Kazdel fall.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Three thousand four hundred and twenty-one times did Kazdel fall.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The shortest it took was three days, between the rebuilding of Kazdel's walls, and the hoofs of pegasi trampling it to dust.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Time and again Kazdel was destroyed. Time and again, it was rebuilt.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Time has changed our faces and theirs. But the way has never ended. Our resistance never wavered.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But each rebuilding of Kazdel took longer than the previous one.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Our civilization was devastated. Our arts were forgotten.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But we still have our hatred. The King of Sarkaz will slay our foes with it!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I am proud of this, of our unwavering resolve.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But what do I see?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{"image":"37_i10","screenadapt":"coverall","fadetime":0}},{"t":"cmd","c":"imagetween","a":{"xfrom":0,"yfrom":30,"xto":0,"yto":0,"xscalefrom":1.1,"yscalefrom":1.1,"xscaleto":1,"yscaleto":1,"duration":8,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":4}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"A twisted chimera...","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"An Outblood King?!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The King of Sarkaz who stands before me is an Outblood?!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"This crown is not yours to wear! This pain is not yours to stand with!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"This fury is not yours to stand for!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Answer me, impostor! Answer me, fraud!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Answer the revenant's question!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"line","name":"Amiya","text":"The revenant..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Open your eyes and see, False King!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"What do you see?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I see..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Don't look, Amiya! It's the revenant's witchcraft!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I saw tears."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I saw deep, heavy sorrow."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Has this sorrow always been with you?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Sorrow? This is no sorrow.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I feel no sorrow anymore.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"You have scorched your wound with the flames of rage."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"It's... painful."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"I know what is real and what is false!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Answer my question!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How—dare you—","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Twisted—Outblood—","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How—dare—you—","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Carry the burden of the Sarkaz!!!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"37_g7_airshipdock","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"Ascalon stumbles."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["Are you ok, Ascalon?"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#10$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"I... I'm fine..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#10$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"Amiya—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Amiya looks up towards the great shadow of the revenant."},{"t":"line","name":null,"text":"You cannot see her face. You only know she is looking up."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"You're right, Revenant. I should see. I have seen."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I have seen it all."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"All three thousand four hundred and twenty-one destructions, every brick that turned to ash."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I saw the resistance of every King of Sarkaz. I saw their hearts, each and every one of them."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I saw the tears and blood swallowed. I saw the dust and broken pieces."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Familiar silhouettes fall, overlapping with one another. Familiar scenes replay themselves."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I have seen. I see. I will see."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I never averted my eyes, Revenant."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I will remember."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#1$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Every hard decision, every death and sacrifice, every destruction, every hope."},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"—I made you see, Chimera.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I made you see!!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Impostor! There is not a single moment that I do not experience it, feel the burning flames!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But you?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Yes, you could see it, like a map, like a play, a mere passerby watching from above the cliffs.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I denounce you, False King, I despise you, not because of your foolishness, not because of your arrogance, not because of your conceit.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"It's because you can never truly stand with us.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#15$1","focus":"m"}},{"t":"line","name":"Amiya","text":"But I've tried—"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Tried?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You could try to not avert your eyes—","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But you can still turn away any time you choose.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#14$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I..."},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"You're not Sarkaz. You will never be.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The souls of the Sarkaz reject you.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You call our fate 'pain?' You say you try to endure it—","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But we are fated to be buried by it for eternity.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You say you have the courage. But if the day comes that you can take it no more...","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You can abandon us.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#15$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I won't—"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"How many seasons have you seen? How dare you promise that you won't?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"No, you will. You will, because you can.","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"How could Sarkaz pick such a king? How could Sarkaz accept such a king?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#7$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Theresa wanted me to be... she said we can share in the same feelings, even if we're not of the same blood!"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Then she was a fool!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"If you truly share the same feelings... now that you have seen it all...","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Why do you come before me?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Why do you try to stop this war?","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#14$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Amiya finds herself at a loss for words."},{"t":"line","name":null,"text":"Why does she want to stop this war?"},{"t":"line","name":null,"text":"She has seen the anger, the pain, the longing."},{"t":"line","name":null,"text":"Why does she want to stop this war?"},{"t":"line","name":null,"text":"There is no other way for the Sarkaz."},{"t":"line","name":null,"text":"No Sarkaz could come to any other answer, after coming face to face with it all."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"But..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Amiya realizes that, for an instant, she understood Theresa's choice."},{"t":"line","name":null,"text":"Drown tears with tears, and bury suffering with suffering."},{"t":"line","name":null,"text":"Only scorched earth will bring new life to the Sarkaz."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"But..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Still... I renounce this path."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The revenant was right."},{"t":"line","name":null,"text":"She renounced it. She can never truly stand with them."},{"t":"line","name":null,"text":"She can leave."},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Get out!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Get out of us!","x":300,"y":370,"alignment":"center","size":26,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1.5}},{"t":"line","name":null,"text":"The shadow wriggles furiously, splitting apart, growing so thick it seems to take physical form."},{"t":"line","name":null,"text":"The chaotic shadow of the revenant emerges from the empty shipyard."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_ignite_cast","volume":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_deathfire","volume":1,"delay":0.5}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_034_magic_fire_02","layer":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act17d0d0/m_bat_essenceofevolution_intro","key":"Sound_Beta_2/Music/act17d0d0/m_bat_essenceofevolution_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#1$1","focus":"m","duration":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Eblana","text":"Hello there, big one."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The purple flame impacts the black shadow."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#1$1","focus":"m"}},{"t":"line","name":"Eblana","text":"You interest me, Revenant."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#1$1","focus":"m"}},{"t":"line","name":"Eblana","text":"What ember will you leave behind when you burn?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"That Draco... Eblana."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Nothing in the mission brief said she would show up!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_867_1#1$1","focus":"m"}},{"t":"line","name":"'Trilby Asher'","text":"Go! Hurry!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"decision","options":["Amiya!"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I... I'm fine..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"r"}},{"t":"decision","options":["Here, hold onto me."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Doctor, I..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"They're right... I can't stand with them..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"r"}},{"t":"decision","options":["Maybe that's why it has to be you."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#5$1","focus":"m"}},{"t":"line","name":"Amiya","text":"...Huh?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"The Draco's fire is getting closer!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_395_1#3$1","focus":"m"}},{"t":"line","name":"Ascalon","text":"She's strong! We shouldn't try to fight her here!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#2$1","focus":"m"}},{"t":"line","name":"Eblana","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#6$1","focus":"m"}},{"t":"line","name":"Eblana","text":"Hmph... interesting."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#6$1","focus":"m"}},{"t":"line","name":"Eblana","text":"Rhodes Island..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_722_1#6$1","focus":"m"}},{"t":"line","name":"Eblana","text":"I seem to hear that name often lately."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{"layer":1}},{"t":"cmd","c":"bgeffect","a":{"layer":2}},{"t":"cmd","c":"background","a":{"image":"37_g9_airshipdockcorridor","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_419_1#1$1","focus":"m"}},{"t":"line","name":"Royal Court Soldier","text":"G-General... the Draco..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_404_1#6$1","focus":"m"}},{"t":"line","name":"Manfred","text":"Pay no heed."},{"t":"line","name":"Manfred","text":"Her flames burn nothing but her own short-sighted ambition."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_404_1#1$1","focus":"m"}},{"t":"line","name":"Manfred","text":"Lead us away from here, Great Revenant. This shipyard is too small for your fury. The noises of those Outblood are not worth your time."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_404_1#1$1","focus":"m"}},{"t":"line","name":"Manfred","text":"I have heard from the Regent. He is ready."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"background","a":{"image":"37_g8_airshipdock_ex","screenadapt":"coverall"}},{"t":"cmd","c