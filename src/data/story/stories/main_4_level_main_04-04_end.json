g to shoot?"},{"t":"line","name":"Mephisto","text":"What a pity."},{"t":"line","name":"Mephisto","text":"You know, you won't get another chance."},{"t":"cmd","c":"character","a":{"name":"char_219_meteo_1"}},{"t":"line","name":"Meteorite","text":"Is he leaving? But--"},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1"}},{"t":"line","name":"Frostleaf","text":"Meteorite! Aim at that collapsing building to the west, now! At least we can distract the enemy to buy us some time!"},{"t":"cmd","c":"character","a":{"name":"char_219_meteo_1"}},{"t":"line","name":"Meteorite","text":"...This is our only option! I'll do it!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_explo_n"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":8,"vibrato":30,"randomness":90,"fadeout":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.93,"g":0.7,"b":0.2,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.93,"g":0.75,"b":0.32,"fadetime":0.2,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1","name2":"char_259_Jessica_1","focus":1}},{"t":"line","name":"Frostleaf","text":"Jessica, start running."},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1","name2":"char_259_Jessica_1#3","focus":2}},{"t":"line","name":"Jessica","text":"Huh?"},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1","name2":"char_259_Jessica_1#3","focus":1}},{"t":"line","name":"Frostleaf","text":"...The Yetis are here."},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1","name2":"char_259_Jessica_1#5","focus":2}},{"t":"line","name":"Jessica","text":"Wait..."},{"t":"line","name":"Jessica","text":"S-so cold..."},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1","name2":"char_259_Jessica_1#5","focus":1}},{"t":"line","name":"Frostleaf","text":"... ...Let's go."},{"t":"line","name":"Frostleaf","text":"Now."},{"t":"cmd","c":"character","a":{"name":"char_219_meteo_1"}},{"t":"line","name":"Meteorite","text":"...Jessica."},{"t":"line","name":"Meteorite","text":"She's right."},{"t":"line","name":"Meteorite","text":"We need to get out of here...!"},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1"}},{"t":"line","name":"Frostleaf","text":"Amiya, can you hear me?"},{"t":"line","name":"Frostleaf","text":"Hello? Hello?"},{"t":"cmd","c":"character","a":{"name":"char_219_meteo_1"}},{"t":"line","name":"Meteorite","text":"Just go! I'll cover you!"},{"t":"cmd","c":"character","a":{"name":"char_193_frostl_1"}},{"t":"line","name":"Frostleaf","text":"Listen, Amiya."},{"t":"line","name":"Frostleaf","text":"...Do not come."},{"t":"line","name":"Frostleaf","text":"These ruins are..."},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}}]}
