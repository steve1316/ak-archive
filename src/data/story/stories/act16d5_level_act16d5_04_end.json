":1,"block":false}},{"t":"line","name":"Mr. Nothing","text":"It's Kroos, my benefactor! Dear me, here, good benefactor, come, if you had a free hand, you could've helped me a little sooner! Er, where, where are you?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Kroos","text":"Right here."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/a001/m_dia_path_intro","key":"Sound_Beta_2/Music/a001/m_dia_path_loop","volume":0.4}},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#6","name2":"avg_npc_142#2","focus":2}},{"t":"line","name":"Little Girl","text":"Yah...! M—Miss, where did you come from?"},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#6","name2":"avg_npc_142#2","focus":1}},{"t":"line","name":"Mr. Nothing","text":"Wow! I'd be remiss not to laud your sniping skills as beyond the blue! You slip about like a ghost, land without a whisper! You really are—"},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#6","name2":"avg_npc_142#2","focus":2}},{"t":"line","name":"Little Girl","text":"Miss! Thank you for saving mister!"},{"t":"cmd","c":"character","a":{"name":"char_455_nothing_1#3","name2":"avg_npc_142#2","focus":1}},{"t":"line","name":"Mr. Nothing","text":"Err."},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1"}},{"t":"line","name":"Kroos","text":"Run on back, quick. Your mum's been looking for you for ages now."},{"t":"cmd","c":"character","a":{"name":"avg_npc_142#2"}},{"t":"line","name":"Little Girl","text":"Mm-hm!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"exit","direction":"right","fadetime":1.5,"block":false}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#3","focus":2}},{"t":"line","name":"Mr. Nothing","text":"Benefactor, why don't you hurry to Lava and Saga's aid? Let me keep watch here, safeguard the perimeter."},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#3","focus":1}},{"t":"line","name":"Kroos","text":"Didn't you just cross your heart you'd return to Lava to help her?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#3","focus":2}},{"t":"line","name":"Mr. Nothing","text":"B—Benefactor, might you have the gift of clairaudience...?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#3","focus":1}},{"t":"line","name":"Kroos","text":"Nope."},{"t":"line","name":"Kroos","text":"Why've you been holding onto that folding fan the whole time?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#6","focus":2}},{"t":"line","name":"Mr. Nothing","text":"Ah, I simply must! This fan is the most precious thing I have, a present to me from my most respected teacher! I'd hate to let it out of my grasp!"},{"t":"line","name":"Mr. Nothing","text":"Moreover, here, clasping this fan in my hand, I look quite refined, don't I?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#3","name2":"char_455_nothing_1#6","focus":1}},{"t":"line","name":"Kroos","text":"Hmmmgh..."},{"t":"line","name":"Kroos","text":"Why'd that Ink Spirit get over here just now without any trouble? It counts as daytime, right?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#3","name2":"char_455_nothing_1#6","focus":2}},{"t":"line","name":"Mr. Nothing","text":"I was wondering too! That cretin chased the wind out of me!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#6","focus":1}},{"t":"line","name":"Kroos","text":"Hmm... anyhow, better head for Lava."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_144#1","name2":"char_455_nothing_1#6"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"background","a":{"image":"bg_pawnshop","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_362_Saga","name2":"char_1011_purgatory_1","focus":2}},{"t":"line","name":"Lava","text":"It's quiet."},{"t":"line","name":"Lava","text":"We're clearly on the fringe of night here. I can only see a crack of dawnlight. Why aren't any monsters charging through?"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga","name2":"char_1011_purgatory_1","focus":1}},{"t":"line","name":"Saga","text":"I also thought it strange. It has never been so peaceful, has it?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5"}},{"t":"line","name":"Dawn","text":"Isn't it good that it's peaceful?"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga"}},{"t":"line","name":"Saga","text":"Ha! That is so. I may at last catch my breath!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"jump","power":10,"ypos":-20,"times":2,"fadetime":0.7,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"line","name":"Saga","text":"Huff!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5"}},{"t":"line","name":"Dawn","text":"Careful you don't crush any goods."},{"t":"cmd","c":"character","a":{"name":"char_1011_purgatory_1"}},{"t":"line","name":"Lava","text":"......"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga","name2":"char_1011_purgatory_1","focus":2}},{"t":"line","name":"Lava","text":"Saga, the Dusk Beauty you mentioned just now... who does that refer to?"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga","name2":"char_1011_purgatory_1","focus":1}},{"t":"line","name":"Saga","text":"Naturally, the Dusk Beauty of the well-told 'Dusk Beauty Flying to the Moon' tale. My word, to this day I cannot forget the sight of the eyes of Dusk Beauty—"},{"t":"cmd","c":"character","a":{"name":"char_362_Saga","name2":"char_1011_purgatory_1","focus":2}},{"t":"line","name":"Lava","text":"...???"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5"}},{"t":"line","name":"Dawn","text":"Saga, tell it a little slower. Miss Lava's giving you a funnier and funnier look."},{"t":"cmd","c":"character","a":{"name":"char_362_Saga"}},{"t":"line","name":"Saga","text":"Oh, beg pardon, 'twas my impatience. Lava, thou art also tired from withstanding Ink Spirits, art thou not? Ought we perhaps sit down with some tea, and there make proper talk?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5"}},{"t":"line","name":"Dawn","text":"Sure. I'll go brew you some tea, then."},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5","name2":"char_362_Saga","focus":2}},{"t":"line","name":"Saga","text":"Right, I would like to ask thee first. Young Dawn, dost thou know any way of leaving this place?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5","name2":"char_362_Saga","focus":1}},{"t":"line","name":"Dawn","text":"No."},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5","name2":"char_362_Saga","focus":2}},{"t":"line","name":"Saga","text":"Thou dost not?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#1","name2":"char_362_Saga","focus":1}},{"t":"line","name":"Dawn","text":"(Lightly shakes head)"},{"t":"cmd","c":"character","a":{"name":"avg_npc_139#5","name2":"char_362_Saga"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Dawn lifts her head, looks to the open door, and along the road to far away.","x":250,"y":370,"alignment":"center","size":24,"delay":0.1,"width":900}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"subtitle","a":{"text":"She dares not speak loud—","x":250,"y":370,"alignment":"center","size":24,"delay":0.1,"width":900}},{"t":"cmd","c":"subtitle","a":{"text":"—for fear of disturbing those above of heaven.","x":250,"y":370,"alignment":"center","size":24,"delay":0.1,"width":900}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_dia_mist_intro","key":"Sound_Beta_2/Music/beta1_180603/m_dia_mist_loop","volume":0.4,"crossfade":2}},{"t":"cmd","c":"character","a":{"name":"avg_npc_138#3"}},{"t":"cmd","c":"background","a":{"image":"bg_landscape","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Storyteller","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}}]}
