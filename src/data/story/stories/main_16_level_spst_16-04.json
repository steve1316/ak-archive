{"id":"main_16_level_spst_16-04","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"background","a":{"image":"66_g8_farnorthtundra_aurora","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/AVG/m_avg_monastery_nomal","volume":0.6}},{"t":"cmd","c":"subtitle","a":{"text":"*huff*... *huff*...","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"It hurts... the rocks are piercing the flesh... I can almost hear them growing. Why am I still alive?","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I'm exhausted. I can't feel my limbs... Run! Run to the east!","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Death awaits in the south. Death awaits in the north. In the west... the mines there are a dead end, just like those in the Far North.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I can run from the Far North... but how do I run from pain?","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"animtext","a":{"id":"at1","name":"group_location_stamp","style":"avg_only_heavy","pos":"-400,-200","block":false}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"animtextclean","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1969_1#1$1","duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Infected Miner","text":"Urgh..."},{"t":"line","name":"Infected Miner","text":"I can't... run... anymore..."},{"t":"line","name":"Infected Miner","text":"This is it..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowbodyfall"}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"0,-60","duration":0.7,"afrom":1,"ato":0}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":2,"ystrength":10,"vibrato":10,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Infected Miner","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowbootwalk","volume":0.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Distant Voice","text":"Is someone there?"},{"t":"line","name":"Distant Voice","text":"I'll take a look—"},{"t":"line","name":"Distant Voice","text":"No, please let me..."},{"t":"line","name":"Distant Voice","text":"I can sense that it's only a poor soul who has suffered much."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowbootwalk"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1","duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"???","text":"Exhausted, dehydrated, starved..."},{"t":"line","name":"???","text":"You're Infected too."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Infected Miner","text":"*cough* *cough*!"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Anxious Voice","text":"He's one of us, comrades!"},{"t":"line","name":"Anxious Voice","text":"Please, save him, just as you saved all of us—"},{"t":"line","name":"Anxious Voice","text":"Perform your miracle!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"???","text":"It's not a miracle..."},{"t":"line","name":"???","text":"Oripathy is not the main reason for his pain. I can only stop his illness from tormenting him, but I cannot give him food, clean water, or a safe place to sleep."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#4$1"}},{"t":"line","name":"???","text":"I can't perform miracles. I'm not all-powerful. I simply... believe."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Pious Voice","text":"You're always so humble. We understand."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"???","text":"...Can you hear me, sir?"},{"t":"line","name":"???","text":"I'll hold your hand..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#3$1"}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"???","text":"'Believe. Believe in our life.'"},{"t":"line","name":"???","text":"'Believe in our body and mind, believe every beat of our heart, believe every inhale and exhale.'"},{"t":"line","name":"???","text":"'Believe that we are the source of all strength.'"},{"t":"line","name":"???","text":"No longer will you live in fear of death."},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"line","name":null,"text":"The pain brought about by the rapid growth of Originium in his body begins to fade."},{"t":"line","name":null,"text":"He can still hear the voices, but he is no longer writhing in pain."},{"t":"line","name":"Infected Miner","text":"Wh-Who are you?"},{"t":"line","name":"Infected Miner","text":"You saved me..."},{"t":"line","name":"Infected Miner","text":"*cough* *cough*—"},{"t":"line","name":"Infected Miner","text":"What can I do to repay you?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"???","text":"You can call me Hierda, like everyone else here."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Anxious Voice","text":"A miracle—"},{"t":"line","name":"Anxious Voice","text":"Hierda has once again saved our comrade!"},{"t":"line","name":"Anxious Voice","text":"She saved all of us! With her motherly caress, she takes away our pain!"},{"t":"line","name":"Anxious Voice","text":"Hierda!"},{"t":"line","name":"Pious Voice","text":"Hierda."},{"t":"line","name":"Many Voices","text":"Hierda!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Infected Miner","text":"Hierda... Hierda."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"Hierda","text":"Yes, that is my name."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Infected Miner","text":"What do you look like? I can't see you clearly, or any of the others..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#1$1"}},{"t":"line","name":"Hierda","text":"Your head is wounded. Did you fall and hurt yourself?"},{"t":"line","name":"Hierda","text":"Maybe a mild brain hemorrhage is affecting your vision. Don't worry, we can help you walk..."},{"t":"line","name":"Hierda","text":"Where are you going?"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Infected Miner","text":"I don't know..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"Hierda","text":"Then come with us, for now."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Pious Voice","text":"You're taking us to a place without pain, right?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1719_1#2$1"}},{"t":"line","name":"Hierda","text":"Yes, as long as you're willing to come with me..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"background","a":{"image":"60_g9_seasurface_ex","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Hierda","text":"As long as we believe."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"hidecgitem","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}}]}
