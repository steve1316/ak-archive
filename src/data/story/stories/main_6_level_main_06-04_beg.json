he herd is tough, hold your positions, minimize casualties, don't conserve firepower."},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"You really are a *Lungmen profanity*!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":2}},{"t":"line","name":"Ch'en","text":"I can read your lips!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"(Mouthing the word 'diu')."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"Sir!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#2"}},{"t":"line","name":"Ch'en","text":"I can't hear you!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#2","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"SIR!"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":15,"ystrength":10,"vibrato":30,"randomness":90,"fadeout":true}},{"t":"line","name":"Herd","text":"(Din of roaring)."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#2","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"Speak up!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#2","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"SIR!!!"},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"L. G. D. Defender","text":"Use the bunker-busters! Hurry!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"c