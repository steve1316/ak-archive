{"id":"main_6_level_main_06-04_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_uptown_2","width":1,"height":1,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_bat_indust_loop","key":"Sound_Beta_2/Music/beta1_180603/m_bat_indust_loop","volume":0.8,"crossfade":3}},{"t":"line","name":"L. G. D. Officer","text":"Hurry! Get back! The Infected have turned into monsters!"},{"t":"line","name":"L. G. D. Officer","text":"Agh! I've been bit! I've been bit!"},{"t":"line","name":"Herd","text":"Ung."},{"t":"line","name":"Herd","text":"Aaaahh!"},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Herd","text":"(Terrifying screaming)."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_017_homura_3#5"}},{"t":"line","name":"Blaze","text":"......"},{"t":"line","name":"Blaze","text":"How could this happen...?"},{"t":"cmd","c":"character","a":{"name":"char_017_homura_3#6"}},{"t":"line","name":"Blaze","text":"What has that nasty little boy done?!"},{"t":"line","name":"Blaze","text":"Doctor, we need to move! We have to meet up with Amiya!"},{"t":"line","name":"Blaze","text":"A small fire team can't handle a herd of this size. We have to tread carefully!"},{"t":"line","name":"Blaze","text":"There's nothing we can do for the L. G. D. now. We're in a much worse position than them."},{"t":"line","name":"Blaze","text":"Set them aside. My top priority is to guarantee your safety."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_outcity_1"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"We're being overrun!"},{"t":"line","name":"L. G. D. Officer","text":"We're dead if we don't retreat!"},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"???","text":"Don't panic."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"Huh?! Who's...?"},{"t":"line","name":"L. G. D. Officer","text":"That uniform... You're..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"name":"avg_npc_041","fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"???","text":"The cavalry is here. Stand firm."},{"t":"line","name":"???","text":"Form two teams and move on their flanks."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"But, Master..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_041"}},{"t":"line","name":"???","text":"Trust me. While I cannot take action myself, this method will succeed."},{"t":"line","name":"???","text":"Execute a pincer attack, hold the enemy in place, and leave the stragglers to your reinforcements."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_indoor_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Herd","text":"Nnng... Ngaaaa!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"...Thank you, sir!"},{"t":"line","name":"L. G. D. Officer","text":"If you hadn't come to help..."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_040","fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"???","text":"......"},{"t":"cmd","c":"character","a":{"name":"avg_npc_040"}},{"t":"line","name":"???","text":"Behind you."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"C- counterattack!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_040"}},{"t":"line","name":"???","text":"It is no use."},{"t":"line","name":"???","text":"Form up. And fall back."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_040","focus":1}},{"t":"line","name":"L. G. D. Officer","text":"Yes, sir!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg"}},{"t":"line","name":"L. G. D. Officer","text":"No, if we do that..."},{"t":"line","name":"L. G. D. Officer","text":"We can't hold here. We have to find a way out..."},{"t":"line","name":"L. G. D. Officer","text":"Of course! The high ground! We move up the stairs and attack down into the corridor!"},{"t":"line","name":"L. G. D. Officer","text":"...No. All we can do is hold. But at least we won't get cornered by this crowd of lunatics!"},{"t":"line","name":"L. G. D. Officer","text":"Right. Come about, gather up at each doorway, pull back the teams, and take a defensive formation! Hurry! Move!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_040"}},{"t":"line","name":"???","text":"Well done. I approve."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_040","focus":1}},{"t":"line","name":"L. G. D. Officer","text":"Sir, come with us!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_040","focus":2}},{"t":"line","name":"???","text":"No need."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_040","focus":1}},{"t":"line","name":"L. G. D. Officer","text":"What?"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_040","focus":2}},{"t":"line","name":"???","text":"Go."},{"t":"line","name":"???","text":"I will move on the ground."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_outcity_1"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_039_1"}},{"t":"line","name":"???","text":"......"},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"L. G. D. Officer","text":"We can't hold them!"},{"t":"line","name":"L. G. D. Officer","text":"All we have is piercing weapons, and they're useless against these things!"},{"t":"line","name":"L. G. D. Captain","text":"Hold your ground!"},{"t":"line","name":"L. G. D. Captain","text":"We're the last line of defense for the civilians behind us!"},{"t":"line","name":"L. G. D. Officer","text":"Then what do we do?!"},{"t":"line","name":"L. G. D. Captain","text":"We fight to the last man!"},{"t":"line","name":"L. G. D. Captain","text":"Watch the Originium they're throwing. It corrodes your equipment, and some of them explode!"},{"t":"line","name":"L. G. D. Officer","text":"Ah...! They hit Ah Chung!"},{"t":"line","name":"L. G. D. Captain","text":"Ah Chung, get back! You, move up! Don't let them through!"},{"t":"line","name":"Herd","text":"Guuhhh."},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"L. G. D. Officer","text":"Aaaaaagh! Th- they got me! They're eating me! Noo! Aaaaieeeee!!!"},{"t":"line","name":"L. G. D. Captain","text":"Ah Yee!!!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_039_1"}},{"t":"line","name":"???","text":"How embarrassing!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_039_1"}},{"t":"line","name":"???","text":"Zongguan Bailei Zhengfa, loose!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.25,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.05,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.06,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.05,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_elecball_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Herd","text":"Nnng...!!"},{"t":"line","name":"L. G. D. Captain","text":"Lightning Arts?!"},{"t":"line","name":"L. G. D. Captain","text":"H- how... you wiped them all out in one bright flash?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_039_1#1"}},{"t":"line","name":"???","text":"*Pant...* *pant...*"},{"t":"line","name":"???","text":"I just said I would not act. Little did I know how incapable you are of protecting the masses."},{"t":"line","name":"???","text":"That I would be forced to take such action, it's humiliating!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"Madam Censor..."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"Madam nothing! Were you not told to ignore my presence?"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"...We never thought..."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"I found your spirit laudable. How disappointing it was to see you hopping about aimlessly, leaving me to do your work. Honestly, what were you doing?"},{"t":"line","name":"Censor","text":"Now! To your place!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"But you just said..."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"Chop chop! How have you not learned to move with haste even after witnessing me?"},{"t":"line","name":"Censor","text":"Oh, but of course. You did not witness me. I did nothing. Is that clear?"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"Crystal!"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"But if a single hair on the head of a single commoner comes to harm, you are all terminated. Even I must resign. We are all unemployed."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"Y- yes, of course... We'll fight with all our strength."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"Very good. Now why are you just standing there? Move!"},{"t":"line","name":"Censor","text":"By the way...? Do you know those Black Cloaks?"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"Black Cloak? What's that?"},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":2}},{"t":"line","name":"Censor","text":"Get your eyes checked! Those people on the rooftops, wearing the billowing black cloaks."},{"t":"cmd","c":"character","a":{"name":"char_015_lmg","name2":"avg_npc_039_1","focus":1}},{"t":"line","name":"L. G. D. Captain","text":"Apologies, Madam. What are you talking about?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"background","a":{"screenadapt":"coverall","image":"bg_outcity_1","width":1,"height":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness02_loop","key":"Sound_Beta_2/Music/beta1_180603/m_dia_darkness02_loop","volume":0.8,"crossfade":1.5,"delay":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.5}},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6"}},{"t":"line","name":"Swire","text":"Defenders, fan out!"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#2"}},{"t":"line","name":"Ch'en","text":"Recon team, fall back! Hold firing position!"},{"t":"line","name":"Ch'en","text":"Are these Infected mutants messing with the radio waves? Our scouts could be in trouble."},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"We can't hold them...! There's so many! Didn't you cut through a whole wave of these things back there? Why haven't you done that already?!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":2}},{"t":"line","name":"Ch'en","text":"This is different!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"Hah. Leave it to this puk gaai Lung to be so useless right when we need her most!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":2}},{"t":"line","name":"Ch'en","text":"Then why don't you show us what you can do!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"Drone!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#5","name2":"char_010_chen_1#4","focus":2}},{"t":"line","name":"Ch'en","text":"Huh."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_atk/e_atk_arrow_h"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":15,"ystrength":10,"vibrato":30,"randomness":90,"fadeout":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_atk/e_atk_arrow_h"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":15,"ystrength":10,"vibrato":30,"randomness":90,"fadeout":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":8,"ystrength":6,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6"}},{"t":"line","name":"Swire","text":"SUPERINTENDENT CH'EN SAYS: RECON TEAM! FALL BACK! HOLD FIRING POSITION!"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#2","focus":1}},{"t":"line","name":"Swire","text":"How was that?"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#4","focus":2}},{"t":"line","name":"Ch'en","text":"Huh?"},{"t":"cmd","c":"character","a":{"name":"char_308_swire_1#6","name2":"char_010_chen_1#4","focus":1}},{"t