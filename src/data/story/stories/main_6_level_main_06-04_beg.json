ar_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"One more thing. I... I'm not sure how accurate the reports are."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"Out with it."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"Some units have reported sightings of individuals wearing black raincoats."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"Reunion?"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"Thankfully no. We've seen evidence of them clashing with Reunion. And..."},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"And what?"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#1","name2":"char_015_lmg","focus":2}},{"t":"line","name":"L. G. D. Officer","text":"And... the Reunion they clashed with all seem to have died in, how can I describe it...?"},{"t":"cmd","c":"character","a":{"name":"char_010_chen_1#4","name2":"char_015_lmg","focus":1}},{"t":"line","name":"Ch'en","text":"Sounds like an urban legend. You've got shadowy figures running around Lungmen in black raincoats on a bright, sunny day? Somebody needs help..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Ch'en","text":"......"},{"t":"line","name":"Ch'en","text":"Black raincoats?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_367_swllow_1#4"}},{"t":"line","name":"GreyThroat","text":"......"},{"t":"line","name":"GreyThroat","text":"What is... that?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_038","fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"???","text":"......"},{"t":"line","name":"???","text":"Sector 12 cleansed. Purged of Infected."},{"t":"line","name":"???","text":"Teams 3 and 4 operating."},{"t":"line","name":"???","text":"Moving to next sector."},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Herd","text":"Guh... Ugh..."},{"t":"line","name":"Herd","text":"(Strange crying)."},{"t":"line","name":"Reunion Member","text":"W- why! Why are you hurting your people? Snap out of it!"},{"t":"line","name":"Reunion Member","text":"N- no! Run! Hurry!"},{"t":"line","name":"Reunion Member","text":"Get out of here! Don't let them get you! Run!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_038"}},{"t":"line","name":"???","text":"Additional target acquired."},{"t":"line","name":"???","text":"Infected fugitive group on the border of Sectors 13 and 6. 44 individuals."},{"t":"line","name":"???","text":"Completion estimate: within five minutes."},{"t":"line","name":"???","text":"Operation commencing."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.5}},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Reunion Member","text":"Agh! H- help!"},{"t":"line","name":"Reunion Member","text":"We surrender! We——"},{"t":"cmd","c":"character","a":{"name":"char_367_swllow_1#4"}},{"t":"line","name":"GreyThroat","text":"......"},{"t":"line","name":"GreyThroat","text":"............"},{"t":"cmd","c":"character","a":{"name":"char_367_swllow_1#3"}},{"t":"line","name":"GreyThroat","text":"Um... N- no..."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}}]}
