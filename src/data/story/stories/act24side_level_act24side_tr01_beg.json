{"id":"act24side_level_act24side_tr01_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_forest","xscale":0.9,"yscale":0.9,"x":0,"y":-20}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/a001/m_dia_path_intro","key":"Sound_Beta_2/Music/a001/m_dia_path_loop","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_leaveshake","volume":0.7}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Yato","text":"Left."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"jump","xpos":-40,"times":1,"power":2,"fadetime":2,"isblock":true}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","focus":-1}},{"t":"line","name":"Noir Corne","text":"That good?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"line","name":"Yato","text":"A little further right."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"jump","xpos":40,"times":1,"power":2,"fadetime":2,"isblock":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_leaveshake","volume":0.7}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Yato","text":"Still no good... Stand on your toes."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Yato","text":"A little higher, Corne."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.8}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement"}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","ypos":30,"fadetime":2.5,"isblock":true}},{"t":"line","name":"Yato","text":"That's it. Hold it there."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","focus":-1}},{"t":"line","name":"Noir Corne","text":"Uh, okay..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":1,"ystrength":1,"vibrato":5,"randomness":10,"fadeout":false,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"line","name":"Yato","text":"Keep your shoulders steady."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","focus":-1}},{"t":"line","name":"Noir Corne","text":"I'm trying..."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"line","name":"Yato","text":"Almost there. Just a little longer."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","focus":-1}},{"t":"line","name":"Noir Corne","text":"Okay..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_cloakmovement"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"line","name":"Yato","text":"Done. You can put me down now."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":5,"ystrength":5,"vibrato":20,"randomness":30,"fadeout":true,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","ypos":-15,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"fadetime":0.8}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement"}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"background","a":{"image":"bg_forest","screenadapt":"showall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":1}},{"t":"line","name":"Noir Corne","text":"(Panting)"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":2}},{"t":"line","name":"Yato","text":"Got some good samples this time."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":1}},{"t":"line","name":"Noir Corne","text":"I have a suggestion, Yato."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":2}},{"t":"line","name":"Yato","text":"Go ahead."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Maybe—"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Tweezers."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement"}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":20,"fadetime":1,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-25,"fadetime":1,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Here. Anyway—"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Sealing tape."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement"}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":20,"fadetime":1,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-25,"fadetime":1,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Here. Um—"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Not that one, the blue one. Watch the category."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Okay..."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#4$1","focus":2}},{"t":"line","name":"Yato","text":"So, what was it you wanted to say?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#4$1","focus":1}},{"t":"line","name":"Noir Corne","text":"I was just thinking, maybe we could request a ladder the next time we go on a field mission?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Denied. Carrying too much weight reduces mobility, making it harder to deal with unexpected situations."},{"t":"line","name":"Yato","text":"Check this sample too. Let's hope we find something this time."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Mhm."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#4$1","focus":2}},{"t":"line","name":"Yato","text":"What would you need a ladder for anyway?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#4$1","focus":1}},{"t":"line","name":"Noir Corne","text":"...Forget it."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_keyboard"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"background","a":{"image":"bg_forest","screenadapt":"showall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#4$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Initial tests reveal no active Originium particles, just like before."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Still nothing... How many samples have we collected?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Air, soil, organisms, surfaces... 23 samples from 17 locations in total."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"And we found nothing in any of them?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Nope."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Strange."},{"t":"line","name":"Yato","text":"Maybe the rain from a couple of days ago affected the detection of active Originium particles."},{"t":"line","name":"Yato","text":"Did you notice anything unusual along the way?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":1}},{"t":"line","name":"Noir Corne","text":"What about those broken and charred trees?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#5$1","focus":2}},{"t":"line","name":"Yato","text":"Probably struck by lightning in the storm... If that could be called unusual, then we'd be dealing with a fire-breathing monster on a rampage."},{"t":"line","name":"Yato","text":"I don't want to call this a waste of time, but it is seeming like gathering more samples wouldn't be the most efficient way to go about this."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":2}},{"t":"line","name":"Yato","text":"Let's change our methodology. What do you think about interviewing the local Infected directly?"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":1}},{"t":"line","name":"Noir Corne","text":"Tracing their movements could really help in determining the source of the Originium. But there's something we should keep in mind."},{"t":"line","name":"Noir Corne","text":"The hilly terrain limits the contact that these villages have with the outside. The locals may not be very cooperative."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":2}},{"t":"line","name":"Yato","text":"I'll persuade them."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":1}},{"t":"line","name":"Noir Corne","text":"The most recent suspected case came from Roka Village, at the bottom of this hill. Let's head there first."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_paper2"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Noir Corne","text":"Oh, huh. They reported the case directly to Rhodes Island and requested medical aid? That's rare."},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1","name2":"avg_502_Yato_1#1$1","focus":2}},{"t":"line","name":"Yato","text":"Pay attention on the way down. There might be something we missed."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2.5}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_transmissionget","volume":0.6}},{"t":"line","name":"Yato","text":"(Presses the recording button)"},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"line","name":"Yato","text":"Captain's audio log number one."},{"t":"line","name":"Yato","text":"0737 hours, sunny, northern Soubo mountain range, Higashi."},{"t":"line","name":"Yato","text":"This is Yato, captain of Rhodes Island Operations Team A4, responding to Oripathy cases in the region along with Operator Noir Corne."},{"t":"line","name":"Yato","text":"There have recently been multiple cases suspected to be infection by Oripathy. We believe there to have been an abnormal spread of airborne Originium particles. We have not eliminated the possibility that this phenomenon is manmade."},{"t":"line","name":"Yato","text":"We are currently on the outskirts of the forests of Soubo. We have completed a preliminary survey of the local environment and collected some samples, but have yet to find anything unusua—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Noir Corne","text":"Yato! Over here! I found something!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"line","name":"Yato","text":"Pausing."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"What is it? Er... is this what you found?"},{"t":"line","name":"Yato","text":"Some bugs under a pile of dried leaves?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Waterfly larvae."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"And?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Uh... it seemed strange when I first saw them, but now I've forgotten why."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Well, bring it up again when you remember... We have yet to find anything unusual and are continuing our investigation. End audio log."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Oh, I remember now!"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"What is it?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"I asked Mint to recommend me a few books because the Doctor said I should read more. One of them was 'The Originium Slug's Guide to Terran Wildlife,' which was fun because it had a lot of pictures in it."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Get to the point."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"It talked about the habitats of waterflies. Did you know that they always lay their eggs in puddles?"},{"t":"line","name":"Noir Corne","text":"The larvae grow up in the puddles, and fly away when they're adults."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"You mean...?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Nothing but leaves here. No puddles."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Can waterfly larvae survive in damp environments?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"The book didn't say."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Wait... there are bushes around here, but pretty evenly distributed."},{"t":"line","name":"Yato","text":"So why are there so many leaves in this particular area?"},{"t":"line","name":"Yato","text":"We should dig them up."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Hey, why are you looking at me? I don't have a shovel.","append":true},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1"}},{"t":"line","name":"Yato","text":"......"},{"t":"cmd","c":"character","a":{"name":"char_500_noirc_1"}},{"t":"line","name":"Noir Corne","text":"......"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#2$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Fine, I'll do it."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_shovel","volume":0.7}},{"t":"cmd","c":"delay","a":{"time":2.5}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"This is..."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Whoa, it's huge."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Did that book mention anything about this, Corne?","spans":[{"text":"Did that book mention anything about "},{"text":"this","i":true},{"text":", Corne?"}]},{"t":"line","name":"Yato","text":"Do fowlbeasts grow this big in the mountains of Higashi?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"I don't remember."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"These claw marks are massive... similar to a fowlbeast's talons in shape, but nearly the same length as my sword, leaving deep indentations in the ground."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"A creature that can leave marks like these must be the size of a house."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Ceobe would be over the moons... One of these could feed her for days."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"One of these could feed on us.","spans":[{"text":"One of these could feed on "},{"text":"us","i":true},{"text":"."}],"append":true},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Hm?","append":true},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Corne, test tube."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Here. Don't forget your safety protocols."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement"}},{"t":"line","name":"Yato","text":"(Collects a sample from the scratches)"},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"There, run a test."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1"}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","ypos":-10,"fadetime":0.5,"isblock":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_keyboard"}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Yato..."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"You got something?"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#4$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Active Originium particles detected."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"So that's what it was."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_empty"}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":-200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":200,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"name":"avg_npc_751_1#1$1","blackstart":0.2,"blackend":0.9,"fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":1.3}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":300,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_loop","volume":0.6}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"jump","time":2,"power":20,"fadetime":0.3,"block":false}},{"t":"line","name":"Noir Corne","text":"What the—?!"},{"t":"line","name":"Noir Corne","text":"Yato..."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"A massive creature... No records of similar claw marks, nor eyewitness reports from the surrounding areas. Did it just appear out of nowhere?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_751_1#1$1","blackstart":0.2,"blackend":0.9}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_otomo000_vo_type01_pitch0_alt_talk_message_menu_alt01"}},{"t":"line","name":"Strange Yellow Creature","text":"Mrow!"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Yato, there's a F—*cough*"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"No, we can't assume it was an animal. What would a fowlbeast that large even look like?"},{"t":"line","name":"Yato","text":"And where did the Originium particles come from?"},{"t":"line","name":"Yato","text":"Could it be... those leaves were...?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_751_1#1$1","blackstart":0.2,"blackend":0.9}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_otomo000_vo_type01_pitch0_damage_max_alt01"}},{"t":"line","name":"Strange Yellow Creature","text":"Mrow!"},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"Stop making those noises, Corne."},{"t":"line","name":"Yato","text":"We need to record the scratches. Bring the equipment."},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":2}},{"t":"line","name":"Noir Corne","text":"Yato..."},{"t":"line","name":"Noir Corne","text":"That wasn't me..."},{"t":"cmd","c":"stopmusic","a":{"fadetime":0.5}},{"t":"cmd","c":"character","a":{"name":"avg_502_Yato_1#5$1","name2":"char_500_noirc_1","focus":1}},{"t":"line","name":"Yato","text":"What do you—","