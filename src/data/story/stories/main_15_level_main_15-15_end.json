Island..."},{"t":"line","name":null,"text":"And keep going."},{"t":"line","name":null,"text":"{@nickname}."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"sn","fadetime":2}},{"t":"cmd","c":"musicvolume","a":{"volume":0.2,"fadetime":3}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act1mainss/m_sys_act1mainss_intro","key":"Sound_Beta_2/Music/act1mainss/m_sys_act1mainss_loop","volume":0}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":4}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"subtitle","a":{"text":"Unconsciously, I seem to have grown accustomed to having someone at my side, guiding me.","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Until now. I finally am sure of what I want to do.","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"No matter what happens, I will continue down this path. I will not abandon hope.","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But...","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"...What about you?","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","amount":0,"keep":true}},{"t":"cmd","c":"background","a":{"image":"60_g13_rhodesdeck_origin","screenadapt":"coverall"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_humanchange","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1037_amiya3_1#5$3"}},{"t":"cmd","c":"block