"With strength, comes fragility."},{"t":"line","name":null,"text":"A long life ends here."},{"t":"line","name":null,"text":"She has kept her promise."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":4}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":4,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{}}]}
