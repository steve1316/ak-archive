n."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_chimera","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_fireharm","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_fireharm","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_fireharm","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_explo_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"Black Arts and lasers take turns shooting at the gigantic and complex crystal cluster. The fierce assault even manages to suppress the Originium from spreading further."},{"t":"line","name":null,"text":"Until the light of Arts swallow Priestess's figure."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":false}},{"t":"cmd","c":"effect","a":{"name":"AVG_53_fengsha_02","layer":3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_sand_lp","volume":1,"loop":true,"channel":"sa"}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"background","a":{"image":"60_g13_rhodesdeck_origin","screenadapt":"coverall"}},{"t":"cmd","c":"stopsound","a":{"channel":"sa","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":null,"text":"Smoke and dust scatter, leaving only Originium fragments on the ground."},{"t":"line","name":null,"text":"And a tattered white coat."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["Did we... defeat her?"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#3$1"}},{"t":"line","name":"Kal'tsit","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1037_amiya3_1#1$3"}},{"t":"line","name":"Amiya","text":"I can't feel... any signs of life, or any emotions..."},{"t":"line","name":"Amiya","text":"Maybe..."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Everything happens so suddenly you haven't had the time to regard the series of events as reality."},{"t":"line","name":null,"text":"You saw that fearsome foe reduced to ashes right before your eyes."},{"t":"line","name":null,"text":"Yet you feel no relief at all."},{"t":"line","name":"???","text":"Are we quite finished playing yet?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act1mainss/m_act1mainss_bat1_intro","key":"Sound_Beta_2/Music/act1mainss/m_act1mainss_bat1_loop","volume":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_drkcludsthdr","volume":0,"loop":true,"channel":"d"}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"d","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1718_1#1$1","duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"decision","options":["What's that?!"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1037_amiya3_1#5$3"}},{"t":"line","name":"Amiya","text":"How—"},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#7$1"}},{"t":"line","name":"Kal'tsit","text":"Doctor, Amiya, fall back!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1718_1#1$1"}},{"t":"line","name":"Priestess","text":"A powerful show of resistance, AMa-10. Your plan has proven effective."},{"t":"line","name":"Priestess","text":"As you say, there is indeed a chance for you to kill me now..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1718_1#10$1"}},{"t":"line","name":"Priestess","text":"But how does a single substitute made of Originium fluster you so?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1"}},{"t":"line","name":"Kal'tsit","text":"...!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1718_1#10$1"}},{"t":"line","name":"Priestess","text":"AMa-10, I have no intention of debating the value of your beliefs."},{"t":"line","name":"Priestess","text":"The principles you have always insisted on are so insignificant I can't even find a credible logical framework to assess their significance."},{"t":"line","name":"Priestess","text":"It is not uncommon for experiments to turn out like this—small errors ultimately growing into huge obstacles. I have no choice but to accept this result."},{"t":"line","name":"Priestess","text":"I'm very sorry, but I must treat you as an error, and wipe you out."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_crystalrise","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","volume":0.4,"loop":true,"channel":"e"}},{"t":"cmd","c":"camerashake","a":{"duration":4,"xstrength":10,"ystrength":10,"vibrato":90,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"stopsound","a":{"channel":"e","fadetime":6}},{"t":"cmd","c":"delay","a":{"time":4}},{"t":"line","name":null,"text":"Priestess raises her hand."},{"t":"line","name":null,"text":"Originium begins to grow once more. Thorned crystal branches tightly envelop you and Amiya in a second, nearly swallowing you both."},{"t":"line","name":null,"text":"Amiya tries her best to shatter the surrounding Originium with her Arts, but the crystal clusters only grow faster."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1037_amiya3_1#4$3"}},{"t":"line","name":"Amiya","text":"Doctor! Get behind me—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#4$1"}},{"t":"line","name":"Kal'tsit","text":"—!"},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#7$1"}},{"t":"line","name":"Kal'tsit","text":"Mon3tr—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"effect","a":{"name":"AVG_amiya_attack_01","layer":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_chimera","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.8,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.8,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.8,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.4,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_explo_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"It all happens in a flash of light."},{"t":"line","name":null,"text":"You see the Originium crystal cluster near you explode. Amiya wanted to protect you, but time does not allow for her reaction."},{"t":"line","name":null,"text":"You see the black monster rush over, blocking you both from the cluster with its large, solid body."},{"t":"line","name":null,"text":"You see Kal'tsit..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1718_1#8$1"}},{"t":"line","name":"Priestess","text":"What a pity."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"d","fadetime":1}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"charslot","a":{"duration":1.5}},{"t":"cmd","c":"camerashake","a":{"duration":6,"xstrength":5,"ystrength":5,"vibrato":90,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_scrystalroad","volume":1,"loop":true,"channel":"sc"}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"stopsound","a":{"channel":"sc","fadetime":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phntsmbrek","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phntsmglsbrek","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.1,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd",