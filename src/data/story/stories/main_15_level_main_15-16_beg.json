a":{"key":"Sound_Beta_2/AVG/d_gen_transmissionget","volume":1}},{"t":"decision","options":["—Bzzt—Abandon ship, repeat, abandon ship."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["Back up all data—Bzzt—"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1723_1#6$1"}},{"t":"line","name":"Closure","text":"I'm working on it! Give me some time!"},{"t":"line","name":"Closure","text":"More importantly, once PRTS is shut down, its core data must be downloaded—"},{"t":"line","name":"Closure","text":"Kal'tsit has set up a backdoor."},{"t":"line","name":"Closure","text":"It will be the key to eliminating the threat, once and for all."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Mantra","text":"Mechanist acknowledges."},{"t":"line","name":"Mantra","text":"We are moving through the Abyss."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1723_1#6$1"}},{"t":"line","name":"Closure","text":"Counting on you!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1723_1#11$1"}},{"t":"line","name":"Closure","text":"Is Kal'tsit hurt, Doctor?"},{"t":"line","name":"Closure","text":"Why am I not hearing from her?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"decision","options":["......","She's buying time for us."],"values":["1","2"]},{"t":"predicate","refs":["1","2"]},{"t":"decision","options":["Amiya and I will fight to the bitter end."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["Rhodes Island..."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["Is in your hands."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_transmission","volume":1}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"background","a":{"image":"60_g15_rhodesabyss_off","screenadapt":"coverall"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_energywell","volume":0,"loop":true,"channel":"en"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.8,"channel":"en","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_footsteps_flock","volume":1,"loop":true,"channel":"f"}},{"t":"cmd","c":"stopsound","a":{"channel":"f","fadetime":4}},{"t":"cmd","c":"animtext","a":{"id":"at1","name":"group_location_stamp","style":"avg_both","pos":"-400,-200","block":false}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"animtextclean","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1730_1#3$1"}},{"t":"line","name":"Raidian","text":"We have restored communications with the Doctor."},{"t":"line","name":"Raidian","text":"We stick to the plan."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_391_rosmon_1#1$2"}},{"t":"line","name":"Rosmontis","text":"I'm not detecting any more enemies."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1730_1#2$1"}},{"t":"line","name":"Raidian","text":"Nor any new data transmission from the PRTS core."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4133_logos_1#7$1"}},{"t":"line","name":"Logos","text":"It's too quiet."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4132_ascln_1#1$1"}},{"t":"line","name":"Ascalon","text":"Location of the core, Raidian?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_transmission","volume":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1730_1#3$1"}},{"t":"line","name":"Raidian","text":"Here you go."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4132_ascln_1#1$1"}},{"t":"line","name":"Ascalon","text":"Continue to push towards the core and attempt to deactivate it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#11$2"}},{"t":"line","name":"Blaze","text":"I'll take point! PRTS will definitely come up with new waves of enemies to meet us."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_521_1#1$1"}},{"t":"line","name":"Mechanist","text":"I'll take charge of analyzing the core."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4133_logos_1#3$1"}},{"t":"line","name":"Logos","text":"'Aurora.'"},{"t":"line","name":"Logos","text":"This little light will guide our way—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_magic_2","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"line","name":"Logos","text":"—?"},{"t":"line","name":"Mechanist","text":"What is it, Logos?"},{"t":"line","name":"Logos","text":"This is not my light..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta3_181101/m_sys_lab_intro","key":"Sound_Beta_2/Music/beta3_181101/m_sys_lab_loop","volume":0.6}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_60_i16","style":"cg","sfrom":1,"sto":1.5,"sduration":0.01,"pfrom":"0,0","pto":"-55,-300","pduration":0.01,"rfrom":-11,"rto":-11,"rduration":0.1,"afrom":0,"ato":1,"aduration":0.5,"layer":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":null,"text":"A rhombus-shaped halo hangs in the darkness, swaying gently."},{"t":"line","name":null,"text":"It is like a cold eye, gazing upon all present."},{"t":"line","name":"Ascalon","text":"Alert..."},{"t":"line","name":"Blaze","text":"Is this the 'Priestess' that Dr. Kal'tsit was talking about?"},{"t":"line","name":"Raidian","text":"I don't think so."},{"t":"line","name":"Raidian","text":"I just detected a large amount of haphazard but familiar signals."},{"t":"line","name":"Raidian","text":"They come from Rhodes Island itself."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"en","fadetime":4}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_60_i16","style":"cg","sfrom":1.5,"sto":1.2,"sduration":4,"pfrom":"-55,-300","pto":"-70,-45","pduration":4,"rfrom":-11,"rto":0,"rduration":4,"layer":1}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_systemstart_weird","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_60_i16","style":"cg","sfrom":1.2,"sto":1,"sduration":22,"pfrom":"-70,-45","pto":"-55,0","pduration":22,"layer":1}},{"t":"cmd","c":"image","a":{"image":"60_i16","screenadapt":"coverall","xscale":1.2,"yscale":1.2,"y":-50,"fadetime":0.5}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.2,"yscalefrom":1.2,"xscaleto":1,"yscaleto":1,"yfrom":-50,"yto":0,"duration":20,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Misery","text":"What... is this?"},{"t":"line","name":null,"text":"A massive machine emerges in the endless white noise—"},{"t":"line","name":null,"text":"All present are familiar with the components that make up its frame."},{"t":"line","name":null,"text":"Closure has often showed off the parts that she used to modify Rhodes Island's modules. Some of them were made by the elite operators themselves."},{"t":"line","name":"Touch","text":"PRTS has repurposed and weaponized Rhodes Island's facilities."},{"t":"line","name":"Touch","text":"But where did they come from? They weren't supposed to be in the Abyss..."},{"t":"line","name":"Ascalon","text":"Originium."},{"t":"line","name":null,"text":"Originium shards scatter irregularly across the unusual machine."},{"t":"line","name":null,"text":"No longer do they simply consume; now, they are creating."},{"t":"line","name":"Misery","text":"Are you telling me Originium can recreate the stuff that's on Rhodes Island?"},{"t":"line","name":null,"text":"Logos is reminded of the tower in the Assimilated Universe, and of 'her'."},{"t":"line","name":"Logos","text":"It's not that simple."},{"t":"line","name":"Logos","text":"PRTS does not have the capability to decode Originium data. Someone else is intervening."},{"t":"line","name":"Ascalon","text":"Priestess."},{"t":"line","name":"Raidian","text":"Its data is connected to the core of PRTS in a way that I can't understand. These things are different from the Originium entities that we faced!"},{"t":"line","name":"Blaze","text":"Looks like we're in for a fight."},{"t":"line","name":"Stormeye","text":"I see no other way."},{"t":"line","name":"Stormeye","text":"Ready?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_attack_ready","volume":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Rosmontis","text":"Ready."},{"t":"line","name":null,"text":"The rhombus-shaped eye glows even brighter."},{"t":"line","name":null,"text":"Controlled by PRTS, the mimic machine charges up."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_energygather","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"sticker","a":{"id":"st1","multi":true,"text":"No target restrictions. Combat style analysis complete.","x":180,"y":170,"alignment":"left","size":24,"delay":0.04,"width":700,"block":true}},{"t":"cmd","c":"sticker","a":{"id":"st1","multi":true,"text":"\n\nNo power restrictions.","block":true}},{"t":"cmd","c":"sticker","a":{"id":"st1","multi":true,"text":"\n\nPRTS final cleanup protocol loaded—","block":true}},{"t":"cmd","c":"sticker","a":{"id":"st1","duration":0.5,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{}}]}
