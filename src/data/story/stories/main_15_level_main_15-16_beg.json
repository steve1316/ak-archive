{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_crystalmagic_loop","volume":1,"loop":true,"channel":"a"}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"sur","fadetime":2}},{"t":"cmd","c":"image","a":{"image":"60_i13_2","screenadapt":"coverall"}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.2,"yscalefrom":1.2,"xscaleto":1,"yscaleto":1,"duration":30,"block":false}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_60_i13_2","style":"cg","sfrom":1.2,"sto":1,"sduration":30,"layer":1}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_60_i13_1","style":"cg","sfrom":1,"sto":1.5,"sduration":30,"layer":2}},{"t":"cmd","c":"camerashake","a":{"duration":1.5,"xstrength":5,"ystrength":5,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phntsmbrek","volume":1,"channel":"1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phntsmglsbrek","volume":1,"channel":"2"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_land_impact","volume":1,"channel":"3"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":2,"block":true}},{"t":"line","name":null,"text":"Pink threads fly out from Amiya's staff, dancing in the space enclosed by Originium."},{"t":"line","name":null,"text":"But you sense that Amiya is facing tremendous pressure."},{"t":"line","name":null,"text":"And Priestess's figure has become completely obstructed by Originium..."},{"t":"line","name":null,"text":"You can see Priestess's eyes in every Originium fragment, every facet."},{"t":"line","name":null,"text":"It is as though..."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["She is everywhere."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":"Amiya","text":"Theresa is teaching me how to cast these new Arts more efficiently, Doctor!"},{"t":"line","name":"Amiya","text":"I think I've weakened Priestess's control over Originium. I should be able to delay her—"},{"t":"cmd","c":"dialog","a":{}},{"t":"line","name":null,"text":"As Amiya's Arts run wild, you hear a reassuring voice in your head."},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"a","fadetime":2}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"sur","fadetime":2}},{"t":"line","name":"Mantra","text":"Doctor, Amiya, we're in the Abyss. The Originium interference was weakened for a moment."},{"t":"line","name":"Amiya","text":"It was..."},{"t":"line","name":"Mantra","text":"Raidian has reestablished communications, but the situation is rough. I can barely use my Arts to help Raidian maintain the link."},{"t":"line","name":"Mantra","text":"Also, she can not detect Dr. Kal'tsit's biosignal."},{"t":"line","name":"Mantra","text":"Where are you? What's the situation?"},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["We're on the deck of Rhodes Island!"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["We're confronting Priestess!"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["Get in touch with Warfarin."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["Evacuate the ship immediately."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"stopsound","a":{"channel":"sur","fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"hidecgitem","a":{"image":"cgitem_60_i13_2"}},{"t":"cmd","c":"hidecgitem","a":{"i