{"id":"act35side_level_act35side_07_end","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"53_g10_grandbazaar_d","screenadapt":"coverall"}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_loop","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_walkfast","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1492_1#1$1","posfrom":"150,0","posto":"-250,0","duration":0.8}},{"t":"cmd","c":"delay","a":{"time":0.2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1,"loop":true,"channel":"r"}},{"t":"cmd","c":"stopsound","a":{"channel":"r","fadetime":0.8}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_4058_pepe_1#8$1","posfrom":"-200,0","posto":"0,0","duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","posfrom":"-250,0","posto":"-200,-20","afrom":1,"ato":0,"duration":0.3,"isblock":true}},{"t":"cmd","c":"charslot","a":{"slot":"l","focus":"n"}},{"t":"line","name":"Anxious Passerby","text":"Hey! Watch where you're going!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_4058_pepe_1#12$1"}},{"t":"line","name":"Pepe","text":"S-Sorry, effendi! I was in a hurry. Are you okay?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1492_1#1$1","posfrom":"0,-30","posto":"0,0","duration":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Anxious Passerby","text":"Well, I supposed nothing's broken."},{"t":"line","name":"Anxious Passerby","text":"Where are you off to in such a hurry? Don't you know there's trouble?"},{"t":"line","name":"Anxious Passerby","text":"First those metal constructs sent all the gems in the city to the Great Bazaar, now they're tearing down houses and chasing us out of the bazaar."},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_4058_pepe_1#8$1","focus":"l"}},{"t":"line","name":"Pepe","text":"The constructs are tearing down houses?"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Anxious Passerby","text":"Yeah! There are flying stones and debris everywhere.","append":true},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"l","posfrom":"0,0","posto":"200,0","afrom":1,"ato":0,"duration":0.5,"isblock":true}},{"t":"line","name":"Anxious Passerby","text":"Hey, why are you still going that way? Didn't you hear what I said?","append":true},{"t":"cmd","c":"charslot","a":{"slot":"l","focus":"n"}},{"t":"line","name":"Pepe","text":"I need to see what's going on!"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Anxious Passerby","text":"What do you think you can do, girl?"},{"t":"line","name":"Anxious Passerby","text":"Hey, girl!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"53_g10_grandbazaar_d","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#2$1","duration":1,"isblock":true}},{"t":"line","name":"Pepe","text":"...No one's here. They've all gone."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#12$1"}},{"t":"line","name":"Pepe","text":"By Horakhet..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_fsmetal","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_fsmetal","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"The streets, usually bustling with people, are now empty, save for constructs moving in pairs or triplets."},{"t":"line","name":null,"text":"They raise their arms, and houses turn into sand."},{"t":"line","name":null,"text":"From the fallen sand, tall pillars and walls emerge."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":3,"xstrength":5,"ystrength":5,"vibrato":20,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_sandstone","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#9$1","posfrom":"100,0","posto":"0,0","duration":0.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#3$1"}},{"t":"line","name":"Pepe","text":"Yikes, that almost hit me."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_meownormal","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Mio","text":"Meow..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#5$1"}},{"t":"line","name":"Pepe","text":"...?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_pawfootstep_3","volume":0.4}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#5$1"}},{"t":"line","name":"Pepe","text":"Who was that...?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_pawfootstep_3","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1482_1#6$1","posfrom":"-200,0","posto":"0,0","duration":1.5,"isblock":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_meowlong","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1482_1#1$1","duration":0.5,"isblock":true}},{"t":"line","name":"Mio","text":"Mrow..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#4$1"}},{"t":"line","name":"Pepe","text":"Huh, where did this critter come from?"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_meownormal","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1482_1#1$1"}},{"t":"line","name":"Mio","text":"Meow!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4058_pepe_1#2$1"}},{"t":"line","name":"Pepe","text":"Go, this is no place for you."},{"t":"line","name":"Pepe","text":"Go! Shoo!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1482_1#1$1"}},{"t":"line","name":"Mio","text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"duration":0.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":null,"text":"The animal is not daunted by her shooing and instead sits down to leisurely lick its own fur."},{"t":"line","name":null,"text":"A suspicious Pepe decides to go around it. As she takes a step, the animal looks up and gazes straight into Pepe's eyes."},{"t":"line","name":null,"text":"In that instant, Pepe feels as though her feet have become nailed to the ground."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"But it is such a small animal."},{"t":"line","name":null,"text":"She gathers the courage to take another step forward."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_jealous_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_jealous_loop","volume":0.6}},{"t":"cmd","c":"camerashake","a":{"duration":0.8,"xstrength":50,"ystrength":50,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_monsterroar","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_tinnitus","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_heartbeat","volume":1,"loop":true,"channel":"h"}},{"t":"line","name":null,"text":"A deafening roar stops her. She feels her eardrums hurt."},{"t":"line","name":null,"text":"She cannot imagine the sound coming from a tiny animal that barely reaches her shins."},{"t":"line","name":null,"text":"She covers her ears and closes her eyes, wincing as the sound wave almost knocks her over."},{"t":"line","name":null,"text":"As her ears stop ringing, she feels a massive shadow descending upon her."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"h","fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{"image":"53_i07","screenadapt":"coverall","xscale":1.1,"yscale":1.1}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.1,"yscalefrom":1.1,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":3,"block":true}},{"t":"line","name":null,"text":"Pepe opens her eyes to see a formidable creature prowling in the middle of the street, faint patterns with a wondrous gleam roving upon its sandy fur."},{"t":"line","name":null,"text":"Transfixed, she meets the beast's gaze and feels as though her very soul is being drawn into those golden eyes."},{"t":"line","name":null,"text":"Her breath and heartbeat seem to fall under its control, ready to cease at its will."},{"t":"line","name":null,"text":"Unable to move a single muscle, she watches helplessly as the beast slowly approaches, its crimson maw parting..."},{"t":"line","name":null,"text":"And swallows her whole."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":50,"ystrength":50,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_monsterroar","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.3,"block":true}},{"t":"line","name":null,"text":"All goes dark."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{"image":"53_g4_ctizengarden","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Dialog/d_avg_phone","volume":1,"loop":true,"channel":"t"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2","duration":1,"isblock":true}},{"t":"cmd","c":"stopsound","a":{"channel":"t","fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Anat","text":"Anat, Acting Curator of Varjavandabad Museum. Yes, we are aware, but unfortunately we do not have the resources..."},{"t":"line","name":"Anat","text":"Our experts are being deployed across the city. We do not currently have the manpower to assess your losses..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#2$2"}},{"t":"line","name":"Anat","text":"Of course we value your sponsorship, but..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Dialog/d_avg_phone","volume":1,"loop":true,"channel":"t"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"stopsound","a":{"channel":"t","fadetime":1}},{"t":"line","name":"Anat","text":"Anat, Acting Curator of Varjavandabad Museum... no, we are unable to offer any comment at this time."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#2$2"}},{"t":"line","name":"Anat","text":"...What? No, the museum is already on lockdown. No collection can leave the building."},{"t":"line","name":"Anat","text":"The museum has nothing to do with the constructs in the city...","append":true},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2"}},{"t":"line","name":"Anat","text":"Hello?","append":true},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phonestop","volume":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#10$2"}},{"t":"line","name":"Anat","text":"*sigh*..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"effect","a":{"name":"AVG_53_fengsha_02","layer":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Dialog/d_avg_phone","volume":1,"loop":true,"channel":"t"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowstormflp","volume":1,"loop":true,"channel":"sn"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_sandwnd","volume":0,"loop":true,"channel":"s"}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"s","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_53_fengsha_01","flip":1,"layer":2}},{"t":"cmd","c":"stopsound","a":{"channel":"t","fadetime":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2"}},{"t":"line","name":"Anat","text":"Anat, Acting Curator of Varjavandabad Museum..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#3$2"}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"shake","afrom":1,"ato":1,"power":3,"times":30,"duration":0.3}},{"t":"line","name":"Anat","text":"*cough* *cough* Sorry, we're getting a lot of sand and dust here."},{"t":"line","name":"Anat","text":"I assure you, on behalf of Varjavandabad Museum that we will offer restoration services at the earliest opportunity..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":0.4,"channel":"sn","fadetime":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"shake","afrom":1,"ato":1,"power":3,"times":30,"duration":0.3}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#2$2"}},{"t":"line","name":"Anat","text":"*cough* *cough* ...Appraisal?"},{"t":"line","name":"Anat","text":"The constructs have built a statue in your garden? And several pillars? May I have a description?"},{"t":"line","name":"Anat","text":"...Yes, the ornaments you described fit the traits of first-century art style. It had gone into decline prior to the founding of Menat-Ha'mait, and many of its techniques are considered lost."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#7$2"}},{"t":"line","name":"Anat","text":"I will send someone as soon as possible."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_phonestop","volume":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#10$2"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2"}},{"t":"line","name":"Anat","text":"Titi, can you go over?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1478_1#1$1"}},{"t":"line","name":"Medjehtiqedti","text":"Do you think it's possible? That the constructs can build, sculpt, and master techniques believed to be long lost?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2"}},{"t":"line","name":"Anat","text":"I don't want to, but..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1478_1#1$1"}},{"t":"line","name":"Medjehtiqedti","text":"Looks like you have a bad feeling about it too."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#1$2"}},{"t":"line","name":"Anat","text":"Which is why we need to see it to believe it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1478_1#6$1"}},{"t":"line","name":"Medjehtiqedti","text":"..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#2$2"}},{"t":"line","name":"Anat","text":"What is it, Titi?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1478_1#6$1"}},{"t":"line","name":"Medjehtiqedti","text":"You said 'see it to believe it', right?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"sn","fadetime":2}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_sand_lp","volume":0,"loop":true,"channel":"sa"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.6,"channel":"sa","fadetime":2}},{"t":"line","name":null,"text":"Carried by the dry winds, sand creeps up like an overflowing river, covering the feet of fleeing passersby."},{"t":"line","name":null,"text":"Grains of sand gather before their eyes and form into shapes, as though poured into invisible molds."},{"t":"line","name":null,"text":"Pillars and walls begin to rise from the streets."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{"image":"53_g4_ctizengarden","x":100,"y":-50,"xscale":1.4,"yscale":1.4,"screenadapt":"coverall"}},{"t":"cmd","c":"backgroundtween","a":{"xfrom":100,"xto":50,"duration":3}},{"t":"cmd","c":"focusout","a":{"type":"bg","id":"53_g4_ctizengarden","from":0,"to":0.6,"duration":3,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_gemprocess","volume":0,"loop":true,"channel":"m"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1}},{"t":"cmd","c":"soundvolume","a":{"volume":0.4,"channel":"m","fadetime":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4139_papyrs_1#6$2","duration":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"zoom","poszoom":"0.5,0.5","scale":1.3,"duration":0}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"50,-100","posto":"0,-100","duration":2.8}},{"t":"cmd","c":"stopsound","a":{"channel":"m","fadetime":4}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"effect","a":{"name":"AVG_53_black_line_01","layer":2,"x":50,"y":250}},{"t":"line","name":"Anat","text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,-100","posto":"-50,-100","duration":2.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","afrom":1,"ato":0,"duration":1.5}},{"t":"cmd","c":"backgroundtween","a":{"xfrom":50,"xto":-25,"duration":4,"block":false}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1478_1#1$1","duration":2}},{"t":"cmd","c":"charslot","a":{"slot":"r","action":"zoom","poszoom":"0.5,0.5","scale":1.3,"duration":0}},{"t":"cmd","c":"charslot","a":{"slot":"r","posfrom":"-100,-100","posto":"-150,-100","duration":2.5}},{"t":"line","name":"Medjehtiqedti","text":"Beast reliefs and patterns imitating Originium circuits, coupled with the worship of sundials and time, representative of the era when Lugalszargus's influence was at its strongest."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Anat","text":"Titi, now's not a good time..."},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1478_1#5$1"}},{"t":"cmd","c":"charslot","a":{"slot":"r","action":"zoom","poszoom":"0.5,0.5","scale":1.3,"duration":0}},{"t":"cmd","c":"charslot","a":{"slot":"r","posfrom":"-100,-100","posto":"-150,-100","duration":0}},{"t":"line","name":"Medjehtiqedti","text":"This might be the 'memory' of the constructs. Can it even be counted as a form of restored artifact?"},{"t":"line","name":"Medjehtiqedti","text":"But we didn't see any constructs nearby—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":9,"xstrength":6,"ystrength":6,"vibrato":30,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_gemprocess","volume":0.4,"loop":true,"channel":"ge"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","volume":1,"loop":true,"channel":"e"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"stopsound","a":{"channel":"sa","fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"sn","fadetime":2}},{"t":"cmd","c":"soundvolume","a":{"volume":0,"channel":"ge","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"focusout","a":{"type":"bg","id":"53_g4_ctizengarden","from":0.6,"to":0,"duration":0.1,"block":false}},{"t":"cmd","c":"curtain","a":{"direction":6,"fillfrom":0.5,"fillto":0.3,"fadetime":0.1}},{"t":"cmd","c":"curtain","a":{"direction":2,"fillfrom":0.5,"fillto":0.3,"fadetime":0.1}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"ge","fadetime":1}},{"t":"cmd","c":"image","a":{"image":"53_i05","screenadapt":"coverall","x":-500,"y":30,"xscale":1.1,"yscale":1.1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act12d0d0/m_sys_dontmaketrouble_intro","key":"Sound_Beta_2/Music/act12d0d0/m_sys_dontmaketrouble_loop","volume":0.6}},{"t":"cmd","c":"imagetween","a":{"xfrom":-450,"xto":-400,"duration":4,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"stopsound","a":{"channel":"e","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"curtain","a":{"direction":6,"fillfrom":0.3,"fillto":0,"fadetime":0.1}},{"t":"cmd","c":"curtain","a":{"direction":2,"fillfrom":0.3,"fillto":0,"fadetime":0.1}},{"t":"cmd","c":"image","a":{"image":"53_i05","screenadapt":"coverall","xscale":1.05,"yscale":1.05}},{"t":"cmd","c":"imagetween","a":{"xfrom":-30,"xto":0,"duration":1,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_1","style":"cg","afrom":0,"ato":1,"aduration":0.5,"layer":3}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_2","style":"cg","pfrom":"0,0","pto":"-260,0","pduration":0.2,"afrom":0,"ato":1,"aduration":0.5,"layer":2}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_3","style":"cg","pfrom":"530,0","pto":"270,0","pduration":0.2,"afrom":0,"ato":1,"aduration":0.5,"layer":1}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"imagetween","a":{"xfrom":0,"xto":30,"duration":30,"block":false}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_2","style":"cg","pfrom":"-260,0","pto":"-300,0","pduration":30,"layer":2}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_3","style":"cg","pfrom":"270,0","pto":"230,0","pduration":30,"layer":1}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"ge","fadetime":2}},{"t":"line","name":"Anat","text":"—Ruuuuun!!"},{"t":"line","name":"Medjehtiqedti","text":"Where did they come from, anyway?"},{"t":"line","name":"Anat","text":"*pant* *pant* Questions later, Titi! You've got to run faster than me, and pull me along!"},{"t":"line","name":"Anat","text":"We... we're done for if we run at my speed!"},{"t":"line","name":"Medjehtiqedti","text":"Don't worry, you're running fast enough. Hang in there, try not to pass out, and let me observe them a little longer..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_statueshake","volume":0.6}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_statuecollapse","volume":0.6}},{"t":"line","name":"Medjehtiqedti","text":"Oh, and don't look back. Probably not good for your heart to see them smashing the curator's favorite murals to pieces."},{"t":"line","name":"Anat","text":"Wh-What?!"},{"t":"line","name":"Anat","text":"The museum that the curator entrusted to me... the padishah's favorite museum... it's all over..."},{"t":"line","name":"Anat","text":"Have mercy on me, Shahanshah! Watch over me, Exalted Lugalszargus!"},{"t":"line","name":"Medjehtiqedti","text":"Watch out—!"},{"t":"line","name":"Anat","text":"Great Horakhet, I pray to you again! Allow your child to see your face again! I-I want to see the sunrise tomorrow! I want to see it shine once more on the museum!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"ge","fadetime":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1","volume":1}},{"t":"cmd","c":"cgitem","a":{"image":"cgitem_53_i05_2","style":"cg","pfrom":"-300,0","pto":"-300,-30","afrom":1,"ato":0,"aduration":0.3,"pduration":0.3,"layer":2}},{"t":"cmd","c":"musicvolume","a":{"volume":0.2,"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.3,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"hidecgitem","a":{"image":"cgitem_53_i05_1"}},{"t":"cmd","c":"hidecgitem","a":{"image":"cgitem_53_i05_2"}},{"t":"cmd","c":"hidecgitem","a":{"image":"cgitem_53_i05_3"}},{"t":"line","name":null,"text":"The babbling Anat trips and falls."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_airshiptakeoff","volume":1,"loop":true,"channel":"a"}},{"t":"line","name":null,"text":"Titi catches her just before her face hits the ground, but the two of them hear a loud noise."},{"t":"line","name":null,"text":"It sounds like a machine turning on."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":2}},{"t":"cmd","c":"background","a":{"image":"35_g17_deserttown_d","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1484_1#5$2","posfrom":"200,0","posto":"0,0","duration":0.8}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1485_1#3$2","posfrom":"200,0","posto":"0,0","duration":0.8}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1485_1#3$2","focus":"r"}},{"t":"line","name":"Ajani","text":"*pant* *pant* Narantuya! We finally found you!"},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1484_1#5$2","focus":"l"}},{"t":"line","name":"Ajazi","text":"We haven't heard from you since you bought us drinks last night! We were so worried!"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"I haven't had a shut-eye in days, so I slept in longer. What's there to worry about?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"Anyway, good timing. Give me a hand."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#10$2"}},{"t":"line","name":"Ajazi","text":"Why are you still helping other people carry stuff?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"Shh, I'm not doing this for anyone else, it's for myself."},{"t":"line","name":"Narantuya","text":"This is obviously an old statue. Better to get something out of it than to just leave it on the streets."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1485_1#8$2"}},{"t":"line","name":"Ajani","text":"But Narantuya... Isn't it made by one of the metal constructs?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#12$1"}},{"t":"line","name":"Narantuya","text":"Huh? What metal constructs?"},{"t":"line","name":"Narantuya","text":"Lay it out for me slowly. I might have slept too soundly last night and missed some headlines."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#10$2"}},{"t":"line","name":"Ajazi","text":"I thought you were the sharp one, Narantuya. How could you have missed it? There are weird metal constructs all over the street. Didn't they come at you?"},{"t":"line","name":"Ajazi","text":"They're tearing houses apart, making walls and pillars out of sand... and grabbing gems. Maybe you should check?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#2$2"}},{"t":"line","name":"Ajazi","text":"Everyone lost something last night, from onyx necklaces on their necks to astrolabes that simulate the moons and stars."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"Is that what happened to your hairpin?"},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#9$2"}},{"t":"line","name":"Ajazi","text":"Wha... where did my hairpin go?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"You got one thing right, I'm sharper than you."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#4$1"}},{"t":"line","name":"Narantuya","text":"And I'm starting to feel that something is off."},{"t":"line","name":"Narantuya","text":"Anyway, now that I have the intel, time to come up with a plan."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"Take off any gems you're wearing and hide them. If those metal constructs are robbers, let them come for me first."},{"t":"line","name":"Narantuya","text":"Join the fleeing crowds and get your smoke bombs ready."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1485_1#8$2"}},{"t":"line","name":"Ajani","text":"But where do we go?"},{"t":"line","name":"Ajani","text":"Everyone else can hide in their homes or at least stay in hotels behind locked doors. Are... we going back to the sewers?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#1$2"}},{"t":"line","name":"Ajazi","text":"No problem, I know the way. I'll help us find our sleeping bags."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"No... we're going back to the museum."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1485_1#3$2"}},{"t":"line","name":"Ajani","text":"The museum? How could that place be safe when they'll hire people like me and Ajazi?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"Think about it. Who are the experts on caravan routes, desert terrain, dune movement, burdenbeast habits, and tribal faiths? Bandits, meaning us."},{"t":"line","name":"Narantuya","text":"So, who are the experts on the dead coming back to life, ancient curses, and necromancy? The museum folks."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1485_1#6$2"}},{"t":"line","name":"Ajani","text":"...Makes sense."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.2,"fadetime":2}},{"t":"cmd","c":"camerashake","a":{"duration":3,"xstrength":2,"ystrength":2,"vibrato":30,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_gemprocess","volume":0.8,"loop":true,"channel":"ge"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","volume":0.6,"loop":true,"channel":"e"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.1,"channel":"u","fadetime":2}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"ge","fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"e","fadetime":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"I hear something."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#7$1"}},{"t":"line","name":"Narantuya","text":"Perfect timing. I want to see what those metal constructs are all about."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":3,"xstrength":5,"ystrength":5,"vibrato":30,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":2}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"ge","fadetime":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1489_1#1$1","duration":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1489_1#1$1","duration":1.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1488_1#1$1","duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"—Alright I get it now. Let's go!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_slip","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"effect","a":{"name":"AVG_dust_01","layer":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"250,0","afrom":1,"ato":0,"duration":0.3}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1484_1#6$2"}},{"t":"line","name":"Ajazi","text":"Are we practicing our escape?"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":"Narantuya","text":"No, this IS the escape!"},{"t":"line","name":"Narantuya","text":"Let's hope smoke bombs work on these things!"},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"ge","fadetime":1}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"line","name":null,"text":"She turns around, raises her hand, and prepares to pull the pin on the smoke bomb—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"ge","fadetime":2}},{"t":"cmd","c":"stopsound","a":{"channel":"e","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"ge","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_sandwnd","volume":0,"loop":true,"channel":"s"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.5,"channel":"s","fadetime":2}},{"t":"cmd","c":"image","a":{"image":"53_i06","screenadapt":"coverall","xscale":1.1,"yscale":1.1,"y":-20}},{"t":"cmd","c":"imagetween","a":{"yfrom":-20,"yto":0,"xscalefrom":1.1,"yscalefrom":1.1,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"line","name":null,"text":"Suddenly, the streets grow quiet."},{"t":"line","name":null,"text":"The sound of marching machines disappears."},{"t":"line","name":null,"text":"All the metal constructs Narantuya can see slow down."},{"t":"line","name":null,"text":"They stop chasing them and gather around Narantuya."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":null,"text":"Calm and docile, they watch like tamed burdenbeasts as Narantuya walks past them."},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/act28side/m_avg_saferoom_loop","volume":0.6}},{"t":"line","name":null,"text":"—And back."},{"t":"line","name":"Narantuya","text":"What the hey...?"},{"t":"line","name":"Narantuya","text":"Am I dreaming?"},{"t":"line","name":"Ajazi","text":"It's not a dream, Narantuya. I pinched myself just now. It hurt."},{"t":"line","name":"Narantuya","text":"Thanks. Then I won't try it myself."},{"t":"line","name":"Narantuya","text":"What's going on?"},{"t":"line","name":"Narantuya","text":"Say... I saw a shadow of the river god the night before."},{"t":"line","name":"Narantuya","text":"Maybe it really did bless me."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"s","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"background","a":{"image":"35_g17_deserttown_d","screenadapt":"coverall"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Narantuya","text":"I understand now."},{"t":"line","name":"Narantuya","text":"Ajazi, Ajani, go on to the museum without me."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1485_1#6$2"}},{"t":"line","name":"Ajani","text":"What about you?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#2$1"}},{"t":"line","name":"Narantuya","text":"Divine duty. I need to find someone."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4138_narant_1#1$1"}},{"t":"line","name":"Narantuya","text":"The river god must have wanted me to act the hero, and show Aspasia that I'm the boss."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"35_g17_deserttown_d","xscale":1.2,"yscale":1.2,"y":70,"screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_pawfootstep_2"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1483_1#1$1","duration":1.5,"isblock":true}},{"t":"line","name":"Woof","text":"'Those who stand by me need no longer be enemies of your warriors.'"},{"t":"line","name":"Woof","text":"The jewel constructs are following the pact of the two human sovereigns a thousand years ago. They recognize her blood..."},{"t":"line","name":"Woof","text":"You were right, Zubayr. She is the descendant of Kharanduu Khagan."},{"t":"line","name":"Woof","text":"Come, young Nightzmora. Walk into the dream—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"duration":1.5,"isblock":true}},{"t":"cmd","c":"backgroundtween","a":{"yfrom":70,"yto":-80,"duration":12,"ease":"OutQuad","block":false}},{"t":"cmd","c":"focusout","a":{"type":"bg","id":"35_g17_deserttown_d","from":0,"to":1,"duration":2,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":4,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{}}]}
