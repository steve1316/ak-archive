02_crosly_1#8$1"}},{"t":"line","name":"Lyudmila","text":"You goddamn lupetta!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":0.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","afrom":1,"ato":0,"duration":1,"posfrom":"0,0","posto":"350,0"}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1.5,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"background","a":{"image":"56_g4_newvolsiniialley_n","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"focusout","a":{"duration":3,"type":"char","from":0,"to":0}},{"t":"cmd","c":"focusout","a":{"duration":3,"type":"bg","from":0,"to":0}},{"t":"cmd","c":"blocker","a":{"a":0.3,"r":1,"g":1,"b":1,"fadetime":0.1,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_arrowshot","channel":"1","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":0.2,"xstrength":5,"ystrength":5,"vibrato":20,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_arrowshot","channel":"2","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":1,"g":1,"b":1,"fadetime":0.1,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.2,"xstrength":5,"ystrength":5,"vibrato":20,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_arrowshot","channel":"3"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.2,"block":true}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_mid","layer":1,"x":100,"y":150}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_swordtsing5","channel":"3"}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":5,"ystrength":5,"vibrato":20,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_mid","layer":1,"x":200,"y":50}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_swordtsing6","channel":"4"}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4026_vulpis_1#2$1","duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Ingrid","text":"I've handled tougher fights in the Siracusa of old with many more people on the other end."},{"t":"line","name":"Ingrid","text":"But I'm always the last one standing. No exceptions."},{"t":"line","name":"Ingrid","text":"Don't treat humans like beasts. Your hunting skills won't work on me."},{"t":"line","name":"Ingrid","text":"You can certainly continue to try. Same goes for you, 'Projekt Red'."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_4014_lunacu_1#1$2","duration":1}},{"t":"cmd","c":"delay","a":{"time":1.51}},{"t":"line","name":"Lunacub","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"char_144_red_7#1","duration":1}},{"t":"cmd","c":"delay","a":{"time":1.51}},{"t":"cmd","c":"charslot","a":{"slot":"l","focus":"l"}},{"t":"line","name":"Projekt Red","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_4014_lunacu_1#8$2","focus":"r"}},{"t":"line","name":"Lunacub","text":"I'll find you."},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"char_144_red_7#5","focus":"l"}},{"t":"line","name":"Projekt Red","text":"My blade... not sharp enough..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4026_vulpis_1#8$1"}},{"t":"line","name":"Ingrid","text":"Come."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_4014_lunacu_1#8$2"}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"char_144_red_7#1"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","posfrom":"0,0","posto":"150,300","duration":0.51}},{"t":"cmd","c":"charslot","a":{"slot":"l","posfrom":"0,0","posto":"-150,300","duration":0.51}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovementsp"}},{"t":"cmd","c":"charslot","a":{"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4026_vulpis_1#7$1"}},{"t":"line","name":"Ingrid","text":".....?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4026_vulpis_1#2$1"}},{"t":"line","name":"Ingrid","text":"You can't hide from me forever. I won't wait any longer for Vargo's answers."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_144_red_7#1","duration":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"Projekt Red","text":"......"},{"t":"line","name":"Projekt Red","text":"I lost. To the Vulpo out of nowhere."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_exsheath"}},{"t":"cmd","c":"blocker","a":{"a":0.3,"r":1,"g":1,"b":1,"fadetime":0.4,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_144_red_7#5"}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"-250,0","duration":0.3,"afrom":1,"ato":0}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_ftrub"}},{"t":"cmd","c":"delay","a":{"time":0.2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.4,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1502_crosly_1#7$1","duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Lyudmila","text":"Damned pup!"},{"t":"line","name":"Lyudmila","text":"Think you can just walk away after I finally found you?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_144_red_7#1"}},{"t":"line","name":"Projekt Red","text":"......"},{"t":"line","name":"Projekt Red","text":"You again?!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":1,"g":1,"b":1,"fadetime":0.2,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":15,"ystrength":2,"vibrato":10,"randomness":90,"fadeout":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_spear"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovementsp","delay":0.3}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":90,"fadeout":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_metalcollar","volume":0.6,"delay":0.3}},{"t":"line","name":null,"text":"Lyudmila brandishes her knife once again, but Projekt Red nimbly dodges it. A heavy kick immediately slams into her back. Her arm is pinned down, and her knife clatters onto the ground."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":5,"ystrength":20,"vibrato":10,"randomness":90,"fadeout":true}},{"t":"line","name":null,"text":"By the time she can react, she is already being pressed down into the dirt."},{"t":"line","name":"Lyudmila","text":"Ugh—Agh—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"fadetime":1,"block":true}},{"t":"cmd","c":"image","a":{"image":"avg_6_18","screenadapt":"coverall","xscale":1.3,"yscale":1.3,"x":150,"y":-100}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":null,"text":"The rough scraping of her face against the ground bring a memory to the forefront of her mind—"},{"t":"line","name":null,"text":"In the alleys of Lungmen, she was held down by the same damnable wolf pup, unable to resist then either."},{"t":"line","name":null,"text":"The same sorry figure pressed against the ground, the same pain shooting through her body."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.2,"xstrength":15,"ystrength":15,"vibrato":20,"randomness":90}},{"t":"line","name":"Lyudmila","text":"Gah! My arm! Let go of me! Pizdets! Vaffanculo!"},{"t":"line","name":"Lyudmila","text":"You stronza! I nearly had my revenge in Lungmen. Why'd you have to get between me and Kal'tsit?!"},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90}},{"t":"line","name":"Lyudmila","text":"Maestro couldn't fight any more, so why'd you kill her?!"},{"t":"line","name":"Lyudmila","text":"Why the hell do you keep showing up over and over again?!"},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90}},{"t":"line","name":"Lyudmila","text":"Why can't I kill you?! Why?!"},{"t":"line","name":"Projekt Red","text":"(Bares teeth in irritation)"},{"t":"line","name":"Projekt Red","text":"...I remember you."},{"t":"line","name":"Projekt Red","text":"I hunt wolves. You're not a true wolf. No need to kill you."},{"t":"line","name":"Projekt Red","text":"Kal'tsit said we shouldn't kill a homeless hyena. You're in pain. Kal'tsit doesn't want me to kill you."},{"t":"line","name":"Lyudmila","text":"......"},{"t":"line","name":"Projekt Red","text":"Grandma's waiting for me."},{"t":"line","name":"Projekt Red","text":"I don't have time to waste. I need to find the last true wolf."},{"t":"line","name":"Projekt Red","text":"Don't get in my way again. I've left Rhodes Island. I'm not listening to Kal'tsit any more..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","loop":true,"channel":"bgs","volume":1}},{"t":"cmd","c":"stopsound","a":{"channel":"bgs","fadetime":2}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"background","a":{"image":"56_g4_newvolsiniialley_n","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"line","name":null,"text":"The Lupo clad in a red hoodie stays for not a moment longer, disappearing down the depths of the alley."},{"t":"line","name":null,"text":"Lyudmila doesn't get up. She lies against the ground, cradling her near-dislocated arm, waiting for the pain and humiliation to seep in and drown her."},{"t":"line","name":null,"text":"She suddenly remembers Sommer's words."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1547_1#3$1","focus":"l"}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1502_crosly_1#1$1","focus":"l"}},{"t":"cmd","c":"curtain","a":{"direction":0,"fillfrom":0.1,"fillto":0.1,"fadetime":0.1}},{"t":"cmd","c":"curtain","a":{"direction":4,"fillfrom":0.1,"fillto":0.1,"fadetime":0.1}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","fadetime":0,"keep":true,"initamount":0,"amount":0.7,"block":true}},{"t":"cmd","c":"background","a":{"image":"56_g2_newvolsiniistreet_n","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Sommer","text":"This really is a chance encounter between two sfortunati, haha."},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1547_1#2$1","focus":"l"}},{"t":"line","name":"Sommer","text":"Eirene always says life will show how much it cares for people with bad luck, it's just running a bit late is all."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"curtain","a":{}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","fadetime":0,"amount":0,"block":true}},{"t":"cmd","c":"background","a":{"image":"56_g4_newvolsiniialley_n","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Lyudmila","text":"You sure about that, Sommer?"},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"line","name":"Lyudmila","text":"Sommer... Oh right, Sommer..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement","volume":0.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1502_crosly_1#6$1","duration":1.5,"posfrom":"0,-100","posto":"0,0"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","action":"shake","power":6,"times":40,"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1502_crosly_1#7$1"}},{"t":"line","name":"Lyudmila","text":"Dammit, I got so caught up in chasing that stupid wolf pup... I forgot Sommer's still in the truck..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}}]}
