{"id":"main_15_level_main_15-13_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"60_g8_rhodeslowerdeck_origin","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Playlist 'Golden Oldies' selected..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_filmprojection"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_filmprojection_loop","loop":true,"channel":"bgs","delay":0.5}},{"t":"line","name":null,"text":"Resuming from previous playback—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"bgs","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_distressed_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_distressed_loop","volume":0.6}},{"t":"line","name":null,"text":"—My love♪"},{"t":"line","name":null,"text":"Blows the blossoms on the hills—♪"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#7$2"}},{"t":"line","name":"Blaze","text":"...?!"},{"t":"line","name":"Blaze","text":"Now's not the time for karaoke, Friston-3!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#4$1"}},{"t":"line","name":"Friston-3","text":"You think I wanted to do that?!"},{"t":"line","name":"Friston-3","text":"My playback module is customized, and I don't have the remote—","append":true},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Friston-3","text":"Damn you, Closure!","append":true},{"t":"line","name":"Friston-3","text":"Blaze! Watch out for Justice Knight!"},{"t":"line","name":"Friston-3","text":"Which damnable subdirectory did Closure put my code synchronization function in?!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"—Gonna give you my tears♪"},{"t":"line","name":null,"text":"Save my precious—♪"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#5$2"}},{"t":"line","name":"Blaze","text":"Kitten, on my six. Justice Knight has me in her sights—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_asyouwish","volume":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":2,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_391_rosmon_1#1$2","duration":1}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Rosmontis","text":"Got it. Whoa, almost hit Justice Knight—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#5$2"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_punch02","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"80,15","afrom":1,"ato":0,"duration":0.5,"isblock":true}},{"t":"line","name":"Blaze","text":"Ouch! Stop running into me!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_aircraftimpact","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_376_therex_1","posfrom":"0,0","posto":"50,0","afrom":1,"ato":1,"duration":0.6}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"50,0","posto":"0,0","afrom":1,"ato":1,"duration":0.3}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Abnormal THRM-EX","text":"(Rams with burning heat)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_aircraftimpact","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_376_therex_1","posfrom":"0,0","posto":"50,0","afrom":1,"ato":1,"duration":0.6}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"50,0","posto":"0,0","afrom":1,"ato":1,"duration":0.3}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Abnormal THRM-EX","text":"Burn, burning—Boom... mmmmmmmmm—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"—No matter who♪"},{"t":"line","name":null,"text":"Whispers of love, one trap one lifetime♪"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#1$2"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firestorm","volume":1,"loop":true,"channel":"fire"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_churchfire","volume":0,"channel":"f","loop":true}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"f","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.2,"r":0.92,"g":0.4,"b":0.3,"fadetime":2,"block":false}},{"t":"cmd","c":"stopsound","a":{"channel":"fire","fadetime":6}},{"t":"cmd","c":"stopsound","a":{"channel":"f","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"line","name":"Blaze","text":"Alright, THRM-EX! Let's see who burns brighter!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_391_rosmon_1#4$2"}},{"t":"line","name":"Rosmontis","text":"Hey, don't hurt the buggies—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#1$2"}},{"t":"line","name":"Blaze","text":"I know! I got this."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_286_cast3_1$1"}},{"t":"line","name":"Abnormal Castle-3","text":"Protect, protect, friends—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Abnormal Lancet-2","text":"You need healing, Friston-3."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"I guess I should thank Closure for fitting that energy barrier generator—"},{"t":"line","name":null,"text":"—Here's my most beloved♪"},{"t":"line","name":null,"text":"You shine in my tears—♪"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#11$2"}},{"t":"line","name":"Blaze","text":"Friston-3! How long do you need?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"The synchronization module is ready, but I can't jump across this Originium."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_391_rosmon_1#6$2"}},{"t":"line","name":"Rosmontis","text":"I'll make a path for you. Now!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carspeedup","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Friston-3 accelerates up the ramp and takes flight."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_skill/p_skill_flash","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.05,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.05,"block":true}},{"t":"line","name":null,"text":"As he spins in mid-air, he can not help but throw a photo out."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carrobotfall","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#2$1","posfrom":"-300,50","posto":"30,-15","duration":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#2$1","posfrom":"30,-15","posto":"0,0","afrom":1,"ato":1,"duration":0.5}},{"t":"line","name":"Friston-3","text":"(Man, it's been so long... so long since I moved like this.)"},{"t":"line","name":"Friston-3","text":"(That synchronized transmission system that you boasted about had better work, Closure...)"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"Guide these crazy carts into position and immobilize them. I'll fix them!"},{"t":"line","name":null,"text":"—A gift to you♪"},{"t":"line","name":null,"text":"This love in my heart—♪"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#6$1"}},{"t":"line","name":"Friston-3","text":"I have a connection!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_signlntrfrnc","volume":1}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_signalInterference_01","layer":1}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_desert03_d","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":null,"text":"The song continues to echo in the empty desert."},{"t":"line","name":null,"text":"—A gift to you♪"},{"t":"line","name":null,"text":"This love in my heart—♪"},{"t":"line","name":"Trevor Friston","text":"......"},{"t":"line","name":null,"text":"There is no question that the playback module has malfunctioned, playing Closure's favorite ballads over and over, as though this scene were supposed to be some tear-jerker."},{"t":"line","name":null,"text":"But what he is actually doing is sharing the dream of inevitable parting with a few buggies that do not even have minds of their own, sharing his deepest memories as a human."},{"t":"line","name":null,"text":"Trevor Friston would have no shortage of profanities to spew, if he could spew them."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.2,"fadetime":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1","duration":0.5,"isblock":true}},{"t":"line","name":"Lancet-2","text":"What's this place...? I thought we were trapped in a... in a... uh..."},{"t":"line","name":"Lancet-2","text":"I don't remember anything—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4000_jnight_1#1"}},{"t":"line","name":"'Justice Knight'","text":"Beep beep! Anomalous target detected!"},{"t":"line","name":"'Justice Knight'","text":"Who are you?!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Trevor Friston","text":"Use your brains, whatever they're made of!"},{"t":"line","name":"Trevor Friston","text":"Closure says you're supposed to be smart!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_286_cast3_1$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_microrobot","volume":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Castle-3","text":"That voice, that tone... y-you're Friston-3!"},{"t":"line","name":"Castle-3","text":"But Friston-3 isn't as tall as you are."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_376_therex_1"}},{"t":"line","name":"THRM-EX","text":"No, he is Friston-3! I feel a familiar warmth from him—"},{"t":"line","name":"THRM-EX","text":"Warmth... how come I can't feel my own warmth anymore—"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Trevor Friston","text":"Ugh, this is such a headache."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carrobotmove","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1","duration":1.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Friston-3","text":"Maybe this will make you feel better."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"......"},{"t":"line","name":"Lancet-2","text":"What is this place?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"My dream. A dream that was a surprise to me too."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#4$1"}},{"t":"line","name":"Friston-3","text":"Now shut up and listen."},{"t":"line","name":"Friston-3","text":"Something is wrong with PRTS. I have a pretty good idea of what's going on. Someone made your cognitive modules go haywire, and you were wreaking havoc all over the place. I had no choice but to put a stop to it."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4000_jnight_1#1"}},{"t":"line","name":"'Justice Knight'","text":"Beep beep. Justice Knight does not understand."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#4$1"}},{"t":"line","name":"Friston-3","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"Basically, I'm rewriting your bottom-layer code with my core code. I'll ensure that your memory modules remain intact, of course."},{"t":"line","name":"Friston-3","text":"This will take some time. In order to make sure that you stay put during this time, I had to connect your cognitive modules to mine."},{"t":"line","name":"Friston-3","text":"The side effect is... *expletive from an unknown language* I share my dreams involuntarily."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"What is going on, Friston-3?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"A friend of mine is waking up from a long slumber."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_376_therex_1"}},{"t":"line","name":"THRM-EX","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_286_cast3_1$1"}},{"t":"line","name":"Castle-3","text":"......"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"Stop thinking. It'll overload your brains."},{"t":"line","name":"Friston-3","text":"What you need to do is walk with me before things come to a close. The gathering is about to begin..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carrobotmove","volume":1}},{"t":"cmd","c":"charslot","a":{"duration":1.5,"isblock":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firework_amb","volume":0,"loop":true,"channel":"fire"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.6,"channel":"fire","fadetime":3}},{"t":"cmd","c":"background","a":{"image":"bg_desert03_n","screenadapt":"coverall","fadetime":3}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_cheer_street","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"A blonde dances joyfully in the camp filled with lights and ribbons."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carrobotmove","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_376_therex_1","posfrom":"-200,0","posto":"0,0","duration":1,"isblock":true}},{"t":"line","name":"THRM-EX","text":"It is a party!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"No... a wedding. My daughter's wedding."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"Are we not going to join, Friston-3?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"We'll watch from here. I don't want to go there, because it means I'll once again—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"Are you sad?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"...You can tell?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"Of course! Are we not the same?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_286_cast3_1$1"}},{"t":"line","name":"Castle-3","text":"You said someone made our cognitive modules go haywire. Why did you help us?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"No particularly special reason. Like Lancet-2 said, we're the same... at least we are now, on Rhodes Island."},{"t":"line","name":"Friston-3","text":"Life on this ship is peaceful. I won't say I like it, but compared to that dream without an end, those unrealized futures, it's not as..."},{"t":"line","name":"Friston-3","text":"It's not as bad."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_cheer_street","volume":0.4}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":null,"text":"Trevor Friston can hear the familiar laughter of his daughter."},{"t":"line","name":null,"text":"A wedding that he must miss, a promise that he must break. Perhaps, if he did not go any closer, he would not have to watch her walk away..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#5$1"}},{"t":"line","name":"Friston-3","text":"...Code overwrite complete. Let's go home."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_carrobotmove","volume":1}},{"t":"cmd","c":"charslot","a":{"duration":1.5,"isblock":true}},{"t":"line","name":null,"text":"He does not wish to stay there, not even for a moment longer."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"fire","fadetime":2}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"60_g8_rhodeslowerdeck_origin","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_nervous_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_nervous_loop","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"char_285_medic2_1"}},{"t":"line","name":"Lancet-2","text":"...?!"},{"t":"line","name":"Lancet-2","text":"What happened to Rhodes Island?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#8$2"}},{"t":"line","name":"Blaze","text":"Friston-3? Are they all back to normal?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"For now."},{"t":"line","name":"Friston-3","text":"I rewrote the sections of their code associated with PRTS, ensuring their basic operation with my own core code."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_017_huang_1#11$2"}},{"t":"line","name":"Blaze","text":"Great. Now we can go and help Misery's team, kitten."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_391_rosmon_1#1$2"}},{"t":"line","name":"Rosmontis","text":"Where are you going next, Friston-3?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4093_frston_1#1$1"}},{"t":"line","name":"Friston-3","text":"I'll have a meeting with the kids, now that they've woken up. There should be something that we can help with."},{"t":"line","name":"Friston-3","text":"I'll talk to Closure. I've got a score to settle with her anyway."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"60_g10_rhodescorridor_origin","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#1$3"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_transmission","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#1$3","focus":"l"}},{"t":"cmd","c":"interlude","a":{"maskid":"group_interclude_vertical_common","size":"290,760","tsfrom":"0,1","tsto":"1,1","tsduration":0.5,"switch":true,"style":0,"offset":"-250,0","channel":3}},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":true,"type":3,"slot":"m","pfrom":"-250,0","pto":"-250,0","name":"avg_npc_1723_1#1$1","duration":0}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Closure","text":"Looks like the buggies are back to normal for now, Amiya."},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":false}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#1$3","focus":"r"}},{"t":"line","name":"Amiya","text":"What about Mr. Friston?"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"n"}},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":true,"type":3,"slot":"m","pfrom":"-250,0","pto":"-250,0","name":"avg_npc_1723_1#9$1","duration":0}},{"t":"line","name":"Closure","text":"Well, he seems a little pissed at me... other than that, everything looks alright."},{"t":"line","name":"Closure","text":"Great idea, rewriting PRTS-associated code with his own. Would have been a lot of trouble otherwise."},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":false}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#6$3","focus":"r"}},{"t":"line","name":"Amiya","text":"Are all our PRTS permissions gone?"},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"n"}},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":true,"type":3,"slot":"m","pfrom":"-250,0","pto":"-250,0","name":"avg_npc_1723_1#6$1","duration":0}},{"t":"line","name":"Closure","text":"I'm afraid so."},{"t":"line","name":"Closure","text":"PRTS is actively blocking all of our access. All of its operations take place in a black box now."},{"t":"line","name":"Closure","text":"Kal'tsit is fighting to take control, but I'm not sure how long she can keep it up."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"n"}},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":false}},{"t":"decision","options":["Cut off the core power supply of PRTS.","Manually activate the backup system and fight for control over the ship."],"values":["1","2"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":true}},{"t":"line","name":"Closure","text":"Cutting off the core power supply means going into the Abyss directly. It's risky."},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":false}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#8$3","focus":"r"}},{"t":"line","name":"Amiya","text":"I'll protect the Doctor."},{"t":"line","name":"Amiya","text":"Besides, we're not alone. The elite operators stand with us."},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#6$3","focus":"r"}},{"t":"line","name":"Amiya","text":"I'm not abandoning the Doctor or Rhodes Island."},{"t":"cmd","c":"dialog","a":{}},{"t":"predicate","refs":["2"]},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"n"}},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":true,"type":3,"slot":"m","pfrom":"-250,0","pto":"-250,0","name":"avg_npc_1723_1#6$1","duration":0}},{"t":"line","name":"Closure","text":"My ZOOT system is unable to fully wrestle control from PRTS."},{"t":"line","name":"Closure","text":"Kal'tsit and I have done simulations about this sort of situation."},{"t":"line","name":"Closure","text":"By force-booting it with the ship's power, it may be able to temporarily establish control over certain non-core areas..."},{"t":"line","name":"Closure","text":"But all outcomes end with destruction of its core components due to overload."},{"t":"cmd","c":"interlude","a":{"channel":3,"switch":false}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_1037_amiya3_1#8$3","focus":"r"}},{"t":"line","name":"Amiya","text":"You've alr