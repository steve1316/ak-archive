{"name":"avg_npc_156_1#2","name2":"avg_npc_155_1#1","enter":"left","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#2","name2":"avg_npc_155_1#1","focus":2}},{"t":"line","name":"Franka","text":"You... run!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#2","name2":"avg_npc_155_1#1","focus":1}},{"t":"line","name":"Liskarm","text":"Don't speak!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#2","name2":"avg_npc_155_1#1","focus":2}},{"t":"line","name":"Franka","text":"My leg...You... just leave me."},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#2","name2":"avg_npc_155_1#1","focus":1}},{"t":"line","name":"Liskarm","text":"Cut the bullshit!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":200,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Liskarm","text":"Piggyback, quick!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_159_1#2"}},{"t":"line","name":"Picale","text":"They're coming back!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"line","name":"Tachanka","text":"Now! Get out of here!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_012"}},{"t":"line","name":"Occphen","text":"Over here!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#2"}},{"t":"line","name":"Liskarm","text":"Mr. Occphen! What are you doing here?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_012"}},{"t":"line","name":"Occphen","text":"How could I just wait around down there? I'm a Rhodes Island Operator too!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_156_1#1"}},{"t":"line","name":"Liskarm","text":"Damn straight! You really saved us!"},{"t":"cmd","c":"character","a":{"name":"char_503_rang"}},{"t":"line","name":"Rangers","text":"Get ready to blow the engine..."},{"t":"line","name":"Rangers","text":"Three, two, one..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_explo_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":2.5}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_empty"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","enter2":"right","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"What's the situation?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"They've been pushed back, for now. But they'll come for us again before long."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3"}},{"t":"line","name":"Frost","text":"There... seems to be less of them?"},{"t":"line","name":"Frost","text":"I'm all out of 'welcome mats.' Ammo's gone too."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"What's the plan, Alexsandr?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"Get to the shelter."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"What?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"Get to the shelter! Take the Rhodes Island Operators and get to shelter!"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"What about you?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"I'll cover you."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"Cover? And who's covering you?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"I don't need cover."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#4","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"Hey! Get it together! Alexsandr!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":0}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"I'm all together."},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Tachanka","text":"I'm tired of all the hiding and running."},{"t":"line","name":"Tachanka","text":"Running can't win you the war. History's shown."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3"}},{"t":"line","name":"Frost","text":"But this isn't a war."},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta2_180603/m_bat_qiechengimp_intro","key":"Sound_Beta_2/Music/beta2_180603/m_bat_qiechengimp_loop","volume":0.4}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"It is to me."},{"t":"line","name":"Tachanka","text":"When they pull weapons on the Infected and try to kill my friends, it's a war."},{"t":"line","name":"Tachanka","text":"I've been through plenty of wars in my time."},{"t":"line","name":"Tachanka","text":"If I can kill even one more *profanity* monster here, it'll give the townsfolk a better shot at survival."},{"t":"line","name":"Tachanka","text":"I'll make my stand here until I run out of ammo. Until the very end."},{"t":"line","name":"Tachanka","text":"The battle's not over. How could I retreat?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#4"}},{"t":"line","name":"Frost","text":"You're the one who says not to play hero!"},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"I don't think I'm playing hero, Tina."},{"t":"line","name":"Tachanka","text":"I'm just doing the right thing."},{"t":"line","name":"Tachanka","text":"No matter what happens, the show ends here, today."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#4"}},{"t":"line","name":"Frost","text":"Alexsandr! !"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#4","name2":"char_503_rang","focus":2}},{"t":"line","name":"Rangers","text":"I'm staying too."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_503_rang","focus":1}},{"t":"line","name":"Frost","text":"But why...?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_503_rang","focus":2}},{"t":"line","name":"Rangers","text":"It was always going to turn out like this. We all knew it, from the moment you decided to stay and fight."},{"t":"line","name":"Rangers","text":"I'll stay behind and help the warrior hold them back. And if things go bad, I'll cover his retreat."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_503_rang","focus":1}},{"t":"line","name":"Frost","text":"Mr. Rangers..."},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_tense_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_tense_loop","volume":0.4}},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"Alexsandr, take this."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"What's this?"},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Frost","text":"An Originium bomb I tried my hand at making. There's only two left."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"...Thanks."},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#4"}},{"t":"line","name":"Frost","text":"Stay alive!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral"}},{"t":"cmd","c":"character","a":{"name":"char_458_rfrost_1#3"}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-300,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"...No promises."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"You didn't tell her the truth. You're not going to run."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"Hahaha... You didn't have to go blowing this old man's scheme."},{"t":"line","name":"Rangers","text":"You need someone to hold these monsters back."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_bat_sacrifice_intro","key":"Sound_Beta_2/Music/act9d0d0/m_bat_sacrifice_loop","volume":0.4}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"The aged ranger takes out a blade.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"This is...?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang"}},{"t":"line","name":"Rangers","text":"The old Lord's blade. I borrowed it."},{"t":"line","name":"Rangers","text":"This is a fine blade. The old Lord had good taste."},{"t":"line","name":"Rangers","text":"Beautifully decorated steel, and a hand-lain turquoise handle that's as nice as any modern industrially-manufactured weapon."},{"t":"line","name":"Rangers","text":"It's a lot safer to stand in the back with a bow and arrow than fighting on the front line."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":1}},{"t":"cmd","c":"subtitle","a":{"text":"The old Savra ranger dances with his long, curved blade.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"I'm so much older and slower than I was."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"But the blade, she's as sharp as ever."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"I still don't know your name, warrior."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"Alexsandr Senaviev."},{"t":"line","name":"Tachanka","text":"You can call me Alexsandr."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"I should tell you my name too."},{"t":"line","name":"Rangers","text":"But the sands buried my name the day we stained the valley red with blood, along with the past."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"It's fine."},{"t":"line","name":"Tachanka","text":"You decided to stay and fight. That's what matters."},{"t":"line","name":"Tachanka","text":"'Rangers'."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"'They told me I'd died. They were wrong. I was reborn. '"},{"t":"line","name":"Tachanka","text":"No matter how many of those monsters there are."},{"t":"line","name":"Tachanka","text":"Let them come."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}}]}
