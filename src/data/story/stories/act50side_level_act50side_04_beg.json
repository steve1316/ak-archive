c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act50side/act50side_pl_wp_caxe_eqvsp_burst_elec_v2","volume":1,"channel":"burst2"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":70,"ystrength":70,"vibrato":70,"randomness":95,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":false}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","layer":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act50side/act50side_pl_wp_caxe_eqvsp_burst_elec_v2","volume":1,"channel":"burst3"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act50side/act50side_pl_wp_caxe_epvsp_smoke"}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","layer":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act50side/act50side_pl_wp_caxe_imp_switch"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act50side/act50side_pl_wp_caxe_imp_draw"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2104_1#1$2","focus":"m"}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"duration":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1049_catap2_1#4$2","focus":"m"}},{"t":"line","name":"Catapult","text":"Heheh, you see that, Orchid?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1048_orchd2_1#11$2","focus":"m"}},{"t":"line","name":"Orchid","text":"You—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1049_catap2_1#11$2","focus":"m"}},{"t":"line","name":"Catapult","text":"Ooh, uh-oh... My body's feeling real light—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1048_orchd2_1#11$2","focus":"m"}},{"t":"line","name":"Orchid","text":"*sigh* Idiot."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1049_catap2_1#11$2","focus":"m"}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown2","volume":0.7}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"image","a":{"image":"71_i03","fxscale":1.1,"yscale":1.1,"adetime":0}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.1,"yscalefrom":1.1,"xscaleto":1,"yscaleto":1,"duration":30}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/AVG/m_avg_calm_loop","volume":0.5}},{"t":"line","name":null,"text":"The bonfire crackles, dispersing the chill in the air."},{"t":"line","name":null,"text":"Orchid crouches down, carefully tending to Catapult's wounds with a deep furrow on her brow."},{"t":"line","name":"Catapult","text":"Heh, I was pretty cool back there, wasn't I? The Escorchgot was no slouch either, but—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Orchid switches from a careful touch to a heavy-handed one."},{"t":"line","name":"Catapult","text":"Ow ow ow, ease up a little."},{"t":"line","name":"Orchid","text":"*sigh* I knew things would end up like this the moment you found that weapon."},{"t":"line","name":"Catapult","text":"Yeah—Owowowow! But don't you find it interesting too, Orchid? Hunting's way too fun."},{"t":"line","name":"Orchid","text":"There's nothing fun about watching you get yourself hurt."},{"t":"line","name":"Catapult","text":"That's the point, though. You take all your strength, smarts, and guts, and use them to beat an opponent way way stronger than you! Nothing beats this feeling!"},{"t":"line","name":"Orchid","text":"Well, I disagree."},{"t":"line","name":"Orchid","text":"All I saw was someone disobeying my direct order, just so she could feel 'cool'."},{"t":"line","name":"Catapult","text":"I wasn't disobeying orders! I was..."},{"t":"line","name":"Orchid","text":"Yoshitsune was right."},{"t":"line","name":"Catapult","text":"Huh? What did he say?"},{"t":"line","name":"Orchid","text":"He said I subconsciously avoid getting too close to the fight. He's right."},{"t":"line","name":"Orchid","text":"But you? Masamune said you're too reckless. Can you honestly say you weren't just gambling with your life back there?"},{"t":"line","name":"Catapult","text":"I..."},{"t":"line","name":"Catapult","text":"(So Masamune said I was reckless too. But if I wasn't, I'd never have been able to nab that split-second chance.)"},{"t":"line","name":"Catapult","text":"(That feeling of my heart leaping out of my chest, of betting it all on that one moment...)"},{"t":"line","name":"Orchid","text":"......"},{"t":"line","name":"Orchid","text":"But what I really don't get is what exactly hunting means to you."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Catapult tilts her head at the question. She intends to laugh it off with a joke as usual, but finds herself at a loss for words."},{"t":"line","name":null,"text":"Silence overtakes the two, with only the sizzle of the grilling meat proving the passage of time."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"71_g5_snowymountpath","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_nervous_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_nervous_loop","volume":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2104_1#1$2","focus":"m","duration":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":50,"randomness":70,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_swordtsing5","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"So this generation's Iju was an Escorchgot colossus all along."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"First thou hast enslaved an ordinary Escorchgot, using its curse to transform the mountain into a volcano, creating a habitat more suitable for thee and thine ilk."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Next thou hast separated us, seeking to destroy us one by one."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"However, thou hast made two errors..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"First, thou dost not understand how strong Madam Orchid and Madam Catapult are."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Indeed, thou must have sensed it. The curse's power hath waned. Its lesser source hath dissipated."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"They have slain thy minion."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#9$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Thy second error... was becoming my opponent."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#6$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Perish."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.5,"r":1,"g":1,"b":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.4}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_attack_heavy","volume":0.9}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bone_rub","volume":0.9}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2104_1#1$2","focus":"m"}},{"t":"line","name":"'Iju' Escorchgot","text":"(Feeble screech)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1","volume":0.7}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#8$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"71_g5_snowymountpath","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_plot_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_plot_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#5$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Urgh—!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#5$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"What is this?!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Hofukaru senses something under her feet, something deep, deep underground calling to her."},{"t":"line","name":null,"text":"The call is strong. So strong she can feel her soul being pulled out of her body."},{"t":"line","name":null,"text":"Overwhelming pain pours into her, making it hard to even breathe."},{"t":"line","name":null,"text":"At the same time, a jet of black miasma suddenly bursts out of the fallen Iju's corpse. As the plume grows thicker, the Iju slowly picks itself off the ground."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2104_1#1$1","focus":"m","duration":2}},{"t":"cmd","c":"delay","a":{"time":3}},{"t":"line","name":null,"text":"Its shell slowly cracks open, revealing its true nature: substance without form, matter without description, a portion of space floating free."},{"t":"line","name":null,"text":"And yet, this impossible thing exists upon the Iju's back."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":60,"ystrength":60,"vibrato":70,"randomness":80,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_grenade_explosion","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#10$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Gah—"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2100_1#10$1","focus":"m"}},{"t":"line","name":"Hofukaru","text":"Its attacks are far more ferocious than before..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_2104_1#1$1","focus":"m"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng"}},{"t":"line","name":"'Iju' Escorchgot","text":"(Angry howl)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":2,"xstrength":25,"ystrength":25,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","loop":false,"channel":"bgs","volume":0.3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_rockfall","volume":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_smallearthquake","volume":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_rockfall","volume":0.6}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/