b goes off."},{"t":"cmd","c":"character","a":{"name":"avg_npc_166"}},{"t":"line","name":"Schwarz","text":"This way!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":-300,"fadetime":2,"block":false}},{"t":"cmd","c":"character","a":{"fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_explo_n"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":1,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_nobleD"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"cmd","c":"camerashake","a":{"duration":0.8,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":0.8,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":0.8,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_atk/p_atk_smg_h","volume":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.2,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"camerashake","a":{"duration":0.2,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"line","name":"Tachanka","text":"I'm out of ammo."},{"t":"line","name":"Tachanka","text":"Rangers?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang#2"}},{"t":"line","name":"Rangers","text":"I'm still here..."},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang#2","name2":"char_empty"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":-200,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_503_rang#2","name2":"char_459_tachak_1#2","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_503_rang#2","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"You don't look so good."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"I'm old, so old... phew..."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"What happened to your hand?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"I couldn't dodge. That's all."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"What do we do now? Should we go to the shelter?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"No news from the mine?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"None."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"Hahaha..."},{"t":"line","name":"Rangers","text":"I never thought we'd hold out this long... but we're almost to the end of the road."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_459_tachak_1#2"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_blunt_h"}},{"t":"cmd","c":"camerashake","a":{"duration":0.4,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_sheildimpact","volume":0.6}},{"t":"cmd","c":"camerashake","a":{"duration":0.4,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_blunt_h","volume":0.8}},{"t":"cmd","c":"camerashake","a":{"duration":0.4,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"What are you doing?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"Making a shield. I always wanted to try, actually."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"Hahaha..."},{"t":"cmd","c":"character","a":{"name":"char_503_rang"}},{"t":"line","name":"Rangers","text":"What a trip down memory lane. Back to the glorious good old days."},{"t":"line","name":"Rangers","text":"The young rangers all gathered at the edge of town."},{"t":"line","name":"Rangers","text":"Knowing the overwhelming odds stacked against them, knowing most would spill their blood in the wasteland after the war."},{"t":"line","name":"Rangers","text":"But they laughed and sang war songs, as if they were facing down bugs to be easily squashed."},{"t":"line","name":"Rangers","text":"War is cruel, and merciless. Some backed down. Many more held the line."},{"t":"line","name":"Rangers","text":"The fallen became legends. The survivors were tasked with remembering them."},{"t":"line","name":"Rangers","text":"And the last one standing in that bloodbath, after all that time, started to feel the fear of death set in."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"Because he doesn't want the dead to be forgotten?"},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":1}},{"t":"line","name":"Rangers","text":"Hahaha... maybe that's why."},{"t":"line","name":"Rangers","text":"It's been an honor to fight alongside you, Alexsandr."},{"t":"cmd","c":"character","a":{"name":"char_503_rang","name2":"char_459_tachak_1#2","focus":2}},{"t":"line","name":"Tachanka","text":"The honor is mine, Rangers."},{"t":"line","name":"Tachanka","text":"But don't be so gloomy. I haven't given up the fight."},{"t":"line","name":"Tachanka","text":"I'll smash a few to death."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_arrow_h","volume":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang"}},{"t":"line","name":"Rangers","text":"Wait... what's that?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_arrow_h","volume":1}},{"t":"cmd","c":"subtitle","a":{"text":"Arrow","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"camerashake","a":{"duration":3,"ystrength":20,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"subtitle","a":{"text":"Arrows fall like rain on the ground in front of the manor, piercing Originiutant skulls and throats with precision.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"The black downpour continues uninterrupted, like a storm sweeping across the land.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_503_rang"}},{"t":"line","name":"Rangers","text":"The cavalry's here! Hahahahahaha! We're saved!"},{"t":"line","name":"Rangers","text":"This technique... Must be that young person."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Stormeye","text":"I picked up a Rhodes Island distress signal and figured it was a normal rescue mission."},{"t":"line","name":"Stormeye","text":"I didn't think I'd run into you."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_bat_normal02_intro","key":"Sound_Beta_2/Music/beta1_180603/m_bat_normal02_loop","volume":0.4}},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":1}},{"t":"line","name":"Stormeye","text":"Old Ranger."},{"t":"line","name":"Stormeye","text":"You're back in business, huh?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":2}},{"t":"line","name":"Rangers","text":"Haha, at my age? You're making fun."},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":1}},{"t":"line","name":"Stormeye","text":"What about your sword, Ranger?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":2}},{"t":"line","name":"Rangers","text":"I'm too old. I haven't been able to swing it for years."},{"t":"line","name":"Rangers","text":"If it weren't for you, today would be the end of these old bones."},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":1}},{"t":"line","name":"Stormeye","text":"You sell yourself short, Old Ranger."},{"t":"line","name":"Stormeye","text":"Listen up, squad. The objective is the Lord's manor."},{"t":"line","name":"Stormeye","text":"The enemy is an extremely dangerous form of Originium organism."},{"t":"line","name":"Stormeye","text":"Keep your location updated."},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":2}},{"t":"line","name":"Rangers","text":"Be careful. There's many of them. Try not to let your folks fight alone."},{"t":"line","name":"Rangers","text":"Also, be mindful of the ground. They are good at drilling."},{"t":"cmd","c":"character","a":{"name":"avg_npc_167","name2":"char_503_rang","focus":1}},{"t":"line","name":"Stormeye","text":"Understood."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"character","a":{"name":"avg_npc_167"}},{"t":"line","name":"Stormeye","text":"It's an honor to fight beside you."},{"t":"line","name":"Stormeye","text":"'Scimitar of the Bloody Valley'."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}}]}
