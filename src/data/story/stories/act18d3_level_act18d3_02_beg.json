{"id":"act18d3_level_act18d3_02_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"avg_npc_178"}},{"t":"cmd","c":"background","a":{"image":"bg_ibtownd"}},{"t":"cmd","c":"image","a":{"image":"ac18_02","xscale":1.1,"yscale":1.1,"fadetime":0}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"3:23 P.M. \\ Overcast"},{"t":"line","name":null,"text":"Iberia, Sal Viento"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_intro","key":"Sound_Beta_2/Music/act15d0d0/m_avg_ponder_loop","volume":0.4}},{"t":"cmd","c":"imagetween","a":{"yfrom":30,"yto":-30,"duration":25,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"A city, life long lost, lies half-buried under dust and whiff of sea breeze.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Skadi","text":"This is the place on the map."},{"t":"line","name":"Skadi","text":"I can't say it smells any good."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"image","a":{"fadetime":1.5,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4","name2":"avg_npc_178","fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Skadi","text":"Hello."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name2":"char_empty","name":"avg_npc_178"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name2":"avg_1012_skadiSP_1#4","name":"avg_npc_178","fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name2":"avg_1012_skadiSP_1#4","name":"avg_npc_178","focus":2}},{"t":"line","name":"Skadi","text":"May I ask—"},{"t":"cmd","c":"character","a":{"name2":"avg_1012_skadiSP_1#4","name":"avg_npc_178","focus":1}},{"t":"line","name":"Another Male Inhabitant","text":"(He hangs his head low, and does not speak.)"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Nobody responds. Nobody so much as turns a head. Their eyes are open, yet all of them are motionless.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Their only trait unlike a statue is that they breathe. Long and slow, they breathe.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#7"}},{"t":"line","name":"Skadi","text":"......"},{"t":"line","name":"Skadi","text":"Monsters?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"They are all human in appearance. Aside from being far too slender, and clothed in near-rags, they are indistinguishable from the Iberians met along the way, a far cry from the monsters Old José described.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"They're all humans."},{"t":"line","name":"Skadi","text":"(She utters Iberian.)"},{"t":"line","name":"Skadi","text":"Is this not how they speak anymore?"},{"t":"line","name":"Skadi","text":"(Iberian again, the accent somewhat changed.)"},{"t":"line","name":"Skadi","text":"......"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Still no one replies.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Skadi subconsciously grips her case's handle.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Outside, she has her ways of making those who will not talk, talk. But it requires that the target comprehend her speech.","x":300,"y":370,"alignment":"left","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Skadi","text":"Moreover, I'm a singer right now."},{"t":"line","name":"Skadi","text":"A singer doesn't do that. Mister José said so."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"musicvolume","a":{"volume":0,"fadetime":1}},{"t":"line","name":"???","text":"Ninety-nine..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"A small shadow flits across the street.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"Someone's talking."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0.4,"fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"With a fast step, she chases after.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":-300,"fadetime":2,"block":false}},{"t":"cmd","c":"character","a":{"fadetime":0.5}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":"???","text":"Ninety-nine."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":200,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.51}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":-200,"fadetime":1,"block":false}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"avg_1012_skadiSP_1#4","fadetime":0.7}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Skadi","text":"A... child? He's mumbling a number."},{"t":"line","name":"Skadi","text":"I can't have misheard."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#7"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Skadi","text":"You—"},{"t":"line","name":"Skadi","text":"My necklace just..."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#6"}},{"t":"line","name":"Skadi","text":"You will not escape!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"The child slips free of her grasp. With a flick of his head, he scampers down an even deeper alleyway.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Young Inhabitant","text":"Ninety-nine, ninety-nine..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral"}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"background","a":{"image":"bg_ibbar"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#7","fadetime":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"line","name":"Skadi","text":"You can't run."},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Young Inhabitant","text":"*Whimper*..."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#7"}},{"t":"line","name":"Skadi","text":"Why take what's mine? Why bring me here?"},{"t":"line","name":"Skadi","text":"Hm?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"musicvolume","a":{"volume":0,"fadetime":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_dooropenquite"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Skadi tramples directly onto a trap laid on the ground.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"musicvolume","a":{"volume":0.4,"fadetime":1}},{"t":"line","name":"Skadi","text":"A hole, a few ropes. The ambushes outside were at least much more adequate than this."},{"t":"line","name":"Skadi","text":"Come out, all of you."},{"t":"line","name":"Skadi","text":"I needed to find you, anyway. Quickly, if you don't mind."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"In the shadows, some few 'sculptures' come to life, slowly easing towards Skadi.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"char_empty","fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"She's very peculiar."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Male Inhabitant B","text":"Quite, Sheetmetal. Such a person, I've never before seen."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Nor I."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"So you know how to speak after all."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Who are you?"},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"A wandering singer."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"I know not what a wandering singer is."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Male Inhabitant B","text":"Sheetmetal, do not speak to her."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Your face, unfamiliar. Your attire, strange. You are not one from here. What is your business?"},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"I want to ask a question."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Your clothes, very new."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"Have you seen my fellow person?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"You have much strength. You are able to eat your fill."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"She came here before I did."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Your case, very heavy."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"An instrument is not a light thing."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"The thing in your grasp, very uncanny."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"I assume your harps should come more or less the same."},{"t":"line","name":"Skadi","text":"(Plucks strings)"},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Ears, pained. It is a weapon."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"It is able to not be."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Male Inhabitant B","text":"Sheetmetal, this person, uncanny. Do not heed her. To speak, very tiring."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Bench. Let go of him."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"Bench... Do you mean this child?"},{"t":"line","name":"Skadi","text":"I didn't intend anything for him. He took something of mine. Things like that are significant."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"You came to rob something."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"......"},{"t":"line","name":"Skadi","text":"I'm only taking back what's mine. And looking for someone who can understand me when I talk."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"Young Inhabitant","text":"*Whimper*..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Our child, you may not touch."},{"t":"line","name":"Male Inhabitant A","text":"Our things, you may not rob."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"Hm?"},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":50,"fadetime":0.8,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Our rules, may not be broken."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Male Inhabitant B","text":"Sheetmetal, you have gotten nearer. What are you doing?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"She is going to harm our child, steal what is ours, break our rules."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"line","name":"Male Inhabitant B","text":"Is she not our sister? If she is, she too has a share."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"She is surely not."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"You don't understand me."},{"t":"line","name":"Skadi","text":"I'll go and ask someone else."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":100,"fadetime":0.8,"block":false}},{"t":"line","name":"Male Inhabitant A","text":"You may not leave."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":100,"fadetime":0.8,"block":false}},{"t":"line","name":"Male Inhabitant B","text":"One moment, Sheetmetal..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_dooropenquite"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","ypos":-90,"fadetime":0.5,"block":false}},{"t":"line","name":"Male Inhabitant B","text":"Ouch!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Male Inhabitant B","text":"There—There is a hole here."},{"t":"cmd","c":"character","a":{"name":"avg_npc_187","name2":"avg_npc_178","focus":2}},{"t":"line","name":"Male Inhabitant A","text":"Woodframe's hole. You forgot."},{"t":"cmd","c":"character","a":{"name":"avg_1012_skadiSP_1#4"}},{"t":"line","name":"Skadi","text":"Oh, it comes in handy after all."},{"t":"cmd","c":"character","a":{"name":"avg_npc_178"}},{"t":"line","name":"Male Inhabitant A","text":"Those from outside, to our place, you should not have come!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"image","a":{}}]}
