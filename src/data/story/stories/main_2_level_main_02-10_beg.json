{"id":"main_2_level_main_02-10_beg","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"background","a":{"image":"bg_lungmen_r","width":1,"height":1,"fadetime":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/beta1_180603/m_sys_loading_intro","key":"Sound_Beta_2/Music/beta1_180603/m_sys_loading_loop","volume":0.8,"crossfade":1.5,"delay":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1","name2":"char_107_liskam_1","focus":1}},{"t":"line","name":"Franka","text":"Liskarm Are you able to hold the line?"},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1","name2":"char_107_liskam_1","focus":2}},{"t":"line","name":"Liskarm","text":"I'm fine over here!"},{"t":"line","name":"Liskarm","text":"Franka, watch out for an enemy flank!"},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1","name2":"char_107_liskam_1","focus":1}},{"t":"line","name":"Franka","text":"There's no end to them...!"},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"You don't have a chance of breaking through our defenses!"},{"t":"line","name":"Reunion Member","text":"I'm going to smash you..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrsword","volume":0.6}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":6,"ystrength":10,"vibrato":50,"randomness":90,"fadeout":true,"block":true}},{"t":"line","name":"Reunion Member","text":"Guh?!"},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_2"}},{"t":"line","name":"Reunion Member","text":"A-aaaagh!"},{"t":"line","name":"Reunion Member","text":"Wh-what is that? !"},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1"}},{"t":"line","name":"Franka","text":"It's a thermite blade."},{"t":"line","name":"Franka","text":"Does slicing count as breaking as well?"},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1"}},{"t":"line","name":"Franka","text":"What a pain..."},{"t":"line","name":"Franka","text":"Medic! There's someone injured here!"},{"t":"line","name":"Franka","text":"Be careful when transporting them!"},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"line","name":"Medic","text":"I got it!"},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1"}},{"t":"line","name":"Franka","text":"Amiya!"},{"t":"line","name":"Franka","text":"How's the situation over there?"},{"t":"cmd","c":"character","a":{"name":"char_107_liskam_1"}},{"t":"line","name":"Liskarm","text":"I think we have a little issue here."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"Franka..."},{"t":"line","name":"Amiya","text":"The enemy leader... just showed up in front of me and Liskarm!"},{"t":"cmd","c":"character","a":{"name":"char_1500_skulsr"}},{"t":"line","name":"Skullshatterer","text":"..."},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_imp/e_imp_sword_h","volume":0.7}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_imp/e_imp_sword_h","volume":0.5}},{"t":"cmd","c":"blocker","a":{"a":0.7,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.02,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":6,"ystrength":10,"vibrato":50,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_1500_skulsr"}},{"t":"line","name":"Skullshatterer","text":"Where else do you plan on hiding?"},{"t":"line","name":"Skullshatterer","text":"You can't escape us, Rhodes Island."},{"t":"line","name":"Skullshatterer","text":"I'll grind you to dust..."},{"t":"line","name":"Skullshatterer","text":"...not even your bones will remain."},{"t":"line","name":"Skullshatterer","text":"You traitors... have turned your backs on the Infected!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrshot","volume":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":50,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1","name2":"char_107_liskam_1","focus":1}},{"t":"line","name":"Franka","text":"Oh~ This one's finally decided to show up."},{"t":"line","name":"Franka","text":"Doesn't sound too impressive, though."},{"t":"cmd","c":"character","a":{"name":"char_107_liskam_1"}},{"t":"line","name":"Liskarm","text":"Amiya, seems like we--"},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1"}},{"t":"line","name":"Franka","text":"Ack, it's a dead end!"},{"t":"line","name":"Franka","text":"Did I run too far ahead? !"},{"t":"cmd","c":"character","a":{"name":"char_107_liskam_1"}},{"t":"line","name":"Liskarm","text":"Franka's also having some problems..."},{"t":"line","name":"Liskarm","text":"Reunion has us cornered."},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1"}},{"t":"line","name":"Amiya","text":"..."},{"t":"cmd","c":"character","a":{"name":"char_107_liskam_1"}},{"t":"line","name":"Liskarm","text":"We'll have to fight."},{"t":"line","name":"Liskarm","text":"I feel that... we more than match up against them."},{"t":"line","name":"Liskarm","text":"We just have to get a bit more serious..."},{"t":"cmd","c":"character","a":{"name":"char_106_franka_1"}},{"t":"line","name":"Franka","text":"Liskarm, you just don't understand."},{"t":"line","name":"Franka","text":"Whatever level of power we choose to display, we can't let the L.G.D. feel threatened."},{"t":"cmd","c":"character","a":{"name":"char_107_liskam_1"}},{"t":"line","name":"Liskarm","text":"But we can't just sit here and let them run over us!"},{"t":"line","name":"Liskarm","text":"Defenders, hold your ground!"},{"t":"cmd","c":"character","a":{"name":"char_1500_skulsr"}},{"t":"line","name":"Skullshatterer","text":"A leader of Rhodes Island, eh..."},{"t":"line","name":"Skullshatterer","text":"You're an Infected, but you still assist Lungmen in their slaughter of other Infected!"},{"t":"line","name":"Skullshatterer","text":"You have blood of so many of my comrades on your hands!"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_skill/e_skill_skulsrshot","volume":0.5}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":50,"randomness":90,"fadeout":true,"block":false}},{"t":"line","name":"Skullshatterer","text":"Stand and face me!"},{"t":"cmd","c":"character","a":{"name":"char_002_amiya_1#7"}},{"t":"line","name":"Amiya","text":"..."},{"t":"line","name":"Amiya","text":"Reunion..."},{"t":"line","name":"Amiya","text":"You were the ones who started the hatred, the pain, and the violence..."},{"t":"line","name":"Amiya","text":"You were the ones who started all this in Chernobog!!"},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}}]}
