und","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_arrow_h","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":1,"b":1,"afrom":0,"rfrom":0,"gfrom":0,"bfrom":0,"fadetime":0.1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Player/p_imp/p_imp_arrow_h","volume":0.9}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1.5,"block":false}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":1,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":5}},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#3"}},{"t":"line","name":"Skyfire","text":"We did it! It's heading the other way!"},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#3","name2":"char_145_prove_1","focus":2}},{"t":"line","name":"Provence","text":"Yes! The citizens are going to be safe now!"},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":1}},{"t":"line","name":"Skyfire","text":"Good grief! I can't believe a single slug would be that hard to deal with! My skirt is all ruined..."},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":2}},{"t":"line","name":"Provence","text":"It was the leader of the colony after all."},{"t":"line","name":"Provence","text":"If people didn't destroy their habitat in the first place, then perhaps..."},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":1}},{"t":"line","name":"Skyfire","text":"I'm exhausted! Let's not bring up that tiresome topic again!"},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/a001/m_dia_path_intro","key":"Sound_Beta_2/Music/a001/m_dia_path_loop","volume":0.8,"crossfade":3}},{"t":"cmd","c":"character","a":{"name":"char_348_ceylon_4#6"}},{"t":"line","name":"Ceylon","text":"Haha, me too. I'm so tired I can barely stand."},{"t":"line","name":"Ceylon","text":"But, we have to head back to Siesta. There are people waiting for us there..."},{"t":"cmd","c":"character","a":{"name":"char_348_ceylon_4#7"}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":4,"ystrength":4,"vibrato":10,"randomness":20,"fadeout":true}},{"t":"line","name":"Ceylon","text":"Oof!"},{"t":"cmd","c":"character","a":{"name":"char_348_ceylon_4#7","name2":"char_145_prove_1","focus":2}},{"t":"line","name":"Provence","text":"That's understandable, but a mature lady should also learn to get help if she's not even able to keep her balance."},{"t":"cmd","c":"character","a":{"name":"char_348_ceylon_4#7","name2":"char_145_prove_1","focus":1}},{"t":"line","name":"Ceylon","text":"Th-thank you..."},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2"}},{"t":"line","name":"Skyfire","text":"All right, let's go take our victory lap now. Once we get back, there might still be some time for us to enjoy our vacation."},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":2}},{"t":"line","name":"Provence","text":"But... sooner or later, this place will..."},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":1}},{"t":"line","name":"Skyfire","text":"Big tail?"},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":2}},{"t":"line","name":"Provence","text":"Ah, I'm coming."},{"t":"line","name":"Provence","text":"Skyfire..."},{"t":"cmd","c":"character","a":{"name":"char_166_skfire_3#2","name2":"char_145_prove_1","focus":1}},{"t":"line","name":"Skyfire","text":"I know."},{"t":"line","name":"Skyfire","text":"But we should respect the city's choice, and let them handle the rest, right?"},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"fadetime":3,"block":true}},{"t":"cmd","c":"image","a":{}}]}
