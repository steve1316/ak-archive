 Bob","text":"I'll only end up slowing you down with this bad leg!"},{"t":"line","name":"Big Bob","text":"I'll find a way to meet up with you later! Hurry!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":30,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"..."},{"t":"line","name":"Grani","text":"It's a promise then! Make sure to come get your share of the treasure!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_010"}},{"t":"line","name":"Big Bob","text":"...Heh."},{"t":"line","name":"Big Bob","text":"Just go!"},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_soldiersrun","volume":0.8}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"char_1002_nsabr_1"}},{"t":"line","name":"Reunion Member","text":"They ran away!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_010"}},{"t":"line","name":"Big Bob","text":"All right, who wants to play?"},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_atk/e_atk_saw_n_1"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":30,"fadeout":true,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Enemy/e_atk/e_atk_saw_n_2"}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":30,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_forest"}},{"t":"cmd","c":"blocker","a":{"a":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"char_220_grani#5"}},{"t":"line","name":"Grani","text":"...The sounds of fighting are quieting down."},{"t":"line","name":"Grani","text":"But we can't afford to rest yet, Carol. Sorry..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"I'm fine... But, Mister Bob... what about him...?!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#4","focus":2}},{"t":"line","name":"Grani","text":"He might need some time."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#4","focus":1}},{"t":"line","name":"Carol","text":"Need some time...? Are you saying..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003"}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":20,"fadeout":true,"block":true}},{"t":"line","name":"Carol","text":"Oww!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Carol! Are you okay?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"Sorry, I just tripped over this root..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Here, take my hand."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"...Thank you."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Can you walk?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"...I'm fine, it's just a bruise. As you said, it's best that we keep moving..."},{"t":"line","name":"Carol","text":"Once we cross this forest, we'll reach the foot of Mt. Mortica. We need to find the second cave halfway up the mountain."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"We can only get in through the cave entrance?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"Yeah. Once inside, we'll still have to follow some paths in the darkness, but I know the way. The treasure is hidden in the deepest part of the cave."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Mhm. Well, in that case..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_sp_ballista","volume":0.2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.2,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.25,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":10,"ystrength":12,"vibrato":30,"randomness":30,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"Woah?! Was that an explosion going off in the distance...? Th-that can't be good..."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Listen closely, there's the sound of screaming as well."},{"t":"line","name":"Grani","text":"Someone's fighting. It's not over yet."},{"t":"line","name":"Grani","text":"...Carol, are you scared?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":1}},{"t":"line","name":"Carol","text":"I'm..."},{"t":"line","name":"Carol","text":"...Yes, I am."},{"t":"line","name":"Carol","text":"But in order to protect my village and return peace to these lands... I have to do this."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#4","focus":2}},{"t":"line","name":"Grani","text":"I see..."},{"t":"line","name":"Grani","text":"You're really brave."},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#4","focus":1}},{"t":"line","name":"Carol","text":"Huh?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_003","name2":"char_220_grani#5","focus":2}},{"t":"line","name":"Grani","text":"Don't worry about it. Anyway, let's keep moving."},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"block":true}},{"t":"cmd","c":"image","a":{}}]}
