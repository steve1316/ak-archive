{"id":"main_14_level_main_14-16_end","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"image","a":{"image":"avg_5_7_shining","fadetime":0,"screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/AVG/m_avg_memory_loop","volume":0.6}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"A flash of cognition... in the gloom...","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"A consciousness... nearly eaten away by disordered emotion...","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Unable to perceive... Unable to be perceived...","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"50_g9_airshipdeck","screenadapt":"coverall","block":true}},{"t":"cmd","c":"camerashake","a":{"duration":-1,"xstrength":5,"ystrength":8,"vibrato":30,"randomness":90,"fadeout":false,"block":false}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_collapse","volume":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","loop":true,"channel":"sh","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":null,"text":"The outermost layer of the fortress in the skies above the Shard begins to break apart, its many fragments falling like a rain of iron spilling across the ground."},{"t":"line","name":null,"text":"The enormous skeleton halts in place, its nerve bundles still wrapped around the airship."},{"t":"line","name":null,"text":"The revenant's final consciousness is dissipating."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.1,"xstrength":20,"ystrength":20,"vibrato":30,"randomness":90,"fadeout":false,"block":false}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"50_g10_airshipwitchcraftcore","screenadapt":"coverall","block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"You promised me that future beyond question, Theresa.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"But your followers have become hindrances upon your path.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"My fellow souls are in disarray from centuries worth of scorching flame.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"This forge was meant to be my cage, my execution chamber wherein I could slit my own throat.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"I have not yet paid back the price for betraying my clan!","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"This is the last thing I can do, Theresa...","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/Battle/b_char/b_char_fireharm"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.1,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0.95,"g":0.95,"b":0.95,"fadetime":0.7,"block":false}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_fire_01","y":-50,"fade":true,"fadetime":1,"layer":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_churchfire","loop":true,"channel":"bse","volume":0}},{"t":"cmd","c":"soundvolume","a":{"volume":0.5,"fadetime":3,"channel":"bse"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"A violent ignition."},{"t":"line","name":null,"text":"The shadows dissipate from within the inferno, and the flames envelop the airship, tearing apart the nerve bundles."},{"t":"line","name":null,"text":"They charge towards you too."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"50_g9_airshipdeck","screenadapt":"coverall","block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"And as for you all—","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You use false words to place yourselves atop a pedestal of virtue.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Use lies of deliverance to cover the scars Sarkaz inflict on themselves only to survive.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"You dare not even confront her death—","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"bse","fadetime":1}},{"t":"cmd","c":"stopsound","a":{"channel":"sh","fadetime":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_white","screenadapt":"coverall","block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"???","text":"There was no need for you to come here."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["...","Theresa?"],"values":["1","2"]},{"t":"predicate","refs":["1","2"]},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"background","a":{"image":"49_g10_theresaoffice","screenadapt":"coverall","fadetime":2.5,"block":false}},{"t":"cmd","c":"delay","a":{"time":3.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1296_1#1$1","duration":0.7}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1296_1#1$1","focus":"m"}},{"t":"line","name":"Theresa","text":"Are you here to look for Amiya? Or perhaps..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1296_1#1$1","focus":"n"}},{"t":"decision","options":["Are you injured?","Is that child by your side... Amiya?"],"values":["1","2"]},{"t":"predicate","refs":["1","2"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1296_1#1$1","focus":"m"}},{"t":"line","name":"Theresa","text":"So that is your answer, Doctor..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"You try to step forward, but your body fails to move. You are separated from the scene by an untouchable barrier."},{"t":"line","name":null,"text":"You finally realize that this is not reality."},{"t":"line","name":null,"text":"This is what the revenant has compelled you to see."},{"t":"line","name":null,"text":"A scene of truth."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["Wait... They're..."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"You see many figures by your side advance."},{"t":"line","name":null,"text":"You recognize their weapons and armor. You have seen their shadows before, rather recently in fact..."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["Weren't they the apparitions aboard the airship?!"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"Have they come to protect Theresa?"},{"t":"line","name":null,"text":"No, that's not right..."},{"t":"line","name":null,"text":"You see them draw their swords against the wounded King of Sarkaz."},{"t":"cmd","c":"musicvolume","a":{"volume":0,"fadetime":2}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_broadswordblood","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":1,"g":0.2,"b":0.2,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":1,"g":0.2,"b":0.2,"fadetime":0.05,"block":true}},{"t":"cmd","c":"image","a":{"image":"49_i01","screenadapt":"coverall","fadetime":0}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","fadetime":0,"keep":true,"initamount":0,"amount":0.7,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":1,"g":0.2,"b":0.2,"fadetime":1,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","fadetime":2,"amount":0,"block":true}},{"t":"line","name":null,"text":"You see a scene that you could never have imagined."},{"t":"line","name":null,"text":"Theresa fallen in a pool of blood, protecting the sleeping Amiya in her embrace."},{"t":"line","name":null,"text":"Her murderers surround you."},{"t":"line","name":null,"text":"You and them, conspirators all."},{"t":"line","name":null,"text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"50_g9_airshipdeck","screenadapt":"coverall","block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.7,"block":true}},{"t":"cmd","c":"musicvolume","a":{"volume":0.6,"fadetime":1.5}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"decision","options":["What was that..."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"The fleeting scenes melt away, returning your consciousness to reality."},{"t":"line","name":null,"text":"You look at W, Kal'tsit and Amiya. You see the expressions on their faces. You realize that you were not the only one watching those visions unfurl."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1035_wisdel_1#6$2","focus":"m"}},{"t":"line","name":"W","text":"..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#2$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1340_1#1$1","duration":1}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"decision","options":["W...","Kal'tsit...","Amiya..."],"values":["1","2","3"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"The calmness of this dangerous mercenary's expression feels rather strange. You feel as though she should be flying into a rage."},{"t":"line","name":null,"text":"But she does not."},{"t":"line","name":null,"text":"She doesn't even glance at you. Gripping the cannon in her hands tightly instead, she is staring at the revenant's remnant shadows."},{"t":"predicate","refs":["2"]},{"t":"line","name":null,"text":"Kal'tsit looks back at you."},{"t":"line","name":null,"text":"Her emerald-green eyes remain calm and collected as ever, but you notice a tinge of sorrow that was not there before."},{"t":"predicate","refs":["3"]},{"t":"line","name":null,"text":"Amiya stares ahead blankly in a daze, her arm outstretched, as though trying to grasp something."},{"t":"line","name":null,"text":"But all her fingers find purchase on is nothingness."},{"t":"predicate","refs":["1","2","3"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#5$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"Remain calm, Dr. {@nickname}. I ask that you stand behind me and Mon3tr."},{"t":"line","name":"Kal'tsit","text":"As I have told you before, I knew what happened in the past, but I had my reasons to keep it from you."},{"t":"line","name":"Kal'tsit","text":"I approved of Theresa's choice back then, and telling you as you are now, the truth would not have been of any use."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"But..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1","focus":"n"}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"<i>But Theresa...</i>","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"<i>Was it also your choice to allow the revenant to show visions of the past to us, here and now?</i>","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#5$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"Doctor..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#1$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"It is true that during our time in Chernobog, and even after, I had my doubts about you."},{"t":"line","name":"Kal'tsit","text":"But the choices that you have made since are proof enough that you truly do walk the same road as us."},{"t":"line","name":"Kal'tsit","text":"Calm down. Do not waver."},{"t":"cmd","c":"stopmusic","a":{"fadetime":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Hypocrite.","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{"text":"Coward—","x":300,"y":370,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_grenade_explosion","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.7,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_avg_distressed_intro","key":"Sound_Beta_2/Music/act9d0d0/m_avg_distressed_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1035_wisdel_1#9$2","focus":"m"}},{"t":"line","name":"W","text":"...Shut up."},{"t":"line","name":"W","text":"How dare you use Theresa to try and sow discord between us."},{"t":"line","name":"W","text":"Just disappear already."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1340_1#1$1","focus":"m"}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_grenade_explosion","volume":0.7}},{"t":"cmd","c":"camerashake","a":{"duration":0.8,"xstrength":40,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_1035_wisdel_1#8$2","focus":"m"}},{"t":"line","name":"W","text":"...Enough."},{"t":"line","name":"W","text":"Kal'tsit, tell your monster to hang back a bit. Wasn't really prepared to do this right now."},{"t":"line","name":"W","text":"I know that old thing's not going to make up some fake movie when he's right about to die."},{"t":"line","name":"W","text":"I'm not an idiot. There couldn't have been anyone else who murdered Theresa."},{"t":"line","name":"W","text":"There must have been an explanation for what happened back then, but killing someone who doesn't remember anything..."},{"t":"line","name":"W","text":"That doesn't interest me at all."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Surprise. Doubt. Sorrow."},{"t":"line","name":null,"text":"The incomprehensible truth is like a sledgehammer striking at your heart."},{"t":"line","name":null,"text":"You feel difficult to even begin to recover from the shock. The calm tone of the two before you didn't help you forgive yourself."},{"t":"cmd","c":"dialog","a":{}},{"t":"decision","options":["Amiya..."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"You look at the silent girl, her face streaked with tears."},{"t":"line","name":null,"text":"You want to say something, but she is the one who speaks first."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Doctor... I knew."},{"t":"line","name":"Amiya","text":"Or rather... I suspected it a long time ago."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#4$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"Amiya?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I still remember... why Dr. Kal'tsit had to send the Doctor to Chernobog to heal after the accident."},{"t":"line","name":"Amiya","text":"And the reasons the elite operators gave when they opposed the decision to rescue the Doctor."},{"t":"line","name":"Amiya","text":"Even if everybody was quiet about it, I could still guess. There was only one possibility."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"n"}},{"t":"decision","options":["......"],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I have guessed, but I still don't understand..."},{"t":"line","name":"Amiya","text":"The Doctor I knew, the one who saved me, brought me so many different places, told me so many stories..."},{"t":"line","name":"Amiya","text":"The one who brought me back to Babel, the one who tried anything and everything to cure my Oripathy, the one who promised me that I had a future..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"That incredibly kind person, why did that Doctor... why did that one kill the equally kind Theresa, the person who loved everyone..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"n"}},{"t":"decision","options":["I don't remember.","I don't know."],"values":["1","2"]},{"t":"predicate","refs":["1","2"]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#18$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I still have so many questions I want to ask you, Doctor."},{"t":"line","name":"Amiya","text":"The you who rescued me, the you who murdered Theresa, the you who stands before me right now... In the end, which one is the true you, Dr. {@nickname}?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#11$1","focus":"m"}},{"t":"line","name":"Amiya","text":"I just didn't know how to ask you..."},{"t":"line","name":"Amiya","text":"Since you awoke from the sarcophagus, despite the loss of your memories, you always stood with us no matter the danger... How could I believe someone like this could be a murderer?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"decision","options":["I promise you."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"decision","options":["I will find an answer."],"values":["1"]},{"t":"predicate","refs":["1"]},{"t":"line","name":null,"text":"You reach a hand out to Amiya."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopmusic","a":{"fadetime":3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_erthshkng","loop":true,"channel":"bgs","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":-1,"xstrength":8,"ystrength":10,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playmusic","a":{"intro":"Sound_Beta_2/Music/act9d0d0/m_bat_katzdale_intro","key":"Sound_Beta_2/Music/act9d0d0/m_bat_katzdale_loop","volume":0.6}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_394_1#14$1","focus":"m"}},{"t":"line","name":"Amiya","text":"Doctor!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The deck of the airship suddenly begins to shake violently. Amiya immediately grabs your hand."},{"t":"line","name":null,"text":"The dark shadows that once gathered within the cabin have begun to bloom in the sky."},{"t":"line","name":null,"text":"Below the glow of the crimson horizon, a black blossom, dark enough to swallow all light, furled itself around the airship."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_003_kalts_1#6$1","focus":"m"}},{"t":"line","name":"Kal'tsit","text":"The airship is collapsing."},{"t":"line","name":"Kal'tsit","text":"We must withdraw immediately."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_crowdrun","volume":0.8}},{"t":"cmd","c":"charslot","a":{"duration":1}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":1,"bloc