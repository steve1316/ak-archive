{"name":"avg_1029_Yato2_1#11$1","fadetime":0.5}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Yato","text":"—!"},{"t":"line","name":"Yato","text":"What?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#9$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_pl_wp_swo_grip_alt_02","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_pl_wp_swo_mvmt_a_alt_01","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"line","name":"Noir Corne","text":"Yato, are you alright?"},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#11$1"}},{"t":"line","name":"Yato","text":"It's strange... These blades... They should be effective against the Rathalos, but I'm not getting anywhere with them."},{"t":"line","name":"Yato","text":"Why? Am I not using them correctly?"},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"line","name":"Yato","text":"Corne, cover me! I'll try again!"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"Got it! Ah, hold up! I don't have my shield! And what do I do with this blade—"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"character","a":{"fadetime":0.4}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"Wait—You! Argh, whatever! I'm coming!"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"line","name":"Noir Corne","text":"Scholar, do you have a plan yet?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_752_1#4$1"}},{"t":"cmd","c":"playsound","a":