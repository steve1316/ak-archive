},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_pl_hit_slash_kan_metal_small","volume":1}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","layer":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.8}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","layer":2}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_pl_hit_slash_kan_metal_small","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.3,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_angervoice_1"}},{"t":"cmd","c":"camerashake","a":{"duration":2,"xstrength":50,"ystrength":50,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_jump_1"}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_flapwing_2"}},{"t":"cmd","c":"charslot","a":{"action":"zoom","poszoom":"0.5,0.5","scale":1.05,"slot":"m","name":"avg_npc_9998_1#1$1","focus":"m","afrom":1,"ato":0,"duration":0.5,"isblock":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1","focus":"m","posfrom":"0,0","posto":"-50,200","duration":0.8,"isblock":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1","focus":"m","afrom":1,"ato":0,"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"line","name":"Yato","text":"Corne, the Rathalos is coming your way! Watch out!"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"I'll just raise my—Where's my shield?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"line","name":"???","text":"Dodge left, your meowjesty!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"characteraction","a":{"name":"middle","type":"move","xpos":-400,"ypos":0,"fadetime":0.5,"isblock":false}},{"t":"cmd","c":"character","a":{"fadetime":0.3}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_fireball","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_e_imp_MHfireball"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_npc_750_1#1$1"}},{"t":"line","name":"???","text":"Long Swords require excellent control. You need to channel your inner energy to use them effectively. Victory is determined at the moment you unleash your attack."},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"That voice... It's the same one I heard earlier... Argh!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_750_1#1$1"}},{"t":"line","name":"???","text":"......"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"Er, what is this?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_752_1#6$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_otomo000_vo_type01_pitch0_damage_max_alt01"}},{"t":"line","name":"Felyne Scholar","text":"Stupid Noir Corne! That's a Felyne too. A Palico!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_750_1#1$1"}},{"t":"line","name":"Palico","text":"Horned foreign Hunter. I'm a Palico with years of experience... Mrow."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_fireballvoice_1","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":1,"xstrength":50,"ystrength":50,"vibrato":30,"randomness":90,"fadeout":true,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"line","name":"Noir Corne","text":"Yato, it's going to breathe fire again!"},{"t":"line","name":"Noir Corne","text":"But look at that head, Scholar! Is that really a Felyne?"},{"t":"cmd","c":"character","a":{"name":"avg_npc_750_1#1$1"}},{"t":"line","name":"Palico","text":"This armor was gifted to me by a Hunter whom I followed faithfully for years. It is the very embodiment of our countless hunts together, a symbol of bravery and experience... Mrow."},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#5$1"}},{"t":"line","name":"Noir Corne","text":"Yeah, I'm not getting any of that from it! And Scholar, why is there a Felyne fighting? I know you've been running away every time there's a fight!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_752_1#6$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_otomo000_vo_type01_pitch0_attack_alt01"}},{"t":"line","name":"Felyne Scholar","text":"You fool, that's a Palico! They're in charge of all the hunting!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_750_1#1$1"}},{"t":"line","name":"Palico","text":"Palicoes accompany Hunters on their hunts as partners. It is an age-old tradition. And not one limited to just Felynes. Supposedly, certain eastern villages train their Canynes to join in on their—"},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"line","name":"Yato","text":"What are all of you doing?! Corne! Get it together!"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#7$1"}},{"t":"line","name":"Noir Corne","text":"I got it! Okay, lemme think. Control... Control..."},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"line","name":"Noir Corne","text":"Haaahhh! I got this! Take that!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_pl_wp_swo_skill_whoosh_1","volume":1}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1"}},{"t":"cmd","c":"effect","a":{"name":"AVG_036_daoguang_01","x":114.7,"y":49,"rox":59.4,"roy":-54.1,"roz":-105.5,"layer":1}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","x":231.9,"y":42.7,"rox":200,"roy":300,"roz":0,"layer":1}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","x":-21.2,"y":39.1,"rox":180,"roy":300,"roz":0,"layer":1}},{"t":"cmd","c":"effect","a":{"name":"AVG_daoguang_spark_01_large","x":44,"y":14.3,"rox":220,"roy":300,"roz":0,"layer":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.03,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_p_imp_MHkatana_2","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_angervoice_1"}},{"t":"cmd","c":"camerashake","a":{"duration":1,"ystrength":40,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"line","name":"Noir Corne","text":"It really worked!"},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"line","name":"Yato","text":"Now's our chance!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"name":"char_empty","name2":"avg_1029_Yato2_1#6$1"}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-400,"power":0,"times":1,"fadetime":0,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":400,"power":0,"times":1,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"name":"avg_npc_755_1#6$1","name2":"avg_1029_Yato2_1#6$1","fadetime":0.51}},{"t":"cmd","c":"delay","a":{"time":0.6}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"jump","xpos":100,"power":0,"times":1,"fadetime":0.1,"block":true}},{"t":"cmd","c":"camerashake","a":{"duration":0.5,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.05,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_fightgeneral","volume":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.05,"block":true}},{"t":"cmd","c":"characteraction","a":{"name":"left","type":"move","xpos":-80,"power":5,"times":1,"fadetime":1,"block":true}},{"t":"cmd","c":"characteraction","a":{"name":"right","type":"move","xpos":300,"power":0,"times":1,"fadetime":1,"block":true}},{"t":"cmd","c":"character","a":{"fadetime":0.8}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown2"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"character","a":{"name":"avg_1029_Yato2_1#6$1"}},{"t":"line","name":"Yato","text":"Kashiwau! What are you doing? Why did you push me away?"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{}},{"t":"cmd","c":"character","a":{"name":"avg_npc_755_1#6$1"}},{"t":"line","name":"Yoshitaka Kashiwau","text":"This beast is mine to slay!"},{"t":"line","name":"Yoshitaka Kashiwau","text":"Out of my way! All of you!"},{"t":"cmd","c":"character","a":{"name":"avg_1030_noirc2_1#4$1"}},{"t":"line","name":"Noir Corne","text":"Yato, it's coming again!"},{"t":"cmd","c":"character","a":{"name":"avg_npc_755_1#3$1"}},{"t":"line","name":"Yoshitaka Kashiwau","text":"Monster! Look over here!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"character","a":{"fadetime":0}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_angervoice_1"}},{"t":"cmd","c":"delay","a":{"time":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/CustomSE/act24side#retro/act24side_mhrors_walk_1"}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1","posfrom":"0,0","posto":"140,0","duration":1,"isblock":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_9998_1#1$1","focus":"m","afrom":1