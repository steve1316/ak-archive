{"id":"main_16_level_main_16-09_end","steps":[{"t":"cmd","c":"header","a":{"key":"title_test","is_skippable":true,"fit_mode":"BLACK_MASK"}},{"t":"cmd","c":"stopmusic","a":{}},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowstormflp","volume":0,"loop":true,"channel":"sn"}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"sn","fadetime":2}},{"t":"cmd","c":"background","a":{"image":"66_g14_ursusvillage","screenadapt":"coverall"}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"The nights of deep autumn are cold in Ursus. Snow falls from the branches as the cold winds blow."},{"t":"line","name":null,"text":"The crowd has already dispersed. There is no light coming from the distant huts."},{"t":"line","name":null,"text":"A tiny flicker of flame still burns on the charred firewood in the middle of the clearing, clinging to its last gasp of life as the north winds tear at it."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"sn","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firewood_throw","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_warmbonfire_loop","loop":true,"channel":"a","volume":0}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"fadetime":2,"channel":"a"}},{"t":"cmd","c":"delay","a":{"time":1.5}},{"t":"line","name":null,"text":"A piece of thick firewood is thrown into the pile, and sparks fly in the air."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#1$1","duration":1,"isblock":true}},{"t":"line","name":"Hawley","text":"They..."},{"t":"line","name":"Hawley","text":"They found us."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Dry firewood lies in ash, slowly becoming charred and twisted, before being swallowed by the leaping flames."},{"t":"line","name":null,"text":"The fire shines upon the face of the feeble Infected, but he feels no warmth."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#1$1"}},{"t":"line","name":"Hawley","text":"The people here... everyone."},{"t":"line","name":"Hawley","text":"They must be wiped away... like Ganea was..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#7$1"}},{"t":"line","name":"Hawley","text":"This way, they will never..."},{"t":"line","name":"Hawley","text":"They will never lose their goodness, nor abandon purity..."},{"t":"line","name":"Hawley","text":"Their souls shall never be defiled."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"He is in pain, a pain that penetrates his heart like a needle."},{"t":"line","name":null,"text":"He is cold, shivering like he just fell into a frozen lake."},{"t":"line","name":null,"text":"He must make himself warm again."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firewood_throw","volume":0.2}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firewood_throw","volume":0.5}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firewood_throw","volume":1}},{"t":"cmd","c":"delay","a":{"time":0.7}},{"t":"line","name":null,"text":"One piece, two pieces, three pieces."},{"t":"line","name":null,"text":"One bundle, two bundles, three bundles."},{"t":"line","name":null,"text":"The flame that was so faint now pokes its head from the gaps in the wood like a burning demon, threatening to touch its creator with its tongue."},{"t":"line","name":null,"text":"The frail miner picks up a burning firewood and walks toward the silent houses."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowbootwalk","volume":1}},{"t":"cmd","c":"soundvolume","a":{"volume":0.2,"channel":"sn","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{"image":"bg_newiceforest_3","screenadapt":"coverall"}},{"t":"cmd","c":"soundvolume","a":{"volume":1,"channel":"sn","fadetime":2}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"line","name":null,"text":"Tap, click, tap, click."},{"t":"line","name":null,"text":"The footsteps are rhythmic, one stronger than the other."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_snowbootwalk","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#4$1","duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Hawley","text":"Asleep... asleep!"},{"t":"line","name":"Hawley","text":"They're all asleep."},{"t":"line","name":"Hawley","text":"You do not know what desperation awaits you, what judgment you will face."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#5$1"}},{"t":"line","name":"Hawley","text":"Aiding and abetting the Infected before selling them out. Blissful ignorance, docile as a burdenbeast!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#1$1"}},{"t":"line","name":"Hawley","text":"But it is alright."},{"t":"line","name":"Hawley","text":"I will help you. I can help you."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#2$1"}},{"t":"line","name":"Hawley","text":"For I shall meditate..."},{"t":"line","name":"Hawley","text":"And share..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#6$1"}},{"t":"line","name":"Hawley","text":"In your pain."},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The madman carries the torch of fear, but the flame can no longer stem the cold."},{"t":"line","name":null,"text":"The cold pierces his bones. It comes from Oripathy, from the wind, from Ursus."},{"t":"line","name":null,"text":"He needs warmth."},{"t":"line","name":null,"text":"He sees a large pile of hay."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#1$1"}},{"t":"line","name":"Hawley","text":"Fire."},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":null,"text":"He throws the torch."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#4$1"}},{"t":"line","name":"Hawley","text":"Cleansing—"},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":null,"text":"The flames awaken all that has withered."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#5$1"}},{"t":"line","name":"Hawley","text":"Salvation!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"sn","fadetime":2}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firestorm","volume":1}},{"t":"cmd","c":"playmusic","a":{"key":"Sound_Beta_2/Music/act37d0d0/m_bat_act37d0d0_01_loop","volume":0.6}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_062_smoke_01","fade":true,"fadetime":1.5,"layer":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_churchfire","loop":true,"channel":"a","volume":0}},{"t":"cmd","c":"soundvolume","a":{"volume":0.7,"fadetime":2,"channel":"a"}},{"t":"cmd","c":"charslot","a":{"duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":null,"text":"He has never felt so acutely alive."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"background","a":{"image":"34_g10_tent_inside","screenadapt":"coverall"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_clothmovement","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#1$1","posfrom":"0,-50","posto":"0,0","duration":0.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","focus":"n"}},{"t":"line","name":null,"text":"The ringing continues in his head. In the nightmare, Rankin is clinging to the last vestige of cognition and sanity."},{"t":"line","name":null,"text":"His sensations are returning, but the wailing grown nearer, not more distant."},{"t":"line","name":null,"text":"He forces himself up and staggers towards the door of the tent, seeking a breath of fresh air."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"charslot","a":{"duration":1.5,"isblock":true}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_048_smoke_01","layer":1}},{"t":"cmd","c":"background","a":{"image":"bg_snowconutry_3","screenadapt":"coverall"}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_churchfire","loop":true,"channel":"a","volume":0}},{"t":"cmd","c":"soundvolume","a":{"volume":0.4,"fadetime":2,"channel":"a"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Hot air rushes at him, evaporating the sweat in an instant."},{"t":"line","name":null,"text":"In the blink of an eye, all the feelings return to his body."},{"t":"line","name":null,"text":"This is not a dream. It is real. The stuff of his nightmares has found a foothold in reality."},{"t":"line","name":null,"text":"Everywhere, people are fleeing, as the houses that once offered refuge are devoured by fire."},{"t":"line","name":null,"text":"In the gushing smoke, the scent of charred despair clutches at everyone's throats like a demonic claw. How tiny is man in the presence of terror."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1967_1#5$1","duration":1,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Nikto","text":"Rankin!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#6$1"}},{"t":"line","name":"Rankin","text":"What... what happened?"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1967_1#5$1"}},{"t":"line","name":"Nikto","text":"No idea. The fire started all of a sudden. We can't put it out!"},{"t":"line","name":"Nikto","text":"All we can do is evacuate the others!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_walkfast","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1969_1#1$1","posfrom":"-200,0","posto":"0,0","duration":0.6}},{"t":"cmd","c":"delay","a":{"time":0.2}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1963_1#1$1","posfrom":"200,0","posto":"0,0","duration":0.8}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{"slot":"l","name":"avg_npc_1969_1#1$1","focus":"l"}},{"t":"line","name":"Excited Miner","text":"The food we traded for is still inside. I have to go in—"},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_npc_1963_1#7$1","focus":"r"}},{"t":"line","name":"Rankin","text":"Now is not the time!"},{"t":"line","name":"Rankin","text":"Wake everyone! Get them out of the village! Go!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"But his commands do not bring order to the crowd. Fear continues to spread unchecked."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":0,"channel":"a","fadetime":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/General/g_ui/g_ui_stagepush","volume":0.8}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"image","a":{"image":"avg_8_30","screenadapt":"coverall","xscale":1.05,"yscale":1.05,"fadetime":0}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.05,"yscalefrom":1.05,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","amount":1,"keep":true}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"He has never..."},{"t":"line","name":null,"text":"Died."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/General/g_ui/g_ui_stagepush","volume":0.8}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_048_smoke_01","layer":1}},{"t":"cmd","c":"background","a":{"image":"bg_snowconutry_3","screenadapt":"coverall"}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","amount":0,"keep":true}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#7$1"}},{"t":"cmd","c":"soundvolume","a":{"volume":0.4,"channel":"a","fadetime":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":"Rankin","text":"No, no... I won! I killed him!"},{"t":"line","name":"Rankin","text":"I can save everyone...!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1,"loop":true,"channel":"r"}},{"t":"cmd","c":"stopsound","a":{"channel":"r","fadetime":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#6$1","posfrom":"-200,0","posto":"0,0","duration":0.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"line","name":"Vetochki","text":"Uchitel!","spans":[{"text":"Uchitel!","i":true}]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#6$1"}},{"t":"line","name":"Rankin","text":"What are you doing here, Vetochki? Get to safety!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#10$1"}},{"t":"line","name":"Vetochki","text":"Uchitel, I-I...!","spans":[{"text":"Uchitel","i":true},{"text":", I-I...!"}]},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#7$1"}},{"t":"line","name":"Rankin","text":"Didn't you hear me?!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Rankin tries to shake off Vetochki's hands, but the girl grabs his arm with all her strength."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#10$1"}},{"t":"line","name":"Vetochki","text":"B-Babushka, sh-she's gone!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#6$1"}},{"t":"line","name":"Rankin","text":"What? Wasn't she with you?"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The stammering girl gestures furiously, trying to explain what happened, but the terror on her face says it all."},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#5$1"}},{"t":"line","name":"Rankin","text":"Nikto!"},{"t":"line","name":"Rankin","text":"Continue the evacuation! We'll go find Nadia!"},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1967_1#1$1"}},{"t":"line","name":"Nikto","text":"O-Okay!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"style":"slider","inverse":true,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"style":"slider","inverse":true,"fadetime":2,"block":true}},{"t":"line","name":null,"text":"Rankin and Vetochki dart through the fire. The houses on both sides of them are burning, and the slightest misstep could set their clothes on fire."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#10$1"}},{"t":"line","name":"Vetochki","text":"Babushka... Babushka!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"Rankin wants to yell too, but the feeling of helplessness continues to accumulate in his heart. It is stuck in his throat, preventing him from making a sound, preventing him from breathing."},{"t":"line","name":null,"text":"He knows full well what a fire like this means for an invalid old woman."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#10$1"}},{"t":"line","name":"Vetochki","text":"Uchitel, I... you... mm!","spans":[{"text":"Uchitel","i":true},{"text":", I... you... mm!"}]},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"At the smoke-filled intersection, Vetochki covers her mouth and points to herself, then at Rankin, and finally towards the fork in the path."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#10$1"}},{"t":"line","name":"Rankin","text":"No, Vetochki... you must not go off on your own... listen to me..."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#10$1"}},{"t":"line","name":"Vetochki","text":"Uchitel!","spans":[{"text":"Uchitel!","i":true}]},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The girl's face is red as tears flow from her eyes. She holds her hands together in a strange gesture of prayer."},{"t":"line","name":null,"text":"She is not praying to the Tsar, nor to the Yurodstvo. She is praying to Rankin."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#3$1"}},{"t":"line","name":"Rankin","text":"I..."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"soundvolume","a":{"volume":0,"channel":"a","fadetime":0.5}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/General/g_ui/g_ui_stagepush","volume":0.8}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{"image":"avg_8_29","screenadapt":"coverall","xscale":1.05,"yscale":1.05,"fadetime":0}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.05,"yscalefrom":1.05,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","amount":1,"keep":true}},{"t":"cmd","c":"delay","a":{"time":0.1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":0.6,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"subtitle","a":{"text":"Fool.","x":300,"y":350,"alignment":"center","size":24,"delay":0.04,"width":700}},{"t":"cmd","c":"subtitle","a":{}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":1,"block":true}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/General/g_ui/g_ui_stagepush","volume":0.8}},{"t":"cmd","c":"blocker","a":{"a":0,"r":255,"g":255,"b":255,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":255,"g":255,"b":255,"fadetime":0.5,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"image","a":{}},{"t":"cmd","c":"bgeffect","a":{"name":"AVG_048_smoke_01","layer":1}},{"t":"cmd","c":"background","a":{"image":"bg_snowconutry_3","screenadapt":"coverall"}},{"t":"cmd","c":"cameraeffect","a":{"effect":"Grayscale","amount":0,"keep":true}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_4207_branch_1#5$1","posfrom":"-200,0","posto":"-200,0","duration":0}},{"t":"cmd","c":"soundvolume","a":{"volume":0.4,"channel":"a","fadetime":0.5}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0.5,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#7$1","focus":"m","posfrom":"-500,0","posto":"-200,0","duration":1}},{"t":"cmd","c":"delay","a":{"time":0.8}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_bodyfalldown3","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1971_1#7$1","focus":"m","posfrom":"-200,0","posto":"-230,0","afrom":1,"ato":1,"duration":0.4}},{"t":"cmd","c":"charslot","a":{"slot":"r","name":"avg_4207_branch_1#10$1","posfrom":"-200,0","posto":"-150,0","afrom":1,"ato":1,"duration":0.4}},{"t":"cmd","c":"delay","a":{"time":0.4}},{"t":"cmd","c":"charslot","a":{"slot":"r","focus":"r"}},{"t":"line","name":"Vetochki","text":"Ugh...!"},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_walk_n","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"-230,0","posto":"100,0","focus":"m","bstart":0.2,"bend":0.7,"afrom":1,"ato":0,"duration":1.5,"isblock":true}},{"t":"cmd","c":"delay","a":{"time":0.5}},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"A shadow flashes across their vision. He is limping, but there is an unusual strength in his steps, as though he is being drawn in by something."},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#6$1"}},{"t":"line","name":"Rankin","text":"Hawley? Where are you going?!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":null,"text":"The hunched figure ignores Rankin's cries, walking towards the sea of flames at the end of the path."},{"t":"line","name":null,"text":"Surrounded by the bright light of fire, his figure casts no shadow. He prepares to welcome baptism by fire, like the Yurodstvo walking towards the execution grounds in legend."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_gen_rungeneral","volume":1}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_4207_branch_1#1$1","posfrom":"-300,0","posto":"0,0","duration":0.5}},{"t":"cmd","c":"delay","a":{"time":0.3}},{"t":"cmd","c":"charslot","a":{"slot":"m","posfrom":"0,0","posto":"300,0","afrom":1,"ato":0,"duration":0.5}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"camerashake","a":{"duration":0.3,"xstrength":30,"ystrength":30,"vibrato":30,"randomness":90,"fadeout":true,"block":false}},{"t":"cmd","c":"charslot","a":{"slot":"m","name":"avg_npc_1963_1#7$1"}},{"t":"line","name":"Rankin","text":"Vetochki! Wait!"},{"t":"cmd","c":"charslot","a":{}},{"t":"line","name":"Hawley","text":"I have committed murder."},{"t":"line","name":"Hawley","text":"Not for food, nor for water, nor for abode."},{"t":"line","name":null,"text":"He continues to walk as he chants, and pushes open a burning door."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"bgeffect","a":{}},{"t":"cmd","c":"image","a":{"image":"66_i23","screenadapt":"coverall","xscale":1.05,"yscale":1.05,"fadetime":0}},{"t":"cmd","c":"imagetween","a":{"xscalefrom":1.05,"yscalefrom":1.05,"xscaleto":1,"yscaleto":1,"duration":20,"block":false}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_firestorm","volume":1}},{"t":"cmd","c":"playsound","a":{"key":"Sound_Beta_2/AVG/d_avg_churchfire","loop":true,"channel":"a","volume":0}},{"t":"cmd","c":"soundvolume","a":{"volume":0.7,"fadetime":2,"channel":"a"}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"delay","a":{"time":1}},{"t":"line","name":null,"text":"Even the scorching light of the flames cannot stop Rankin from seeing what is inside the house, over Hawley's head—"},{"t":"line","name":null,"text":"Flames roil and writhe as charred beams totter, cracking like the moaning of the dying."},{"t":"line","name":null,"text":"An old woman sits straight in the middle of it all."},{"t":"line","name":"Old Woman","text":"......"},{"t":"line","name":null,"text":"She is sitting on the last chair without a sound. The flames are only inches from her, but they cannot touch her, as though an invisible wall is keeping them at bay."},{"t":"line","name":null,"text":"She has not a speck of ash or dust on her. Even her hair is immaculately clean. Her eyes gently shut, but at the same time she seems to be watching everything."},{"t":"line","name":"Hawley","text":"I have cleansed their souls."},{"t":"cmd","c":"dialog","a":{}},{"t":"cmd","c":"stopsound","a":{"channel":"a","fadetime":2}},{"t":"cmd","c":"blocker","a":{"a":0,"r":0,"g":0,"b":0,"fadetime":0,"block":true}},{"t":"cmd","c":"blocker","a":{"a":1,"r":0,"g":0,"b":0,"fadetime":2,"block":true}},{"t":"cmd","c":"stopmusic","a":{"fadetime":2}},{"t":"cmd","c":"charslot","a":{}},{"t":"cmd","c":"background","a":{}},{"t":"cmd","c":"image","a":{}}]}
