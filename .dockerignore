# `COPY . .` in the Dockerfile would otherwise pull in the host's node_modules and the whole git history, which is slow and can leave a
# platform-specific install inside the image.

node_modules
build
.git
.github

# The asset pipeline's staging trees and caches, which run to tens of GB, plus local scratch and run logs.
tools/assets/.staging*
tools/data/.cache
**/__pycache__
**/.pytest_cache
.superpowers
.playwright-mcp
.claude
.vscode
docs
*.log

# Vite loads `.env.local` and `.env.production.local` in a production build, so a developer's local overrides would reach the image
# and make it differ from the Pages build.
.env*.local
