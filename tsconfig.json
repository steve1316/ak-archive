{
	"extends": "archive-kit/tsconfig.base.json",
	"compilerOptions": {
		// The kit's base sets `["vite/client"]`. `vite.config.ts` is typechecked here too and reads `process.env`, so node's types are added
		// rather than excluding the config from the program the way gfl-archive does.
		"types": ["vite/client", "node"]
	},
	"include": ["src", "vite.config.ts"]
}
